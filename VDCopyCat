function NX.adaptiveStep()
    if not state.adaptive then tier = 0; return end
    -- Ambang turun 60% dari cap supaya cap rendah tidak memicu adaptive terus.
    local low  = math.min(CFG.fpsLowThreshold, fpsCapValue * 0.75)
    local good = math.min(CFG.fpsLowThreshold + 12, fpsCapValue * 0.9)
    if currentFPS < low then
        okStreak = 0
        if tier < 2 then
            tier += 1
            log("adaptive T" .. tier .. ": dist " .. math.floor(userDist * TIER_DIST[tier + 1]))
            setStatus("â— ADAPTIVE T" .. tier, AMBER)
        end
    elseif currentFPS >= good and tier > 0 then
        okStreak += 1
        if okStreak >= 2 then
            okStreak = 0
            tier -= 1
            log("adaptive T" .. tier .. ": pulih")
            setStatus(tier > 0 and "â— ADAPTIVE T" .. tier or "â— ACTIVE", tier > 0 and AMBER or GREEN)
        end
    else
        okStreak = 0
    end
end

