-- animasi serang baru nyampe ke client setelah ~ping/2, dan damage-nya nyusul cuma ~93 ms kemudian.
-- kalau ping > waktu animasi->kena, parry reaksi MUSTAHIL ngejar (nyampe server pas udah kena) -> itu yang
-- dulu dilog "ga kekejar". Solusi: parry dikirim DULUAN waktu killer udah nempel, ngadep, dan ngedeketin,
-- jadi jendela parry udah kebuka pas serangan mendarat. Cuma aktif kalau baru-baru ini ada "ga kekejar".
function Parry.approach(k,lead)
local me=myRoot()
if not(me and k.root and k.root.Parent)then return nil end
local tr=Track[k.char]
local vel=Vector3.new(0,0,0)
if tr and os.clock()-tr.t<0.25 then vel=tr.vel
else pcall(function()vel=k.root.AssemblyLinearVelocity end)end
vel=Vector3.new(vel.X,0,vel.Z)
if vel.Magnitude>70 then vel=vel.Unit*70 end
local pos=k.root.Position+vel*(lead or 0)
local to=Vector3.new(me.Position.X-pos.X,0,me.Position.Z-pos.Z)
local dist=to.Magnitude
if dist<0.01 then return 0,1,99 end
local dir=to/dist
local mv=Vector3.new(0,0,0)
pcall(function()mv=me.AssemblyLinearVelocity end)
mv=Vector3.new(mv.X,0,mv.Z)
local facing=k.root.CFrame.LookVector:Dot(dir)
local closing=(vel-mv):Dot(dir)
return dist,facing,closing
end
