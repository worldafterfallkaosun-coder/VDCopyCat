            cdText.Parent = cdBack
            hud.cdBack, hud.cdFill, hud.cdText = cdBack, cdFill, cdText

            local warn = Instance.new("TextLabel")
            warn.AnchorPoint, warn.Position = Vector2.new(0.5, 0.5), UDim2.new(0.5, 0, 0.2, 0)
            warn.Size, warn.BackgroundTransparency = UDim2.fromOffset(280, 30), 1
            warn.Font, warn.TextSize, warn.TextColor3 = Enum.Font.GothamBold, 20, Color3.fromRGB(255, 70, 70)
            warn.TextStrokeTransparency, warn.Text, warn.Visible = 0.2, "", false
            warn.Parent = gui
            hud.warn = warn

            local btn = Instance.new("TextButton")
            btn.AnchorPoint, btn.Position = Vector2.new(0.5, 0.5), UDim2.new(1, -80, 0.45, 0)
            btn.Size, btn.BackgroundColor3, btn.BackgroundTransparency = UDim2.fromOffset(58, 58), Color3.fromRGB(90, 40, 40), 0.15
            btn.Font, btn.TextSize, btn.TextColor3, btn.Text = Enum.Font.GothamBold, 12, Color3.new(1, 1, 1), "LOCK"
            btn.AutoButtonColor, btn.Visible = false, false
            btn.Parent = gui
            round(btn)
            btn.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    if C.mode == "toggle" then V.toggled = not V.toggled else V.heldBtn = true end
                end
            end)
            btn.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
