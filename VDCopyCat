------------------------------------------------------------------ 4) SEMBUNYIIN UI SKILL CHECK
-- pas Auto Skill Check ON: jarum, zona, tombol Space, dll di SkillCheckPromptGui dibikin transparan tiap frame.
-- Visible / Enabled / rotasi sengaja ga disentuh, jadi game dan tracker skill check tetep jalan normal.
local hideOrig = setmetatable({}, { __mode = "k" })   -- [objek] = { prop = nilai asli }
local hideWasOn, hideErrAt = false, 0

local function forceT(d, prop)
    local cur = d[prop]
    if cur ~= 1 then
        local o = hideOrig[d]
        if not o then
            o = {}
            hideOrig[d] = o
        end
        if o[prop] == nil then o[prop] = cur end
        d[prop] = 1
    end
end

local function hideObj(d)
    if d:IsA("GuiObject") then
        forceT(d, "BackgroundTransparency")
        if d:IsA("ImageLabel") or d:IsA("ImageButton") then forceT(d, "ImageTransparency") end
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            forceT(d, "TextTransparency")
            forceT(d, "TextStrokeTransparency")
        end
    elseif d:IsA("UIStroke") then
        forceT(d, "Transparency")
    end
end

local function restoreHidden()
    for d, o in pairs(hideOrig) do
        if d.Parent then
            for prop, v in pairs(o) do pcall(function() d[prop] = v end) end
        end
        hideOrig[d] = nil
    end
end

local function hideStep()
    if not alive() then
        pcall(function() RunService:UnbindFromRenderStep("DP3_HideSkillUI") end)
        return
    end
    if not (CFG.skill.enabled and CFG.skill.hideUI) then
        if hideWasOn then
            hideWasOn = false
            restoreHidden()
        end
        return
    end
    hideWasOn = true
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    for _, n in ipairs({ "SkillCheckPromptGui", "SkillCheckPromptGui-con" }) do
        local g = pg:FindFirstChild(n)
        if g then
            for _, d in ipairs(g:GetDescendants()) do hideObj(d) end
        end
    end
end

pcall(function() RunService:UnbindFromRenderStep("DP3_HideSkillUI") end)
RunService:BindToRenderStep("DP3_HideSkillUI", Enum.RenderPriority.Last.Value, function()
    local ok, err = pcall(hideStep)
    if not ok and os.clock() - hideErrAt > 5 then
        hideErrAt = os.clock()
        log("HIDE", "error: " .. tostring(err))
    end
end)

