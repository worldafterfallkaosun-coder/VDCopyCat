-- v10: kecepatan jarum dari kode game (tweenLineRotation, Line.Rotation 0 -> 360 linear):
--   Generator (Skillcheck-gen)   : durasi max(1.3 x skillcheckspeed, 0.4) detik, skillcheckspeed = atribut karakter (default 1)
--   Healing   (Skillcheck-player): durasi 1.55 detik (x1.4 kalau perk ambitiousmedic; sample asli menggantikan seed setelah 3 frame)
-- Jenisnya dibaca dari teks event ("Generator event args..." / "Healing event args..."). Selain itu nil (cuma pakai pengukuran).
function Skill.seedOmega(info)
    if type(info) ~= "string" then return nil end
    if info:find("^Generator") then
        local c = LP.Character
        local spd = c and tonumber(c:GetAttribute("skillcheckspeed")) or 1
        return 360 / math.max(1.3 * spd, 0.4)
    elseif info:find("^Healing") then
        return 360 / 1.55
    end
    return nil
end

local function refreshOwners()
    Skill.owners = {}
    if not getconnections then return end
    for _, ev in pairs(Skill.events) do
        local ok, conns = pcall(getconnections, ev.OnClientEvent)
        if ok and conns then
            for _, c in ipairs(conns) do
                local okf, f = pcall(function() return c.Function end)
                if okf and type(f) == "function" and not isOurs(f) then
                    local nm = ownerOf(f)
                    if nm and nm ~= "" then Skill.owners[nm] = true end
                end
            end
        end
    end
end

