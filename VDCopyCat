local Conns = ENV.DP3_CONNS
if type(Conns) == "table" then
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
end
Conns = {}
ENV.DP3_CONNS = Conns
local function keep(c)
    Conns[#Conns + 1] = c
    if #Conns > 400 then   -- koneksi animasi numpuk antar ronde: buang yang udah putus
        local alive2 = {}
        for _, x in ipairs(Conns) do
            local okc, on = pcall(function() return x.Connected end)
            if okc and on then alive2[#alive2 + 1] = x end
        end
        for i = #Conns, 1, -1 do Conns[i] = nil end
        for i, x in ipairs(alive2) do Conns[i] = x end
    end
    return c
end

------------------------------------------------------------------ NET CLOCK (ping + fps)
-- dipakai parry (hitung delay) dan skill check (hitung lead). EMA biar satu lag spike ga ngerusak hitungan.
local Net = { frameDt = 1 / 60, rtt = 0.10, jitter = 0.01 }
do
    local hbConn
    hbConn = keep(RunService.Heartbeat:Connect(function(dt)
        if not alive() then
            hbConn:Disconnect()
            return
        end
        Net.frameDt = Net.frameDt * 0.9 + math.clamp(dt, 0.004, 0.2) * 0.1
    end))
end
task.spawn(function()
    while alive() do
        local ok, ms = pcall(function()
            return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok and type(ms) == "number" and ms > 0 then
            local s = ms / 1000
            Net.jitter = Net.jitter * 0.8 + math.abs(s - Net.rtt) * 0.2
            Net.rtt = Net.rtt * 0.8 + s * 0.2
        end
        task.wait(0.25)
    end
end)

