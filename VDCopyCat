------------------------------------------------------------------ NET CLOCK (ping + fps)
-- dipakai parry (hitung delay) dan skill check (hitung lead). EMA biar satu lag spike ga ngerusak hitungan.
local Net = { frameDt = 1 / 60, rtt = 0.10, jitter = 0.01 }
do
    local hbConn
    hbConn = RunService.Heartbeat:Connect(function(dt)
        if not alive() then
            hbConn:Disconnect()
            return
        end
        Net.frameDt = Net.frameDt * 0.9 + math.clamp(dt, 0.004, 0.2) * 0.1
    end)
end
task.spawn(function()
    while alive() do
        local ok, ms = pcall(function()
            return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok and type(ms) == "number" and ms > 0 then
            local s = ms / 1000
            Net.jitter = Net.jitter * 0.8 + math.abs(s - Net.rtt) * 0.2
            Net.rtt = Net.rtt * 0.8 + s * 0.2
        end
        task.wait(0.25)
    end
end)

------------------------------------------------------------------ LOG
local LOG, logLabel, logDirty, inHook = {}, nil, false, false
-- PENTING: log() dipanggil juga dari dalam hook FireServer, yang jalan di thread GAME. Thread itu ga boleh nyentuh
-- GUI executor (label di CoreGui/gethui) -> thread game mati dan tembakan/skill result ga pernah nyampe server.
-- Jadi log() cuma nyimpen teks; label di-update dari loop executor (lihat buildUI).
local function log(tag, msg)
    local line = string.format("[%.1f] %s %s", os.clock() % 1000, tag, tostring(msg))
    LOG[#LOG + 1] = line
    if #LOG > 120 then table.remove(LOG, 1) end
    logDirty = true
    if not inHook then print("[DP3] " .. line) end
end

