function K.capAvail(m)
    if m == "setfpscap" then return CAP.setfpscap end
    if m == "fflag" then return CAP.fflag end
    return true
end
function K.capMethod(m, v)
    if m == "setfpscap" then
        return (CAP.setfpscap and pcall(setfpscap, v)) and true or false
    elseif m == "fflag" then
        if not CAP.fflag then return false end
        local ok = pcall(setfflag, "DFIntTaskSchedulerTargetFps", tostring(v))
        pcall(setfflag, "FFlagTaskSchedulerLimitTargetFpsTo2402", "False")
        return ok
    end
    return (pcall(function() UserSettings():GetService("UserGameSettings").FramerateCap = v end))
end
function K.setCap()
    local v = CAPS[S.bst.cap] or 120
    local val = (v == 0) and 9999 or v
    -- v13.5: hub jadi satu-satunya pemilik cap selama "Buka batas FPS" nyala; Nono cuma disinkronkan tampilannya
    env.NonoHubCap = true
    local nono = K.nono()
    if nono then pcall(nono.SetCap, math.min(val, 300), true) end
    local res = {}
    for _, m in ipairs({ "setfpscap", "fflag", "setelan" }) do res[m] = K.capMethod(m, val) end
    BOOST.capRes = { setfpscap = res.setfpscap, fflag = res.fflag, usersettings = res.setelan }
    return res.setfpscap or res.fflag or res.setelan
end
function K.probeText()
    local r = BOOST.probe
    if not r then return "belum diuji" end
    local function f(x) return x and tostring(math.floor(x + 0.5)) or "-" end
    return "dasar " .. f(r.base) .. " | " .. f(r.setfpscap) .. " | " .. f(r.fflag) .. " | " .. f(r.setelan)
end
-- uji tiap jalur cap dengan render 3D dimatikan sementara (biar GPU tidak jadi penghambat)
function K.capProbe()
    if BOOST.probing then return end
    BOOST.probing = true
    say("warn", "Uji cap FPS: layar hitam sebentar (sekitar 15 dtk)")
    task.spawn(function()
        pcall(function() RunService:Set3dRenderingEnabled(false) end)
        local list = { "setfpscap", "fflag", "setelan" }
        local function measure()
            task.wait(1.2)
            FT.buf, FT.n = {}, 0
            task.wait(2.3)
            local st = K.fpsStats()
            return st and st.hi or 0
        end
        for _, m in ipairs(list) do K.capMethod(m, 60) end
        local res = { base = measure() }
        for _, m in ipairs(list) do
            if K.capAvail(m) then
                K.capMethod(m, 240)
                res[m] = measure()
                K.capMethod(m, 60)
            end
        end
        pcall(function() RunService:Set3dRenderingEnabled(not BOOST.render3d) end)
        BOOST.probe, BOOST.probing = res, false
        if S.bst.unlock then K.setCap() end
        local best, bv = nil, res.base
        for _, m in ipairs(list) do
            if res[m] and res[m] > bv * 1.15 and res[m] > 66 then best, bv = m, res[m] end
        end
        BOOST.best = best
        if best then
            say("ok", "Uji cap: jalur " .. best .. " berhasil membuka batas (" .. math.floor(bv + 0.5) .. " FPS)")
        else
            say("err", "Uji cap: semua jalur tertahan ~" .. math.floor(res.base + 0.5) .. " FPS. Batas ini dari perangkat atau Roblox, bukan dari script.")
        end
    end)
end
function K.capReset() BOOST.capSince, BOOST.capWarned, BOOST.capNote = os.clock(), false, nil end
function K.capText()
    local r = BOOST.capRes
    if not r then return "belum dipakai" end
    local t = {}
    if r.setfpscap then t[#t + 1] = "setfpscap" end
    if r.fflag then t[#t + 1] = "fflag" end
    if r.usersettings then t[#t + 1] = "setelan" end
    return #t > 0 and table.concat(t, "+") or "tidak ada"
end
function K.capNote() return BOOST.capNote end
-- cek apakah FPS benar-benar melewati 60 setelah cap dibuka
function K.capWatch()
    if not S.bst.unlock then BOOST.capSince, BOOST.capNote = nil, nil; return end
    local target = CAPS[S.bst.cap] or 120
    if target ~= 0 and target <= 60 then BOOST.capNote = "Target 60"; return end
    BOOST.capSince = BOOST.capSince or os.clock()
    local st = K.fpsStats()
    if not st or os.clock() - BOOST.capSince < 8 then return end
    if st.hi <= 64 then
        BOOST.capNote = "Tertahan ~60"
        if not BOOST.capWarned then
            BOOST.capWarned = true
            toast("FPS masih tertahan 60. Kemungkinan dibatasi perangkat atau Roblox, lihat Diagnostik.", "warn")
        end
    else
        BOOST.capNote = "Terbuka ~" .. math.floor(st.hi)
    end
end

