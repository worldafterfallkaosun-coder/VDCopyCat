            hud.btn = btn
        end

        local function hudHide()
            if not hud.gui then return end
            hud.ring.Visible, hud.marker.Visible, hud.cdBack.Visible, hud.btn.Visible = false, false, false, false
        end

        ---------------------------------------------------------------- TRACKER SPEAR (+ kalibrasi kecepatan / gravitasi + belajar lempar)
        local TR = {}   -- [BasePart] = rec
        local logged = 0

        local function inCharacter(inst)
            for _, p in ipairs(Players:GetPlayers()) do
                local c = p.Character
                if c and inst:IsDescendantOf(c) then return true end
            end
            return false
        end

        local function ownedByMe(holders)
            for _, h in ipairs(holders) do
                local ok, at = pcall(function() return h:GetAttributes() end)
                if ok and type(at) == "table" then
                    for k, v in pairs(at) do
                        if v == LP.UserId or v == LP.Name or v == LP.DisplayName then return true, tostring(k) end
                    end
                end
            end
            return false
        end

        -- kecepatan awal + gravitasi dari sampel posisi spear (regresi kuadrat terkecil)
        local function calibrate(rec)
            local n = rec.nFlight or rec.n
            if n < 6 then return end
            local span = rec.ts[n] - rec.ts[1]
            if span < 0.2 then return end
            local ts = {}
            local t0 = rec.ts[1]
            for i = 1, n do ts[i] = rec.ts[i] - t0 end
            local _, vx = fitLin(ts, rec.xs, n)
            local _, vz = fitLin(ts, rec.zs, n)
            local _, vy, ay = fitQuad(ts, rec.ys, n)
            if not (vx and vz and vy and ay) then return end
            local speed = math.sqrt(vx * vx + vy * vy + vz * vz)
            local g = -ay
            if speed < 20 or speed > 700 or g < -15 or g > 600 then
                log("SPEAR", string.format("kalibrasi dibuang (speed %.0f g %.1f)", speed, g))
                return
            end
            if g < 2 then g = 0 end
            V.calibSpeed = V.calibSpeed and (V.calibSpeed * 0.65 + speed * 0.35) or speed
            V.calibG = (V.calibG ~= nil) and (V.calibG * 0.65 + g * 0.35) or g
            log("SPEAR", string.format("kalibrasi: speed %.0f (rata2 %.0f) | gravitasi %.1f (rata2 %.1f) | %d sampel %.2fs",
                speed, V.calibSpeed, g, V.calibG, n, span))
        end

        -- lemparan sendiri yang tadi dikunci ke survivor: kena atau meleset berapa stud, lalu koreksi lead / tinggi bidikan
        local function evaluate(rec)
            if not (rec.snap and rec.qAt and rec.pAt) then return end
            local dmin = rec.dmin
            local hit = dmin <= C.hitRadius
            V.shots = V.shots + 1
            if hit then V.hits = V.hits + 1 end
            local vel = rec.vAt or ZERO
            local flatv = Vector3.new(vel.X, 0, vel.Z)
            local spd = flatv.Magnitude
            local miss = rec.qAt - rec.pAt     -- dari spear ke target
            local note = ""
            if C.learn and dmin <= 14 then
                if spd >= 6 then
                    local along = miss:Dot(flatv.Unit)    -- plus = target di depan spear = lead kurang
                    if math.abs(along) <= 12 then
                        V.leadAdj = math.clamp(V.leadAdj + math.clamp(0.3 * along / spd, -0.08, 0.08), -0.2, 0.45)
                        note = string.format(" | lead %+.0f ms", V.leadAdj * 1000)
                    end
                elseif spd < 2 and dmin <= 9 then
                    V.vBias = math.clamp(V.vBias + 0.35 * miss.Y, -2.5, 2.5)
                    note = string.format(" | tinggi %+.2f", V.vBias)
                end
            end
            log("LEMPAR", string.format("%s | terdekat %.1f stud | target %.0f st/s (atas %+.1f) | jarak %.0f%s | kena %d/%d",
                hit and "KENA" or "MELESET", dmin, spd, miss.Y, rec.snap.dist or 0, note, V.hits, V.shots))
        end

        local function finish(rec, why)
            if rec.done then return end
            rec.done = true
            TR[rec.part] = nil
            if rec.mine then
                pcall(calibrate, rec)
                pcall(evaluate, rec)
            end
            if C.tracker and rec.mine then log("SPEAR", "lemparan selesai (" .. tostring(why) .. ") " .. string.format("%.2fs", os.clock() - rec.t0)) end
        end

        local function onMyThrow(rec, now)
            local gap = (V.lastThrow > 0) and (now - V.lastThrow) or nil
            V.lastThrow = now
            if gap and gap >= 0.8 and gap <= 45 then
                V.cdSamples = V.cdSamples + 1
                V.cdMin = math.min(V.cdMin or math.huge, gap)
                if V.cdSamples >= 2 then V.cdLearn = math.clamp(V.cdMin, 1, 60) end
                log("SPEAR", string.format("jeda lempar %.2fs | cooldown dipakai %.1fs%s", gap, V.cdTotal(), V.cdLearn and " (belajar)" or " (tebakan)"))
            end
            V.cdUntil = now + V.cdTotal()
            if V.snap and now - V.snap.t < 0.8 and V.snap.k.char.Parent then rec.snap = V.snap end
        end

        local function trackSpear(inst)
            if not alive() then return end
            local part
            if inst:IsA("BasePart") then part = inst
            elseif inst:IsA("Model") then part = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true) end
            if not part or TR[part] or not part.Parent or inCharacter(part) then return end
            local now = os.clock()
            local pos = part.Position
            local rec = {
                part = part, root = inst, t0 = now, p0 = pos, last = pos, lastSeg = now, prev = pos, prevT = now,
                ts = {}, xs = {}, ys = {}, zs = {}, n = 0, moved = false, dmin = math.huge, vmax = 0,
                phase = part:GetAttribute("VeilSpearPhase"), mine = false,
            }
            if amKiller() or C.forceVeil then
                local own, key = ownedByMe({ inst, part })
                local me = myRoot()
                if own then
                    rec.mine = true
                    if logged < 3 then log("SPEAR", "pemilik dikenali dari atribut " .. tostring(key)) end
                elseif me and (pos - me.Position).Magnitude < 30 then
                    rec.mine = true
                end
            end
            if logged < 3 then
                logged = logged + 1
                local parts = {}
                for _, h in ipairs({ inst, part }) do
                    local ok, at = pcall(function() return h:GetAttributes() end)
                    if ok and type(at) == "table" then
                        for k, v in pairs(at) do parts[#parts + 1] = tostring(k) .. "=" .. tostring(v) end
                    end
                    if h == part then break end
                end
                table.sort(parts)
                log("SPEAR", string.format("muncul %s (%s, %s) atribut: %s", inst:GetFullName(), inst.ClassName,
                    rec.mine and "punyaku" or "orang lain", #parts > 0 and table.concat(parts, ", ") or "-"))
            end
            TR[part] = rec
            if rec.mine then onMyThrow(rec, now) end
        end

        local function onAdded(d)
            if not (C.tracker or C.warn) then return end
            local n = d.Name
            local cand = false
            if #n == 15 and n:lower() == "spearprojectile" then cand = true
            elseif C.looseSpear and n:lower():find("spear", 1, true) then cand = true
            elseif d:IsA("BasePart") and (d:GetAttribute("VeilSpearId") ~= nil or d:GetAttribute("VeilSpearPhase") ~= nil) then cand = true end
            if cand then task.defer(trackSpear, d) end
        end
        keep(Workspace.DescendantAdded:Connect(onAdded))

        local function trackerStep()
            local now = os.clock()
            local me = myRoot()
            local maxLife = (V.math.maxLife or 5) + 1
            local warnT
            local killer = amKiller() or C.forceVeil
            for part, rec in pairs(TR) do
                if not part.Parent then
                    finish(rec, "hilang")
                else
                    local pos = part.Position
                    local dt = now - rec.t0
                    if (pos - rec.p0).Magnitude >= 3 then rec.moved = true end
                    if dt > 0.6 and not rec.moved then
                        TR[part] = nil          -- ga pernah gerak = bukan peluru (properti / dekorasi)
                    elseif dt > maxLife then
                        finish(rec, "kelamaan")
                    else
                        -- fase (atribut game): fase baru di awal = mulai terbang, fase baru setelah terbang = berhenti
                        local ph = part:GetAttribute("VeilSpearPhase")
                        if ph ~= rec.phase then
                            log("SPEAR", string.format("fase %s -> %s (%.2fs)", tostring(rec.phase), tostring(ph), dt))
                            rec.phase = ph
                            if rec.n >= 6 then
                                rec.nFlight = rec.nFlight or rec.n
                            else
                                rec.n, rec.ts, rec.xs, rec.ys, rec.zs = 0, {}, {}, {}, {}
                                rec.t0, rec.p0 = now, pos
                                dt = 0
                            end
                        end
                        if not rec.nFlight and rec.n < 90 then
                            local n = rec.n + 1
                            rec.n = n
                            rec.ts[n], rec.xs[n], rec.ys[n], rec.zs[n] = dt, pos.X, pos.Y, pos.Z
                        end
                        -- jejak
                        if C.tracker and now - rec.lastSeg >= 0.04 then
                            addSeg(rec.last, pos, rec.mine and MINE_COL or OTHER_COL)
                            rec.last, rec.lastSeg = pos, now
                        end
                        -- jarak terdekat ke target yang dikunci waktu lempar
                        local s = rec.snap
                        if s and s.k.root.Parent then
                            local tp = s.k.root.Position + s.off
                            local d = (tp - pos).Magnitude
                            if d < rec.dmin then
                                local tr = VT[s.k.char]
                                rec.dmin, rec.pAt, rec.qAt, rec.vAt = d, pos, tp, tr and tr.vel or ZERO
                            end
                        end
                        -- kecepatan runtuh (nabrak tembok / kena) = lemparan selesai. Dihitung per jendela 0.15s biar update jaringan ga kebaca berhenti
                        if rec.n >= 8 and not rec.nFlight then
                            local n = rec.n
                            local j = n
                            while j > 1 and rec.ts[n] - rec.ts[j] < 0.15 do j = j - 1 end
                            local wdt = rec.ts[n] - rec.ts[j]
                            if wdt >= 0.1 then
                                local sp = (pos - Vector3.new(rec.xs[j], rec.ys[j], rec.zs[j])).Magnitude / wdt
                                if sp > rec.vmax then rec.vmax = sp end
                                if rec.vmax > 20 and sp < rec.vmax * 0.25 then
                                    rec.nFlight = math.max(1, j)
                                    finish(rec, "berhenti")
                                end
                            end
                        end
                        -- peringatan: spear orang lain yang ngarah ke kamu (cuma kalau kamu bukan killer)
                        if C.warn and me and not rec.mine and not killer and not rec.done and rec.n >= 3 then
                            local n = rec.n
                            local j = math.max(1, n - 3)
                            local wdt = rec.ts[n] - rec.ts[j]
                            if wdt > 0.02 then
                                local v = Vector3.new(rec.xs[n] - rec.xs[j], rec.ys[n] - rec.ys[j], rec.zs[n] - rec.zs[j]) / wdt
                                local sp = v.Magnitude
                                if sp > 15 then
                                    local rel = (me.Position + Vector3.new(0, 0.5, 0)) - pos
                                    local tc = rel:Dot(v) / (sp * sp)
                                    if tc > 0 and tc < 3 and (rel - v * tc).Magnitude < 5 and (not warnT or tc < warnT) then warnT = tc end
                                end
                            end
                        end
                    end
                end
            end
            V.warnT = warnT
        end
        keep(RunService.Heartbeat:Connect(function()
            if not alive() then return end
            local ok, err = pcall(trackerStep)
            if not ok and os.clock() - (V.errAt or 0) > 5 then
                V.errAt = os.clock()
                log("VEIL", "tracker error: " .. tostring(err))
            end
        end))

        ---------------------------------------------------------------- COOLDOWN: atribut game yang namanya "cooldown" (buat diagnosa)
        local cdTxt, cdTxtAt = "", 0
        local function cdAttrs(now)
            if now - cdTxtAt < 0.5 then return cdTxt end
            cdTxtAt = now
            local found = {}
            for _, h in ipairs({ LP, myChar() }) do
                local ok, at = pcall(function() return h:GetAttributes() end)
                if ok and type(at) == "table" then
                    for k, v in pairs(at) do
                        local lk = tostring(k):lower()
                        if (lk:find("cooldown", 1, true) or lk:match("cd$")) and #found < 3 then
                            found[#found + 1] = tostring(k) .. "=" .. tostring(v)
                        end
                    end
                end
            end
            cdTxt = table.concat(found, " | ")
            return cdTxt
        end

        ---------------------------------------------------------------- AUTO LEMPAR (eksperimen, default OFF)
        local function autoThrow(now, best, errStuds)
            if now < V.nextThrow or V.cdLeft(now) > 0.05 then return end
            if not best.reach or errStuds > C.throwStuds then return end
            if C.steady and best.dist > CFG.gun.steadyMinDist and not V.steady(best.k.char) then
                V.steadyAt = V.steadyAt or now
                if now - V.steadyAt < CFG.gun.steadyWait then return end
            end
            V.steadyAt = nil
            local hold = (C.throwHold > 0 and C.throwHold) or (V.math.minCharge and (V.math.minCharge + 0.03)) or 0.15
            V.nextThrow = now + hold + C.throwGap
            local ok, why = press(C.throwBind, hold, "vim")
            log("VEIL", string.format("auto lempar -> %s (%.0f stud, meleset %.1f stud) %s %s", best.k.player.DisplayName,
                best.dist, errStuds, ok and "OK" or "GAGAL", tostring(why)))
        end

        ---------------------------------------------------------------- LOOP RENDER: HUD, kunci kamera
        local function lockWanted()
            if C.mode == "auto" then return true end
            if C.mode == "toggle" then return V.toggled end
            return V.heldKey or V.heldBtn
        end

        local errAt = 0
        local function frame(dt)
            local now = os.clock()
            local me, hum = myRoot(), myHum()
            local cam = Workspace.CurrentCamera
            local alive2 = me ~= nil and hum ~= nil and hum.Health > 0
            drawTrails(alive2 and me or nil, now)

            -- peringatan spear (survivor)
            if hud.warn then
                if V.warnT and C.warn and alive2 then
                    hud.warn.Visible = true
                    hud.warn.Text = string.format("!! SPEAR  %.1fs !!", V.warnT)
                    hud.warn.TextTransparency = (math.floor(now * 8) % 2 == 0) and 0 or 0.35
                else
                    hud.warn.Visible = false
                end
            end

            local isV = C.enabled and amVeil()
            V.isVeil = isV
            if not (isV and alive2 and cam and hud.gui) then
                V.targetChar, V.lockedNow, V.snap, V.steadyAt = nil, false, nil, nil
                hideArc()
                hudHide()
                return
            end

            local origin = spawnOrigin()
            local best = origin and pickTarget(origin, cam) or nil
            V.targetChar = best and best.k.char or nil

            local want = C.aim and lockWanted()
            local locked = best ~= nil and want
            V.lockedNow = locked
            local errStuds
            if locked then
                local cf = cam.CFrame
                local goal = (C.aimFrom == "spawn") and best.dir or (best.P - cf.Position).Unit
                local a = 1 - (1 - math.clamp(C.smooth, 0.02, 1)) ^ (math.clamp(dt, 0, 0.1) * 60)
                local nl = cf.LookVector:Lerp(goal, a)
                if nl.Magnitude < 0.01 then nl = goal end
                nl = nl.Unit
                cam.CFrame = CFrame.lookAt(cf.Position, cf.Position + nl)
                errStuds = (best.T - origin).Magnitude * math.tan(math.acos(math.clamp(nl:Dot(goal), -1, 1)))
                V.snap = { t = now, k = best.k, off = best.off, dist = best.dist }
                if V.lastLockChar ~= best.k.char then
                    V.lastLockChar = best.k.char
                    log("VEIL", string.format("nempel ke %s (%s, %.0f stud, terbang %.2fs, lead %.0f ms)", best.k.player.DisplayName,
                        best.kind, best.dist, best.flight, leadTime() * 1000))
                end
                if C.autoThrow then autoThrow(now, best, errStuds) end
            else
                V.snap, V.steadyAt, V.lastLockChar = nil, nil, nil
            end

            -- HUD
            local vp = cam.ViewportSize
            local R = math.tan(math.rad(math.clamp(C.fov, 1, 80))) / math.tan(math.rad(cam.FieldOfView / 2)) * (vp.Y / 2)
            hud.ring.Visible = C.aim
            hud.ring.Size = UDim2.fromOffset(R * 2, R * 2)

            local ready = V.cdLeft(now) <= 0.05
            if best then
                local sp, on = cam:WorldToViewportPoint(best.P)
                hud.marker.Visible = on
                hud.marker.Position = UDim2.fromOffset(sp.X, sp.Y)
                hud.marker.BackgroundColor3 = (not best.reach) and Color3.fromRGB(255, 80, 80)
                    or (ready and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(255, 190, 70))
                hud.mlabel.Text = string.format("%s %s\n%.0fst  %.2fs%s", best.k.player.DisplayName, best.kind, best.dist, best.flight,
                    best.reach and "" or "  JAUH")
                drawArc(me, origin, best.dir, V.speed(), V.grav(), best.flight, hud.marker.BackgroundColor3)
            else
                hud.marker.Visible = false
                hideArc()
            end

            hud.cdBack.Visible = C.cdBar
            if C.cdBar then
                local rem = V.cdLeft(now)
                if rem > 0 then
                    hud.cdFill.Size = UDim2.fromScale(math.clamp(1 - rem / V.cdTotal(), 0, 1), 1)
                    hud.cdFill.BackgroundColor3 = Color3.fromRGB(255, 170, 60)
                    hud.cdText.Text = string.format("Spear: %.1fs", rem)
                else
                    hud.cdFill.Size = UDim2.fromScale(1, 1)
                    hud.cdFill.BackgroundColor3 = Color3.fromRGB(70, 200, 110)
                    hud.cdText.Text = "Spear: siap"
                end
                local extra = cdAttrs(now)
                if extra ~= "" then hud.cdText.Text = hud.cdText.Text .. "  [" .. extra .. "]" end
            end

            hud.btn.Visible = C.button and C.aim and C.mode ~= "auto"
            if hud.btn.Visible then
                local on = (C.mode == "toggle") and V.toggled or (V.heldBtn or V.heldKey)
                hud.btn.BackgroundColor3 = on and Color3.fromRGB(40, 140, 80) or Color3.fromRGB(90, 40, 40)
                hud.btn.Text = on and "LOCK\nON" or "LOCK"
            end
        end

        pcall(function() RunService:UnbindFromRenderStep("DP3_VeilAim") end)
        pcall(buildHud)
        RunService:BindToRenderStep("DP3_VeilAim", Enum.RenderPriority.Camera.Value + 2, function(dt)
            if not alive() then
                pcall(function() RunService:UnbindFromRenderStep("DP3_VeilAim") end)
                if hud.gui then pcall(function() hud.gui:Destroy() end) end
                if AD.folder then pcall(function() AD.folder:Destroy() end) end
                return
            end
            local ok, err = pcall(frame, dt)
            if not ok and os.clock() - errAt > 4 then
                errAt = os.clock()
                log("VEIL", "error: " .. tostring(err))
            end
        end)

