local TeamC = { k = setmetatable({}, { __mode = "k" }), t = -1, list = {}, survT = -1, surv = {} }

local function teamKind(t)
    if not t then return "none" end
    local nm = t.Name
    local c = TeamC.k[t]
    if not c or c.n ~= nm then
        local l = nm:lower()
        c = { n = nm, kind = l:find("killer", 1, true) and "killer" or (l:find("surviv", 1, true) and "survivor" or "other") }
        TeamC.k[t] = c
    end
    return c.kind
end

local function amSurvivor()
    local t = LP.Team
    if not t then return true end
    return teamKind(t) == "survivor"
end

local function amKiller()
    local t = LP.Team
    return t ~= nil and teamKind(t) == "killer"
end

local function killers()
    local now = os.clock()
    if now - TeamC.t < 0.008 then return TeamC.list end
    local out = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local ch = p.Character
        if p ~= LP and ch and teamKind(p.Team) == "killer" then
            local hum = ch:FindFirstChildOfClass("Humanoid")
            local root = ch:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                out[#out + 1] = { player = p, char = ch, hum = hum, root = root }
            end
        end
    end
    TeamC.t, TeamC.list = now, out
    return out
end

local function survivors()
    local now = os.clock()
    if now - TeamC.survT < 0.008 then return TeamC.surv end
    local out = {}
    local iAmK = amKiller()
    for _, p in ipairs(Players:GetPlayers()) do
        local ch = p.Character
        if p ~= LP and ch then
            local kk = teamKind(p.Team)
            local isTarget = false
            if kk == "survivor" then isTarget = true
            elseif kk == "none" and iAmK then isTarget = true end
            if isTarget then
                local hum = ch:FindFirstChildOfClass("Humanoid")
                local root = ch:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    out[#out + 1] = { player = p, char = ch, hum = hum, root = root }
                end
            end
        end
    end
    TeamC.survT, TeamC.surv = now, out
    return out
end

