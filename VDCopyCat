function K.hookParry()
    local ui = AP and AP.UI
    if type(ui) ~= "table" then return end
    -- toast ON/OFF dari tombol toggle (P) tampil di UI hub
    ui.toast = function(msg, kind) toast(msg, (kind == "bad") and "err" or kind) end
