        log("HIDE", "error: " .. tostring(err))
    end
end)

------------------------------------------------------------------ BELAJAR TERSIMPAN (v10)
-- Hasil belajar disimpan ke dp10_learn.json (writefile) biar ga mulai dari nol tiap ronde / reload. Yang disimpan: waktu "animasi ->
-- kena" per animasi parry, koreksi parry, lead / bias / originLag gun, range parry, tuning skill check per tier.
-- Statistik muncul/kena (buat buang animasi bukan serangan) SENGAJA ga disimpan: data ronde yang salah bisa bikin animasi serangan
-- dibuang permanen. Hapus file itu (atau tombol Wipe) buat reset belajar. Dibungkus do...end biar ga nambah local di chunk utama.
do
    local HttpService = game:GetService("HttpService")
    local FILE = "dp10_learn.json"
    local lastJson = ""

    local function num(v, lo, hi)
        if type(v) ~= "number" or v ~= v then return nil end
        return math.clamp(v, lo, hi)
    end

    local function loadLearn()
        if not (readfile and isfile) then return end
        local okF, has = pcall(isfile, FILE)
        if not (okF and has) then return end
        local okR, raw = pcall(readfile, FILE)
        if not okR or type(raw) ~= "string" or raw == "" then return end
        local okD, d = pcall(function() return HttpService:JSONDecode(raw) end)
        if not okD or type(d) ~= "table" then return end
        local nHit = 0
        if type(d.hits) == "table" then
            for k, arr in pairs(d.hits) do
                if type(k) == "string" and type(arr) == "table" then
                    local clean = {}
                    for _, v in ipairs(arr) do
                        local x = num(v, 0.02, 1.5)
                        if x and #clean < 5 then clean[#clean + 1] = x end
                    end
                    if #clean > 0 then
                        Parry.hits[k] = clean
                        nHit = nHit + 1
                    end
                end
            end
        end
        if type(d.shift) == "table" then
            for k, v in pairs(d.shift) do
                local x = num(v, -0.2, 0.2)
                if type(k) == "string" and x then Parry.shift[k] = x end
            end
        end
        local g = type(d.gun) == "table" and d.gun or {}
        Gun.leadAdj = num(g.leadAdj, -0.12, 0.3) or Gun.leadAdj
        Gun.biasR = num(g.biasR, -0.06, 0.06) or Gun.biasR
        Gun.biasU = num(g.biasU, -0.06, 0.06) or Gun.biasU
        CFG.gun.originLag = num(g.originLag, 0, 0.15) or CFG.gun.originLag
        CFG.parry.range = num(d.range, 8, 22) or CFG.parry.range
        if type(d.veil) == "table" then pcall(Veil.load, d.veil) end
        if type(d.tune) == "table" then
            for k, v in pairs(d.tune) do
                local x = num(v, -0.08, 0.25)
                if type(k) == "string" and x then Skill.tuneDelta[k] = x end
            end
        end
        log("BELAJAR", string.format("dimuat: %d animasi parry | lead %+.0f ms | originLag %.0f ms | range %.1f",
            nHit, Gun.leadAdj * 1000, (CFG.gun.originLag or 0) * 1000, CFG.parry.range))
    end

    function Skill.saveLearn()
        if not writefile then return false end
        local hits, shift = {}, {}
        for k, v in pairs(Parry.hits) do
            if type(k) == "string" then hits[k] = v end
        end
        for k, v in pairs(Parry.shift) do
            if type(k) == "string" then shift[k] = v end
        end
        local data = {
            v = 11, hits = hits, shift = shift, range = CFG.parry.range, tune = Skill.tuneDelta,
            veil = Veil.save(),
            gun = { leadAdj = Gun.leadAdj, biasR = Gun.biasR, biasU = Gun.biasU, originLag = CFG.gun.originLag },
        }
        local ok, js = pcall(function() return HttpService:JSONEncode(data) end)
        if not ok then return false end
        if js ~= lastJson then
            lastJson = js
            return (pcall(writefile, FILE, js))
        end
        return true
    end

    function Skill.wipeLearn()
        Parry.hits, Parry.shift = {}, {}
        Gun.leadAdj, Gun.biasR, Gun.biasU = 0, 0, 0
        Skill.tuneDelta = {}
        pcall(Veil.wipe)
        lastJson = ""
        pcall(Skill.saveLearn)
        log("BELAJAR", "dihapus: parry / gun / skill mulai belajar dari nol")
    end

    pcall(loadLearn)
    task.spawn(function()
        while alive() do
            task.wait(20)
            if alive() then pcall(Skill.saveLearn) end
        end
    end)
end

------------------------------------------------------------------ RESET
local function resetAll()
    Gun.pending, Gun.firing, Gun.holdoff, Gun.failStreak, Gun.cycles = nil, false, 0, 0, 0
    Gun.pauseUntil, Gun.lockUntil, Gun.tierIdx, Gun.tierGood = 0, 0, 1, {}
    Gun.lockTarget, Gun.lockAng = nil, 180
    Skill.tierName, Skill.tierGood, Skill.retried, Skill.tierFail = nil, {}, false, {}
    Skill.tuneDelta, Skill.ladder = {}, nil
    Skill.gen = Skill.gen + 1
    pcall(Veil.reset)
    unhideChecks()
    pcall(function() RunService:UnbindFromRenderStep("DP3_CamLock") end)
    notify("Reset: state gun/skill dibersihin")
end

------------------------------------------------------------------ 4) ESP (v9.0)
-- Murni sisi client. Highlight + BillboardGui ditaruh di folder gethui/CoreGui (ga bisa dibaca script game, ga kereplikasi).
-- Ga ada remote yang ditembak dan ga ada objek game yang diubah.
-- v8.8: outline juga buat objek, mode teks full/mini/off, bar progress/HP, jatah Highlight (batas Roblox ~31).
local ESP = { entries = {}, folder = nil, errAt = 0, tPlayers = 0, tObjs = 0, tMap = 0, nameHits = {} }

local function espFolder()
    if ESP.folder and ESP.folder.Parent then return ESP.folder end
    local parent
    pcall(function() parent = (gethui and gethui()) or game:GetService("CoreGui") end)
    if not parent then parent = LP:FindFirstChildOfClass("PlayerGui") end
    if not parent then return nil end
    local old = parent:FindFirstChild("DP3_ESP")
    if old then old:Destroy() end
    local f = Instance.new("Folder")
    f.Name = "DP3_ESP"
    f.Parent = parent
    ESP.folder = f
    return f
end

local function espDrop(key)
    local e = ESP.entries[key]
    if not e then return end
    ESP.entries[key] = nil
    pcall(function()
        e.bb:Destroy()
        if e.hl then e.hl:Destroy() end
    end)
end

local function espClear()
    for key in pairs(ESP.entries) do espDrop(key) end
    if ESP.folder then
        pcall(function() ESP.folder:Destroy() end)
        ESP.folder = nil
    end
end

-- kind: "player" | "gen" | "pallet" | "hook" | "exit"
-- Highlight dibuat malas (lazy) di espUpdate sesuai jatah, jadi espMake cuma bikin label + bar.
local function espMake(key, adornee, kind)
    local f = espFolder()
    if not f then return nil end
    local bb = Instance.new("BillboardGui")
    bb.Name = "esp"
    bb.Adornee = adornee
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.ResetOnSpawn = false
    bb.Size = UDim2.fromOffset(150, 40)
    bb.StudsOffsetWorldSpace = Vector3.new(0, kind == "player" and 3.6 or 2.4, 0)
    bb.Parent = f

    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position = UDim2.fromOffset(0, 0)
    l.Size = UDim2.new(1, 0, 0, 28)
    l.Font = Enum.Font.GothamMedium
    l.TextSize = 12
    l.TextYAlignment = Enum.TextYAlignment.Bottom
    l.TextStrokeTransparency = 0.5
    l.TextColor3 = Color3.new(1, 1, 1)
    l.Text = ""
    l.Parent = bb

    -- bar tipis: progress generator / HP survivor
    local back = Instance.new("Frame")
    back.AnchorPoint = Vector2.new(0.5, 0)
    back.Position = UDim2.new(0.5, 0, 0, 31)
    back.Size = UDim2.fromOffset(70, 7)
    back.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    back.BackgroundTransparency = 0
    back.BorderColor3 = Color3.fromRGB(255, 255, 255)
    back.BorderSizePixel = 1
    back.Visible = false
    back.Parent = bb
    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BorderSizePixel = 0
    fill.Parent = back

    local e = { kind = kind, adornee = adornee, bb = bb, lbl = l, bar = back, barFill = fill }
    ESP.entries[key] = e
    return e
end

local function espHighlight(e)
    if e.hl and e.hl.Parent then return e.hl end
    local f = ESP.folder
    if not f then return nil end
    local h = Instance.new("Highlight")
    h.Name = "esp_hl"
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.OutlineTransparency = 0
    h.Adornee = e.hlTarget
    h.Parent = f
    e.hl = h
    return h
end

local function espAdornee(m)
    if m:IsA("BasePart") then return m end
    return m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
end

local function espVisible(m)
    if not m then return false end
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency < 0.95 then return true end
    end
    return false
end

local function espSweep(kinds, seen)
    for key, e in pairs(ESP.entries) do
        if kinds[e.kind] and not seen[key] then espDrop(key) end
    end
end

local ESP_PLAYER = { player = true }
local ESP_OBJ = { gen = true, pallet = true, hook = true, exit = true }
local ESP_PRIO = { player = 1, gen = 1, exit = 2, hook = 3, pallet = 3 }   -- jatah Highlight: kecil = duluan

-- v9.0: generator dicari lewat 3 jalur sekaligus (folder Map.newGenerators, tag "GeneratorPoint", part "GeneratorBody").
-- Semua disimpan di tabel ESP biar ga nambah variabel local di chunk utama (batas Lua 200).
ESP.gen = { found = {}, bodies = {}, tScan = -10, tBody = -10, sig = "", tLog = 0, busy = false }
ESP.genProgNames = { "RepairProgress", "Progress", "repairProgress", "GeneratorProgress" }

function ESP.genTop(inst)   -- model generator dari GeneratorBody / GeneratorPoint
    local p = inst.Parent
    if p and p ~= workspace and p:IsA("Model") and not Players:GetPlayerFromCharacter(p) then return p end
    return inst
end

function ESP.genScan()
    local G, now = ESP.gen, os.clock()
    if now - G.tScan < CFG.esp.scanGens then return G.found end
    G.tScan = now
    local found, via = {}, { folder = 0, tag = 0, body = 0 }
    local function dup(inst)   -- udah ada dia / induknya (<= 4 tingkat) di daftar
        local up = inst
        for _ = 1, 4 do
            if not up or up == workspace then return false end
            if found[up] then return true end
            up = up.Parent
        end
        return false
    end
    local function add(m, how)
        if m and m.Parent and not dup(m) then
            found[m] = how
            via[how] = via[how] + 1
        end
    end
    local map = workspace:FindFirstChild("Map")
    local ng = map and map:FindFirstChild("newGenerators")
    if ng then
        for _, m in ipairs(ng:GetChildren()) do
            if m:IsA("Model") or m:IsA("BasePart") then add(m, "folder") end
        end
    end
    pcall(function()
        for _, pt in ipairs(CS:GetTagged("GeneratorPoint")) do
            if pt:IsDescendantOf(workspace) then add(ESP.genTop(pt), "tag") end
        end
    end)
    -- cadangan: part "GeneratorBody" (nama dipakai kode game). Discan bertahap di thread sendiri biar ga lag.
    if CFG.esp.genBodyScan and via.folder == 0 and now - G.tBody >= CFG.esp.scanBody and not G.busy then
        G.tBody, G.busy = now, true
        task.spawn(function()
            local list, n = {}, 0
            pcall(function()
                for _, d in ipairs(workspace:GetDescendants()) do
                    n = n + 1
                    if d.Name == "GeneratorBody" and d:IsA("BasePart") then list[#list + 1] = d end
                    if n % 4000 == 0 then task.wait() end
                end
            end)
            G.bodies, G.busy = list, false
        end)
    end
    for _, b in ipairs(G.bodies) do
        if b.Parent and b:IsDescendantOf(workspace) then add(ESP.genTop(b), "body") end
    end
    G.found = found

    local total = via.folder + via.tag + via.body
    local sig = via.folder .. "/" .. via.tag .. "/" .. via.body
    if sig ~= G.sig or (total == 0 and now - G.tLog > 20) then
        G.sig, G.tLog = sig, now
        local first
        for m in pairs(found) do
            first = m
            break
        end
        log("ESP", string.format("generator ketemu: folder %d, tag %d, body %d%s", via.folder, via.tag, via.body,
            first and (" | contoh: " .. first:GetFullName())
            or (" | KOSONG (Map=" .. tostring(map ~= nil) .. ", newGenerators=" .. tostring(ng ~= nil) .. ")")))
    end
    return found
end

function ESP.genAdornee(m)
    if m:IsA("BasePart") then return m end
    return m:FindFirstChild("GeneratorBody", true) or m:FindFirstChild("HitBox", true) or espAdornee(m)
end

function ESP.genProg(e)   -- nil = progress ga ketemu di attribute mana pun
    for _, o in ipairs({ e.model, e.adornee }) do
        if o then
            for _, n in ipairs(ESP.genProgNames) do
                local v = tonumber(o:GetAttribute(n))
                if v then return v end
            end
        end
    end
    return nil
end

local function espScanPlayers()
    local C = CFG.esp
    local seen = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local ch = p.Character
        if p ~= LP and ch then
            local tn = p.Team and p.Team.Name:lower() or ""
            local isK = tn:find("killer", 1, true) ~= nil
            local isS = tn:find("surviv", 1, true) ~= nil
            if (isK and C.killer) or (isS and C.survivors) then
                local hum = ch:FindFirstChildOfClass("Humanoid")
                local root = ch:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    local e = ESP.entries[ch] or espMake(ch, root, "player")
                    if e then
                        e.p, e.hum, e.root, e.isK, e.adornee, e.hlTarget = p, hum, root, isK, root, ch
                        seen[ch] = true
                    end
                end
            end
        end
    end
    espSweep(ESP_PLAYER, seen)
end

local function espScanObjects()
    local C = CFG.esp
    local seen = {}
    -- v9.0: generator lewat genScan (folder + tag + GeneratorBody), ga lagi bergantung ke Map.newGenerators doang
    if C.objects and C.gens then
        local okG, errG = pcall(function()
            for m in pairs(ESP.genScan()) do
                if m.Parent then
                    local ad = ESP.genAdornee(m)
                    if ad then
                        local e = ESP.entries[m] or espMake(m, ad, "gen")
                        if e then
                            e.model, e.adornee, e.hlTarget = m, ad, m
                            seen[m] = true
                        end
                    end
                end
            end
        end)
        if not okG and os.clock() - ESP.errAt > 5 then
            ESP.errAt = os.clock()
            log("ESP", "scan gen error: " .. tostring(errG))
        end
    end
    local map = workspace:FindFirstChild("Map")
    if map and C.objects then
        local pals = map:FindFirstChild("Pallets")
        if pals and C.pallets then
            for _, m in ipairs(pals:GetChildren()) do
                if m:IsA("Model") then
                    local intact, broken = m:FindFirstChild("Intact"), m:FindFirstChild("Broken")
                    local state
                    if intact and espVisible(intact) then state = "ok"
                    elseif broken and espVisible(broken) then state = "broken" end
                    local ad = espAdornee(intact or broken or m)
                    if ad and state then
                        local e = ESP.entries[m] or espMake(m, ad, "pallet")
                        if e then
                            e.model, e.adornee, e.state = m, ad, state
                            e.hlTarget = (state == "ok") and intact or broken
                            seen[m] = true
                        end
                    end
                end
            end
        end
    end
    -- hook / exit: dicari lewat nama (jarang berubah, jadi discan lebih jarang)
    if map and C.objects and (C.hooks or C.exits) and os.clock() - ESP.tMap >= C.scanMap then
        ESP.tMap = os.clock()
        local gens, pals = map:FindFirstChild("newGenerators"), map:FindFirstChild("Pallets")
        local hits, matched, scanN = {}, {}, 0
        for _, d in ipairs(map:GetDescendants()) do
            scanN = scanN + 1
            if scanN % 2500 == 0 then task.wait() end   -- v10: nyicil, GetDescendants Map bisa puluhan ribu objek (freeze di map gede)
            if d:IsA("Model") or d:IsA("BasePart") then
                local up, skip = d.Parent, false
                for _ = 1, 4 do
                    if not up or up == map then break end
                    if matched[up] then
                        skip = true
                        break
                    end
                    up = up.Parent
                end
                if not skip and not (gens and d:IsDescendantOf(gens)) and not (pals and d:IsDescendantOf(pals)) then
                    local ln = d.Name:lower()
                    local kind
                    if C.hooks and nameHas(ln, C.hookNames) then kind = "hook"
                    elseif C.exits and nameHas(ln, C.exitNames) then kind = "exit" end
                    if kind then
                        matched[d] = true
                        hits[d] = kind
                    end
                end
            end
        end
        ESP.nameHits = hits
    end
    for d, kind in pairs(ESP.nameHits) do
        local isOn = (kind == "hook" and C.hooks) or (kind == "exit" and C.exits)
        if d.Parent and isOn and C.objects then
            local ad = espAdornee(d)
            if ad then
                local e = ESP.entries[d] or espMake(d, ad, kind)
                if e then
                    e.model, e.adornee, e.hlTarget = d, ad, d
                    seen[d] = true
                end
            end
        end
    end
    espSweep(ESP_OBJ, seen)
end

local ESP_COL = {
    killer = Color3.fromRGB(255, 60, 60), survivor = Color3.fromRGB(90, 200, 255),
    bad = Color3.fromRGB(255, 150, 40), pallet = Color3.fromRGB(255, 220, 90),
    broken = Color3.fromRGB(150, 150, 150), hook = Color3.fromRGB(255, 140, 0),
    exit = Color3.fromRGB(140, 255, 140), lock = Color3.fromRGB(255, 255, 255),
    genLo = Color3.fromRGB(255, 70, 70), genHi = Color3.fromRGB(80, 255, 120),
    genUnk = Color3.fromRGB(255, 200, 60),
}

local function espUpdate()
    local C = CFG.esp
    local cam = workspace.CurrentCamera
    local me = myRoot()
    local from = (me and me.Position) or (cam and cam.CFrame.Position)
    local mode = C.text
    local lockedChar = Gun.lockTarget and Gun.lockTarget.Parent
    local vChar = Veil.targetChar   -- v11: survivor yang lagi di-lock Veil Assist
    local want = {}   -- kandidat Highlight, dijatah setelah loop

    -- v8.9: satu entry error ga boleh bikin entry lain (mis. generator) ga ke-update
    local function one(key, e)
        local ad = e.adornee
        if not (ad and ad.Parent) or (e.hum and e.hum.Health <= 0) then
            espDrop(key)
            return
        end
        local dist = from and (ad.Position - from).Magnitude or 0
        local show = (C.maxDist <= 0) or dist <= C.maxDist
        local title, mini, sub, frac = "", "", nil, nil
        local col = Color3.new(1, 1, 1)
        local locked = false

        if e.kind == "player" then
            local ch = e.hum.Parent
            col = e.isK and ESP_COL.killer or ESP_COL.survivor
            local state
            if ch then
                if ch:GetAttribute("IsHooked") then state = "HOOK"
                elseif ch:GetAttribute("IsCarried") then state = "DIGENDONG"
                elseif ch:GetAttribute("Trapped") then state = "TRAP" end
            end
            if state and not e.isK then col = ESP_COL.bad end
            locked = (e.isK and lockedChar ~= nil and lockedChar == ch) or ((not e.isK) and vChar ~= nil and vChar == ch)
            if locked then col = ESP_COL.lock end
            title = (e.isK and "KILLER " or "") .. (C.names and e.p.DisplayName or "")
            if locked then title = "[LOCK] " .. title end
            if state then title = title .. " [" .. state .. "]" end
            if C.hp and not e.isK and e.hum.MaxHealth > 0 then
                sub = string.format("%d%%", math.floor(e.hum.Health / e.hum.MaxHealth * 100 + 0.5))
            end
            if (not e.isK) and e.hum.MaxHealth > 0 then
                frac = e.hum.Health / e.hum.MaxHealth
            end
            mini = state or (locked and "LOCK") or (e.isK and "KILLER") or ""
        elseif e.kind == "gen" then
            local prog = ESP.genProg(e)
            local known = prog ~= nil
            prog = prog or 0
            if C.hideDoneGens and known and prog >= 99.9 then show = false end
            col = known and ESP_COL.genLo:Lerp(ESP_COL.genHi, math.clamp(prog / 100, 0, 1)) or ESP_COL.genUnk
            title = known and string.format("GEN %d%%", math.floor(prog + 0.5)) or "GEN"
            local n = tonumber(e.model:GetAttribute("PlayersRepairingCount")) or 0
            if n > 0 then title = title .. " x" .. n end
            if e.model:GetAttribute("ProgressPaused") then title = title .. " (pause)" end
            if known then frac = math.clamp(prog / 100, 0, 1) end
            mini = known and string.format("%d%%", math.floor(prog + 0.5)) or "GEN"
        elseif e.kind == "pallet" then
            if e.state == "broken" then
                if not C.showBroken then show = false end
                col, title = ESP_COL.broken, "PALLET patah"
            else
                col, title = ESP_COL.pallet, "PALLET"
            end
        elseif e.kind == "hook" then
            col, title = ESP_COL.hook, "HOOK"
        else
            col, title = ESP_COL.exit, (e.model and e.model.Name or "EXIT"):upper()
            mini = "EXIT"
        end

        -- teks: off = kosong, mini = satu baris pendek, full = nama + info + jarak
        -- generator, exit, dan pemain TETAP ada teks di jarak berapa pun; cuma pallet / hook yang kena batas textDistObjs
        local isPlayer = e.kind == "player"
        local textOk = mode ~= "off"
        local farOnly = (e.kind == "pallet" or e.kind == "hook")
        if textOk and farOnly and C.textDistObjs > 0 and dist > C.textDistObjs then textOk = false end
        if textOk and isPlayer and C.textDistPlayers > 0 and dist > C.textDistPlayers then textOk = false end
        local distTxt = C.dist and (math.floor(dist + 0.5) .. "m") or nil
        local text = ""
        if textOk then
            if mode == "mini" then
                text = mini
                if distTxt and (isPlayer or e.kind == "gen" or e.kind == "exit") then
                    text = (text ~= "" and (text .. " ") or "") .. distTxt
                end
            else
                local parts = {}
                if title ~= "" then parts[#parts + 1] = title end
                if sub then parts[#parts + 1] = sub end
                text = table.concat(parts, "  ")
                if distTxt then text = (text ~= "" and (text .. "\n") or "") .. distTxt end
            end
        end
        local fade = math.clamp((dist - 60) / 240, 0, 0.4)   -- makin jauh makin pudar (maks 40%)

        local showBar = show and C.bars and frac ~= nil
        e.bb.Enabled = show and (text ~= "" or showBar)
        e.lbl.Text = text
        e.lbl.TextColor3 = col
        e.lbl.TextSize = (mode == "mini") and 11 or 12
        e.lbl.TextTransparency = fade
        e.lbl.TextStrokeTransparency = 0.5 + fade * 0.5
        e.bar.Visible = showBar
        if showBar then
            e.barFill.Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1)
            e.barFill.BackgroundColor3 = col
        end

        -- outline: kandidat jatah Highlight
        local hlWanted = show and e.hlTarget and e.hlTarget.Parent
            and ((isPlayer and C.outline) or ((not isPlayer) and C.objOutline))
        if hlWanted then
            want[#want + 1] = { e = e, col = col, dist = dist, locked = locked,
                near = (e.isK == true and dist <= CFG.parry.range),   -- v9.0: killer di dalam cincin parry -> isi lebih tebel
                prio = locked and 0 or (ESP_PRIO[e.kind] or 3) }
        elseif e.hl then
            e.hl.Enabled = false
        end
    end

    for key, e in pairs(ESP.entries) do
        local ok, err = pcall(one, key, e)
        if not ok and os.clock() - ESP.errAt > 5 then
            ESP.errAt = os.clock()
            log("ESP", "update " .. tostring(e.kind) .. " error: " .. tostring(err))
        end
    end

    -- jatah Highlight: lock > pemain/generator > exit > hook/pallet, dalam kelompok yang paling deket duluan
    local okB, errB = pcall(function()
        table.sort(want, function(a, b)
            if a.prio ~= b.prio then return a.prio < b.prio end
            return a.dist < b.dist
        end)
        local budget = math.max(1, math.floor(C.maxHighlights))
        for i, w in ipairs(want) do
            local e = w.e
            if i <= budget then
                local h = espHighlight(e)
                if h then
                    if h.Adornee ~= e.hlTarget then h.Adornee = e.hlTarget end
                    h.Enabled = true
                    h.OutlineColor = w.col
                    h.FillColor = w.col
                    h.FillTransparency = w.locked and 0.55
                        or (w.near and 0.5)
                        or (e.kind == "player" and C.fillPlayers)
                        or (e.kind == "gen" and C.fillGens)
                        or C.fillObjs
                end
            elseif e.hl then
                e.hl.Enabled = false
            end
        end
    end)
    if not okB and os.clock() - ESP.errAt > 5 then
        ESP.errAt = os.clock()
        log("ESP", "outline error: " .. tostring(errB))
    end
end

local function espStep()
    local C = CFG.esp
    local now = os.clock()
    if now - ESP.tPlayers >= C.scanPlayers then
        ESP.tPlayers = now
        espScanPlayers()
    end
    if now - ESP.tObjs >= C.scanObjects then
        ESP.tObjs = now
        espScanObjects()
    end
    espUpdate()
end

