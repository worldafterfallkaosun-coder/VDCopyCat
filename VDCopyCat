--[[ DP patch for v8.3 | Roblox Luau | needs VirtualInputManager; getconnections or firesignal for "direct"
  1) parry delay that follows ping + fps, and skips shots it can't make (a miss = 60s cooldown)
  2) skill-check input that finds out WHY a press doesn't land, picks a method before the check starts,
     and learns from your own successful press
  Standalone: paste above v8.3, then wire the spots listed at the bottom. ]]

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local Stats      = game:GetService("Stats")
local UIS        = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local VIM        = game:GetService("VirtualInputManager")
local LP         = Players.LocalPlayer

local DP = {
    frameDt = 1 / 60, rtt = 0.10, jitter = 0.01,  -- live values, updated below
    hits = {},                                    -- animId -> last swing->damage times (s)
    LEAD = 0.04,        -- parry must reach the server this long before the hit (raise if it lands late)
    DEFAULT_HIT = 0.14, -- swing->damage guess for an animation not learned yet
    SLACK = 0.03,       -- if we're already this late, don't fire (saves the 60s cooldown)
    REACH = 11,         -- threat gate: studs at hit time (calibrate with the [HIT] log lines)
    CONE = 0.35,        -- threat gate: min dot(killer look, direction to me)
    KEY = Enum.KeyCode.Space, -- PC fallback until a real press is learned
    bad = {}, checkOpen = false, pressing = false,
    log = function(...) print("[DP]", ...) end,   -- point this at your panel logger
}

------------------------------------------------------------------ 1) live clock
RunService.Heartbeat:Connect(function(dt)
    DP.frameDt = DP.frameDt * 0.9 + dt * 0.1
end)

task.spawn(function()
    while true do
        local ok, ms = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok and ms and ms > 0 then
            local s = ms / 1000
            DP.jitter = DP.jitter * 0.8 + math.abs(s - DP.rtt) * 0.2
            DP.rtt = DP.rtt * 0.8 + s * 0.2
        end
        task.wait(0.25)
    end
end)

------------------------------------------------------------------ 2) parry
-- hit = seconds from "client sees swing start" to "client sees damage". Both events arrive with the
-- same one-way latency, so hit is ping-free. The parry remote costs a full RTT though:
--   arrives = swingSeen + delay + RTT   and it must be <= hit - LEAD
function DP.learnHit(animId, swingSeen, killerRoot, myRoot)
    local hit = os.clock() - swingSeen
    if hit < 0.05 or hit > 0.8 then return end            -- not this swing's damage
    local h = DP.hits[animId] or {}
    h[#h + 1] = hit
    if #h > 5 then table.remove(h, 1) end
    DP.hits[animId] = h
    local extra = ""
    if killerRoot and myRoot then
        local _, dist, dot = DP.threat(killerRoot, myRoot, 0)
        extra = (" dist=%.1f dot=%.2f"):format(dist, dot)
    end
    DP.log(("[HIT] %s swing->damage %.0f ms (n=%d)%s"):format(tostring(animId), hit * 1000, #h, extra))
end

function DP.hitFor(animId)
    local h = DP.hits[animId]
    if not h or #h == 0 then return DP.DEFAULT_HIT end
    local s = table.clone(h)
    table.sort(s)
    return s[math.ceil(#s / 2)]                            -- median, ignores outliers
end

-- seconds to wait after seeing the swing, or nil = can't make the window, don't burn the cooldown
function DP.parryDelay(animId)
    local hit = DP.hitFor(animId)
    local d = hit - DP.LEAD - (DP.rtt + DP.jitter)
    DP.log(("parry plan: hit=%.0fms rtt=%.0fms fps=%.0f -> delay=%.0fms"):format(
        hit * 1000, DP.rtt * 1000, 1 / DP.frameDt, d * 1000))
    if d < -DP.SLACK then return nil end
    return math.max(d, 0)
end

-- fires on the heartbeat closest to the target instead of task.wait (which always rounds UP to the next frame)
function DP.fireAt(t0, delay, fn)
    local target = t0 + delay
    local c
    c = RunService.Heartbeat:Connect(function()
        if os.clock() >= target - DP.frameDt * 0.5 then
            c:Disconnect()
            fn()
        end
    end)
end

-- threat gate at the PREDICTED hit time, not at swing start (the killer lunges during the swing)
function DP.threat(killerRoot, myRoot, hitIn)
    local pos = killerRoot.Position + killerRoot.AssemblyLinearVelocity * math.max(hitIn, 0)
    local to = myRoot.Position - pos
    to = Vector3.new(to.X, 0, to.Z)
    local dist = to.Magnitude
    if dist < 0.1 then return true, dist, 1 end
    local look = killerRoot.CFrame.LookVector
    local dot = Vector3.new(look.X, 0, look.Z).Unit:Dot(to.Unit)
    return dist <= DP.REACH and dot >= DP.CONE, dist, dot
end

------------------------------------------------------------------ 3) skill check
-- needle math: input lands ~1 frame after we send it, plus our own scheduling jitter (~0.5 frame)
function DP.pressLead(tune) return (tune or 0.015) + DP.frameDt * 1.5 end

-- getRem() = degrees left until the sweet spot (nil when the check is gone), getSpeed() = deg/s
function DP.schedulePress(getRem, getSpeed, press)
    local c
    c = RunService.Heartbeat:Connect(function()
        local rem, spd = getRem(), getSpeed()
        if not rem or not spd or spd <= 0 then
            c:Disconnect()
            return
        end
        if rem / spd <= DP.pressLead() then
            c:Disconnect()
            press()
        end
    end)
end

local MOVE = {W = 1, A = 1, S = 1, D = 1, Up = 1, Down = 1, Left = 1, Right = 1,
              LeftShift = 1, LeftControl = 1, Unknown = 1}
local EVENTS = {"MouseButton1Down", "Activated", "MouseButton1Click", "TouchTap"}

local function center(g)
    local p, s = g.AbsolutePosition, g.AbsoluteSize
    return p.X + s.X / 2, p.Y + s.Y / 2
end

-- gui space -> VIM screen space (topbar inset, unless the ScreenGui ignores it)
local function screenPt(g, x, y)
    local sg = g:FindFirstAncestorWhichIsA("ScreenGui")
    if sg and not sg.IgnoreGuiInset then y = y + GuiService:GetGuiInset().Y end
    return x, y
end

-- what sits on top of the button's center? the first Active thing above it swallows the input
local function probe(g)
    local x, y = center(g)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    local r = {names = {}, reached = false}
    for _, o in ipairs(pg:GetGuiObjectsAtPosition(x, y)) do
        if #r.names < 8 then
            r.names[#r.names + 1] = (o:GetFullName():gsub("^.-PlayerGui%.", ""))
        end
        if o == g or o:IsDescendantOf(g) then
            r.reached = true
        elseif not r.reached and not r.blocker and (o.Active or o:IsA("GuiButton")) then
            r.blocker = o
        end
    end
    r.clear = r.reached and r.blocker == nil
    return r
end

local function connCount(g)
    if not getconnections then return 0, nil end
    for _, ev in ipairs(EVENTS) do
        local ok, n = pcall(function() return #getconnections(g[ev]) end)
        if ok and n > 0 then return n, ev end
    end
    return 0, nil
end

local function sendTouch(x, y)
    DP.sentX, DP.sentY = x, y
    VIM:SendTouchEvent(77, 0, x, y)
    task.spawn(function()
        RunService.Heartbeat:Wait()
        VIM:SendTouchEvent(77, 2, x, y)
    end)
end

local function sendClick(x, y)
    DP.sentX, DP.sentY = x, y
    VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.spawn(function()
        RunService.Heartbeat:Wait()
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

local function sendKey(k)
    VIM:SendKeyEvent(true, k, false, game)
    task.spawn(function()
        RunService.Heartbeat:Wait()
        VIM:SendKeyEvent(false, k, false, game)
    end)
end

-- run once per session when the action button exists, then paste the [DP] lines back
function DP.diagnose(btn)
    local pr = probe(btn)
    local n, ev = connCount(btn)
    local x, y = center(btn)
    DP.log(("env touch=%s kb=%s getconnections=%s firesignal=%s inset=%s"):format(
        tostring(UIS.TouchEnabled), tostring(UIS.KeyboardEnabled), tostring(getconnections ~= nil),
        tostring(firesignal ~= nil), tostring(GuiService:GetGuiInset())))
    DP.log(("btn %s @%.0f,%.0f visible=%s reachedByProbe=%s"):format(
        btn:GetFullName(), x, y, tostring(btn.Visible), tostring(pr.reached)))
    DP.log("under button (top first):", table.concat(pr.names, " > "))
    if pr.blocker then
        DP.log("BLOCKED by", pr.blocker:GetFullName(), "Active=", tostring(pr.blocker.Active))
    end
    DP.log("connections on button:", n, ev or "none")
end

-- choose the method BEFORE the check, so no check gets burned testing tiers
function DP.pick(btn)
    local pr = probe(btn)
    local n = connCount(btn)
    local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
    local c = {}
    if DP.learned then c[#c + 1] = "replay" end
    if n > 0 and not pr.clear then c[#c + 1] = "direct" end
    if mobile then
        c[#c + 1] = "tap"
        c[#c + 1] = "click"
    else
        c[#c + 1] = "key"
        c[#c + 1] = "click"
    end
    if n > 0 then c[#c + 1] = "direct" end
    for _, m in ipairs(c) do
        if not DP.bad[m] then
            DP.log("pick", m, "| clear=" .. tostring(pr.clear), "conns=" .. n)
            return m
        end
    end
    DP.bad = {}   -- everything failed once: start over
    return c[1]
end

function DP.open(btn)
    DP.checkOpen, DP.btn, DP.pending = true, btn, nil
end

function DP.close()
    DP.checkOpen = false
end

function DP.press(btn)
    local m = DP.method or DP.pick(btn)
    DP.pressing, DP.lastPress = true, m
    task.delay(0.25, function() DP.pressing = false end)
    if m == "replay" then
        local L = DP.learned
        if L.kind == "key" then
            sendKey(L.key)
        else
            local x, y = screenPt(btn, L.x, L.y)
            if L.kind == "tap" then sendTouch(x, y) else sendClick(x, y) end
        end
    elseif m == "direct" then
        local _, ev = connCount(btn)
        if ev then
            if firesignal then
                pcall(firesignal, btn[ev])
            else
                for _, c in ipairs(getconnections(btn[ev])) do pcall(function() c:Fire() end) end
            end
        end
    elseif m == "key" then
        sendKey(DP.KEY)
    else
        local x, y = screenPt(btn, center(btn))
        if m == "tap" then sendTouch(x, y) else sendClick(x, y) end
    end
    DP.log("press via", m)
    return m
end

-- call with the check outcome. script press that landed -> method sticks (no more tier-per-check testing).
-- script press that missed -> that method is marked bad. human press that landed -> replayed next time.
function DP.result(success)
    if DP.lastPress then
        if success then
            DP.method = DP.lastPress
        else
            DP.bad[DP.lastPress] = true
            DP.method = nil
            DP.log("press via", DP.lastPress, "did not land -> next check uses another method")
        end
        DP.lastPress = nil
    elseif success and DP.pending then
        DP.learned, DP.method = DP.pending, "replay"
        DP.log("learned a working human input:", DP.learned.kind)
    end
    DP.pending = nil
end

-- watches your own input during a check; also logs the echo of synthetic input (tells you the inset convention)
UIS.InputBegan:Connect(function(i)
    if DP.pressing then
        if DP.sentX then
            DP.log(("echo %s got=%.0f,%.0f sent=%.0f,%.0f"):format(
                i.UserInputType.Name, i.Position.X, i.Position.Y, DP.sentX, DP.sentY))
            DP.sentX = nil
        end
        return
    end
    if not DP.checkOpen then return end
    local t = i.UserInputType
    if t == Enum.UserInputType.Keyboard then
        if not MOVE[i.KeyCode.Name] then DP.pending = {kind = "key", key = i.KeyCode} end
    elseif (t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1) and DP.btn then
        local p, s = DP.btn.AbsolutePosition, DP.btn.AbsoluteSize
        local x, y = i.Position.X, i.Position.Y        -- InputObject.Position is gui space
        if x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y then
            DP.pending = {kind = (t == Enum.UserInputType.Touch) and "tap" or "click", x = x, y = y}
        end
    end
end)

--[[ WIRE (names in your v8.3 will differ)

 PARRY, when the swing animation is first seen:
     local t0 = os.clock()
     local d = DP.parryDelay(animId)
     if d then
         DP.fireAt(t0, d, function()
             local left = DP.hitFor(animId) - (os.clock() - t0)
             local ok, dist, dot = DP.threat(killerRoot, myRoot, left)
             DP.log(("threat=%s dist=%.1f dot=%.2f"):format(tostring(ok), dist, dot))
             if ok then
                 -- your existing parry remote call here
             end
         end)
     end
 PARRY, when you take damage from the killer (animId = the track that was playing on the killer right then,
 not the last one you saw):
     DP.learnHit(animId, t0, killerRoot, myRoot)

 SKILL CHECK, when the check shows up:
     DP.open(actionBtn)             -- the Controls.action button
     DP.diagnose(actionBtn)         -- once, paste the [DP] lines back
     DP.schedulePress(getRemainingDeg, getDegPerSec, function() DP.press(actionBtn) end)
 SKILL CHECK, on Generator.Result / Healing.Result:
     DP.result(success); DP.close()
]]

return DP
