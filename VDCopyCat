UI.mgrad.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,TH.brand),ColorSequenceKeypoint.new(0.5,TH.brand2),ColorSequenceKeypoint.new(1,TH.brand)})
end)
do
local specs={{"SRV","srv"},{"KLR","klr"},{"ESP","esp"},{"LAG","lag"}}
local chips={}
for i,s in ipairs(specs)do
local b=new("TextButton",{Size=UDim2.fromOffset(46,26),Position=UDim2.fromOffset(8+(i-1)*50,6),BackgroundColor3=Color3.fromRGB(40,36,62),
BackgroundTransparency=0.2,Text=s[1],TextSize=11,Font=BLACK,TextColor3=TH.mute,AutoButtonColor=false,BorderSizePixel=0},UI.mini)
corner(b,8)
b.Activated:Connect(function()
if os.clock()-LASTDRAG<0.25 then return end
K.sysFlip(s[2])
end)
chips[s[2]]=b
end
UI.mfps=label(UI.mini,"-- fps",11,TH.on,MONO,{Position=UDim2.fromOffset(212,0),Size=UDim2.fromOffset(46,38),TextXAlignment=Enum.TextXAlignment.Center})
W.iconBtn(UI.mini,"expand",UDim2.fromOffset(260,5),function()K.setMini(false);K.setOpen(true)end)
reg(function()
local st={}
for _,id in ipairs({"srv","klr","esp","lag"})do local n,_,rdy=K.sysCount(id);st[id]=rdy and n>0 end
for k,b in pairs(chips)do
b.BackgroundColor3=st[k]and TH.on or Color3.fromRGB(40,36,62)
b.BackgroundTransparency=st[k]and 0 or 0.2
b.TextColor3=st[k]and TH.dark or TH.mute
end
UI.mfps.Text=V.sys.fps.." fps";UI.mfps.TextColor3=col(V.sys.fps)
end,true)
UI.mini.InputBegan:Connect(function(i)
if isPtr(i)then
W.startDrag(UI.mini,i,nil,nil,function()
S.mp={x=UI.mini.Position.X.Offset,y=UI.mini.Position.Y.Offset};K.saveSoon()
end)
end
end)
end
function K.setMini(on)
MINI=on
S.mini=on
UI.mini.Visible=on
if on then K.setOpen(false)end
K.saveSoon()
end
UI.hd.InputBegan:Connect(function(i)
if isPtr(i)then
W.startDrag(UI.win,i,nil,nil,function()
S.wp={x=UI.win.Position.X.Offset,y=UI.win.Position.Y.Offset};K.saveSoon()
end)
end
end)
W.iconBtn(UI.hd,"compact",UDim2.new(1,-76,0,11),function()K.setMini(true)end)
W.iconBtn(UI.hd,"min",UDim2.new(1,-40,0,11),function()K.setOpen(false)end)
UI.fab.InputBegan:Connect(function(i)
if isPtr(i)then
W.startDrag(UI.fab,i,
function()
if MINI then K.setMini(false);K.setOpen(true)else K.setOpen(not OPEN)end
end,
function()K.setMini(not MINI);if not MINI then K.setOpen(true)end end,
function()S.fp={x=UI.fab.Position.X.Offset,y=UI.fab.Position.Y.Offset};K.saveSoon()end)
end
end)
track(UIS.InputBegan:Connect(function(i,gp)
if i.UserInputType~=Enum.UserInputType.Keyboard then return end
if BIND.id then
if i.KeyCode==Enum.KeyCode.Escape then
BIND.id=nil
elseif i.KeyCode~=Enum.KeyCode.Unknown then
local id,newK=BIND.id,i.KeyCode.Name
for other,kn in pairs(S.hk)do
if other~=id and kn==newK then S.hk[other]=S.hk[id]end
end
S.hk[id]=newK
BIND.id=nil
K.saveSoon()
toast("Hotkey "..id.." = "..newK,"ok")
end
return
end
if gp then return end
local n=i.KeyCode.Name
if n==S.hk.hub then
if MINI then K.setMini(false);K.setOpen(true)else K.setOpen(not OPEN)end
elseif n==S.hk.lag then
if V.lag.applied then K.lagRestore()else K.lagApply()end
end
end))
reg(function()
local f=V.sys.fps
UI.hfps.Text=f.." fps";UI.hfps.TextColor3=col(f)
local n=0
for _,id in ipairs({"srv","klr","esp","lag"})do local c,_,rdy=K.sysCount(id);if rdy and c>0 then n=n+1 end end
UI.cap.Text="v"..VERSION.." · By Duke · "..n.."/4 aktif"
UI.fabTxt.TextColor3=(OPEN or MINI)and TH.brand or TH.bone
end,true)
applyLayout()
if S.wp then clampTo(UI.win,S.wp.x,S.wp.y)else clampTo(UI.win,(vp().X-WIN.w)/2,24)end
if S.fp then clampTo(UI.fab,S.fp.x,S.fp.y)else clampTo(UI.fab,12,96)end
if S.mp then clampTo(UI.mini,S.mp.x,S.mp.y)else clampTo(UI.mini,64,100)end
if workspace.CurrentCamera then
track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
applyLayout();clampTo(UI.fab,UI.fab.Position.X.Offset,UI.fab.Position.Y.Offset)
clampTo(UI.mini,UI.mini.Position.X.Offset,UI.mini.Position.Y.Offset)
end))
end
UI.ready=true
task.delay(1.5,function()pcall(K.boostStartup)end)
if S.mini then K.setMini(true)end
function K.toggleHub()
if MINI then K.setMini(false);K.setOpen(true)else K.setOpen(not OPEN)end
end
log("Memuat anti-lag dan Distrik Pembantai…")
K.loadMod("lag")
K.loadMod("par")
task.spawn(function()
local tick,warned=0,false
while alive do
task.wait(0.25)
tick=tick+1
for _,fn in ipairs({K.pollPar,K.pollLag})do
local ok,e=pcall(fn)
if not ok and not warned then warned=true;log("Poll: "..tostring(e),"err")end
end
if tick%4==0 then pcall(K.pollSys)end
local calm=K.calm()
if tick%2==0 and S.bst.far and(calm or tick%8==0)then pcall(K.farStep)end
if tick%4==0 then
if S.bst.unlock and not BOOST.probing then
if BOOST.capKey~=S.bst.cap or tick%120==0 then BOOST.capKey=S.bst.cap;pcall(K.setCap)end
end
pcall(K.capWatch)
pcall(K.abTick)
pcall(K.lodTick)
if calm or tick%16==0 then pcall(K.cpGuard)end
end
for _,r in ipairs((OPEN)and REF or REFC)do runR(r)end
if tick%8==0 and DIRTY and S.autosave then K.saveNow()end
end
end)
print("[DP v"..VERSION.."] ESP adaptif + anti-lag + hub UI | "..S.hk.hub.." = buka/tutup")
