function K.pollPar()
    local m = MOD.par
    local api = env.__DPAPI
    if m.state ~= "ready" then
        if m.state ~= "loading" then return end
        if type(api) == "table" and type(api.CFG) == "table" and type(api.Counters) == "table" then
            AP, CFG13 = api, api.CFG
            m.state, m.err = "ready", nil
            K.hookParry()
            log("Distrik Pembantai v" .. tostring(api.Version) .. " terhubung", "ok")
        elseif os.clock() - m.t0 > m.wait then
            m.state = "missing"
        end
        return
    end
    if env.__DPAPI ~= AP then
        m.state, m.err = "missing", "Distrik Pembantai dihentikan atau diganti instance lain"
        return
    end
    local c, net = AP.Counters, AP.Net or {}
    local v = V.par
    v.on = CFG13["parry.enabled"] == true
    local okS, st = pcall(AP.State)
    st = (okS and type(st) == "table") and st or {}
    v.block = st.locked == true
    v.gun, v.tier, v.veil = st.gun, st.tier, st.veil
    v.rtt = (tonumber(net.rtt) or 0) * 1000
    v.parried, v.blocked, v.dodged = c.parry or 0, c.gunHit or 0, c.skill or 0
    v.hit, v.gb, v.shots = c.parryMiss or 0, 0, c.gunShot or 0
    local tot = v.parried + v.hit
    local all = tot + v.shots + v.dodged
    v.rate = tot > 0 and math.floor(v.parried / tot * 100 + 0.5) or 100
    -- v13.5: tanda lagi tarung (hitungan hasil berubah / block nyala) buat mode hemat efek
    if all ~= v.lastAll or v.block then v.lastAct = os.clock() end
    v.lastAll = all
    -- v13.5: perubahan opsi yang cuma lewat Store.touch (preset / reset / hotkey) ikut disimpan
    local stt = AP.Store
    if type(stt) == "table" and stt.dirtyAt then K.saveSoon() end
end

