local rayP = RaycastParams.new()
rayP.FilterType = Enum.RaycastFilterType.Exclude
rayP.IgnoreWater = true

local function pickPart(char)
    return char:FindFirstChild(CFG.gun.aimPart)
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

-- sama kayak TwistoffateEffects.safeOrigin: titik muncul peluru
local function muzzleOrigin()
    local root = myRoot()
    if not root then return nil end
    local a = root.Position + Vector3.new(0, 1.373, 0)
    local b = (root.CFrame * CFrame.new(0.7, 1.373, -2.5)).Position
    local d = b - a
    if d.Magnitude <= 0 then return b end
    rayP.FilterDescendantsInstances = { myChar() }
    local ok, res = pcall(function()
        return workspace:Blockcast(CFrame.new(a, b), Vector3.new(0.5, 0.5, 0.5), d, rayP)
    end)
    if ok and res then return res.Position - d.Unit * 0.5 end
    return b
end

-- survivor lain ditembus peluru (lihat aimPoint/survivorOf di game), jadi ga dianggap penghalang
local function visibleFrom(origin, part)
    local ign = { myChar(), part.Parent }
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and not (p.Team and p.Team.Name:lower():find("killer")) then
            ign[#ign + 1] = p.Character
        end
    end
    rayP.FilterDescendantsInstances = ign
    return workspace:Raycast(origin, part.Position - origin, rayP) == nil
end

local function dirTo(origin, part)
    local pos = part.Position
    if CFG.gun.lead > 0 then
        local v = part.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
        local t = (pos - origin).Magnitude / CFG.gun.bulletSpeed
        pos = pos + v * t * CFG.gun.lead
    end
    local d = pos - origin
    if d.Magnitude < 0.01 then return nil end
    return d.Unit
end

-- dipanggil dari hook pas game ngirim gun.Fire. orig = arah bidikan asli game
local function snapDir(orig)
    local origin = muzzleOrigin()
    if not origin then return nil end

    -- 1) tembakan dari auto-trigger: target udah dipilih, arah dihitung ULANG pas ini (posisi paling baru)
    local p = Gun.pending
    if p and p.Parent and os.clock() - Gun.pendingAt < 0.8 then
        local nd = dirTo(origin, p)
        if nd then
            log("HIT", string.format("kunci ke %s (%.0f stud)", p.Parent.Name, (p.Position - origin).Magnitude))
            return nd
        end
    end

    -- 1b) aim lock aktif: tembakan apapun (manual atau trigger) diarahkan ke badan target kunci
    local lt = Gun.lockTarget
    if CFG.gun.aimLock and lt and lt.Parent then
        local nd = dirTo(origin, lt)
        if nd then
            log("HIT", string.format("lock -> %s (%.0f stud)", lt.Parent.Name, (lt.Position - origin).Magnitude))
            return nd
        end
    end

    -- 2) tembakan manual: belok kalau killer deket arah bidikan
    if not CFG.gun.snap or orig.Magnitude < 0.01 then return nil end
    local o = orig.Unit
    local best, bestAng, bestDist
    for _, k in ipairs(killers()) do
        local part = pickPart(k.char)
        if part then
            local to = part.Position - origin
            local dist = to.Magnitude
            if dist <= CFG.gun.maxDist and dist > 0.5 then
                local ang = math.deg(math.acos(math.clamp(o:Dot(to.Unit), -1, 1)))
                if ang <= CFG.gun.snapFov and (not best or ang < bestAng) then
                    if visibleFrom(origin, part) then best, bestAng, bestDist = part, ang, dist end
                end
            end
        end
    end
    if not best then return nil end
    local nd = dirTo(origin, best)
    if nd then log("HIT", string.format("snap %.1f deg -> %s (%.0f stud)", bestAng, best.Parent.Name, bestDist)) end
    return nd
end

local function onGunFire(args)
    local now = os.clock()
    Gun.fireCount = Gun.fireCount + 1
    Gun.fireSeen = now
    if not Gun.selfFire then   -- simpen format argumen tembakan asli (dipakai tier "remote")
        local t, hi = {}, 0
        for i = 1, 8 do
            if args[i] ~= nil then t[i], hi = args[i], i end
        end
        if hi >= 2 and typeof(t[2]) == "Vector3" then
            if not Gun.template then
                local ty = {}
                for i = 1, hi do ty[i] = typeof(t[i]) end
                log("GUN", "format remote ketangkep: " .. table.concat(ty, ", "))
            end
            Gun.template, Gun.templateN = t, hi
        end
    end
    Gun.chargeStart = now            -- charge mulai ulang dari tembakan (sama kayak game)
    if amSurvivor() and typeof(args[2]) == "Vector3" then
        local nd = snapDir(args[2])
        if nd then args[2] = nd end
    end
    Gun.pending = nil
end

local oldNC
local function hookBody(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" then
        local name = Spy[self]
        if name and alive() then
            local n = select("#", ...)
            local args = { ... }
            inHook = true
            if name == "gun.Fire" then pcall(onGunFire, args) end
            if name == "Generator.Result" or name == "Healing.Result"
                or name == "Generator.Fail" or name == "Healing.Fail" then
                pcall(SkillHook.judged, args, name)
            end
            pcall(logSpy, name, args, n)
            inHook = false
            setnamecallmethod(method)
            return oldNC(self, table.unpack(args, 1, n))
        end
    end
    return oldNC(self, ...)
end

local function installHook()
    if not (hookmetamethod and getnamecallmethod and setnamecallmethod and newcclosure) then
        log("HOOK", "executor ga support hookmetamethod -> snap/kunci arah ga jalan")
        return false
    end
    local ok, err = pcall(function()
        oldNC = hookmetamethod(game, "__namecall", newcclosure(hookBody))
    end)
    if not ok then log("HOOK", "gagal: " .. tostring(err)) end
    return ok
end
Gun.hookOK = installHook()

