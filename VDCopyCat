    l1.Padding = UDim.new(0, 4)
    l1.Parent = row1
    mkBtn(row1, function() return string.format("Zona -2 (%d)", CFG.skill.offset), true end,
        function() CFG.skill.offset = CFG.skill.offset - 2 end, 0.5)
    mkBtn(row1, function() return string.format("Zona +2 (%d)", CFG.skill.offset), true end,
        function() CFG.skill.offset = CFG.skill.offset + 2 end, 0.5)

    local row2 = Instance.new("Frame")
    row2.Size, row2.BackgroundTransparency = UDim2.new(1, 0, 0, 30), 1
    row2.Parent = panel
    local l2 = Instance.new("UIListLayout")
    l2.FillDirection = Enum.FillDirection.Horizontal
    l2.Padding = UDim.new(0, 4)
    l2.Parent = row2
    mkBtn(row2, function() return "Copy Log", true end, function()
        notify(copy(table.concat(LOG, "\n")) and "Log disalin" or "setclipboard ga ada")
    end, 0.5)
