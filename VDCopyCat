        end
        log("DIAG", "handler di tombol: " .. (#rows > 0 and table.concat(rows, " ") or "0 (getconnections kosong / ga support)"))
    end
    for _, root in ipairs(skillRoots(false)) do
        local bts = {}
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("GuiButton") and #bts < 4 then bts[#bts + 1] = d.Name end
        end
        if #bts > 0 then log("DIAG", root.Name .. " punya tombol: " .. table.concat(bts, ",")) end
    end
end

