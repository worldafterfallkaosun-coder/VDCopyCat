local function skillTrackLegacy(evtInfo, gen)
    local t0 = os.clock()
    local stats = {}
    local list, lastList, lastZone = {}, -1, -1
    local needle, zone, prevDiff
    local wide, dumped = false, false

    local ZONE_NAMES = { "great", "perfect", "success", "zone", "target", "area", "good", "safe", "hit" }
    local function pickNeedle(lst, st)
        local best, bestE = nil, 30
        for _, o in ipairs(lst) do
            local s = st[o]
            if s and s.n >= 3 and s.ema > bestE and o.Parent and shown(o) then best, bestE = o, s.ema end
        end
        return best
    end
    local function pickZone(lst, st, nd)
        local best, bestScore, bestArea
        for _, o in ipairs(lst) do
            local s = st[o]
            if s and o ~= nd and s.still >= 8 and o.Parent and shown(o) then
                local score = 0
                if nameHas(o.Name, ZONE_NAMES) then score = 3 end
                if math.abs(angDiff(s.rot, 0)) > 1 then score = score + 1 end
                if o:IsA("UIGradient") then score = score + 0.5 end
                if score >= 1 then
                    local area = 0
                    if o:IsA("GuiObject") then area = o.AbsoluteSize.X * o.AbsoluteSize.Y end
                    if not best or score > bestScore or (score == bestScore and area < bestArea) then
                        best, bestScore, bestArea = o, score, area
                    end
                end
            end
        end
        return best
    end

    while os.clock() - t0 < CFG.skill.maxWait and alive() and CFG.skill.enabled and (not gen or Skill.gen == gen) do
        local dt = RunService.RenderStepped:Wait()
        local now = os.clock()

        if now - lastList > 0.25 then
            lastList = now
            if (not wide) and now - t0 > 1.2 and not needle then
                wide = true
                log("SKILL", "needle ga ketemu di SkillCheckPromptGui -> scan seluruh PlayerGui")
            end
            list = collect(wide)
        end

        for _, o in ipairs(list) do
            if o.Parent then
                local r = absRot(o)
                local s = stats[o]
                if not s then
                    stats[o] = { last = r, rot = r, n = 0, ema = 0, sv = 0, still = 0 }
                else
                    local d = angDiff(r, s.last)
                    local sp = d / math.max(dt, 1e-3)
                    s.last, s.rot, s.n = r, r, s.n + 1
                    s.ema = s.ema * 0.8 + math.abs(sp) * 0.2
                    s.sv = s.sv * 0.6 + sp * 0.4
                    if math.abs(d) < 0.05 then s.still = s.still + 1 else s.still = 0 end
                end
            end
        end

        if not dumped and now - t0 > 0.35 then
            dumped = true
            snapshot("skillcheck start", evtInfo)
        end

        if not needle or not needle.Parent or not stats[needle] or stats[needle].ema < 15 then
            needle = pickNeedle(list, stats)
            zone = nil
        end
        if needle and (not zone or not zone.Parent or now - lastZone > 0.3) then
            lastZone = now
            zone = pickZone(list, stats, needle)
        end

        if needle and zone then
            local ns, zs = stats[needle], stats[zone]
            local pred = ns.rot + ns.sv * CFG.skill.lead
            local diff = angDiff(pred, zs.rot + CFG.skill.offset)
            local tight = math.max(1.2, math.abs(ns.sv) * dt * 0.8)
            local crossed = prevDiff and (prevDiff * diff < 0) and (math.abs(prevDiff) + math.abs(diff) < 30)
            if math.abs(diff) <= tight or crossed then
                Skill.retried = true
                pressLadder()
                log("SKILL", string.format("TEKAN (lama) diff=%.1f needle=%s zone=%s", diff, needle.Name, zone.Name))
                task.delay(0.3, function() snapshot("skillcheck after press") end)
                return
            end
            prevDiff = diff
        else
            prevDiff = nil
        end
    end

    local rows = {}
    for _, o in ipairs(list) do
        local s = stats[o]
        if s and (s.ema > 0 or o:GetFullName():find("SkillCheck", 1, true)) then
            rows[#rows + 1] = string.format("%s [%s] ema=%.0f still=%d rot=%.1f", o:GetFullName(), o.ClassName, s.ema, s.still, s.rot)
        end
    end
    table.sort(rows)
    snapshot("skillcheck GAGAL", "kandidat:\n" .. table.concat(rows, "\n", 1, math.min(#rows, 60)))
    log("SKILL", "needle/zona ga ketemu - tap Copy Dump")
end

