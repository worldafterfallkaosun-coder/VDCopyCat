------------------------------------------------------------------ LOG
local LOG, logLabel = {}, nil
local function log(tag, msg)
    local line = string.format("[%.1f] %s %s", os.clock() % 1000, tag, tostring(msg))
    LOG[#LOG + 1] = line
    if #LOG > 100 then table.remove(LOG, 1) end
    if logLabel then
        logLabel.Text = table.concat(LOG, "\n", math.max(1, #LOG - 8), #LOG)
    end
    print("[DP3] " .. line)
end

local function notify(msg)
    pcall(function()
        StarterGui:SetCore("SendNotification", { Title = "DP v3", Text = msg, Duration = 2.5 })
    end)
    log("INFO", msg)
end

local function copy(txt)
    if setclipboard then
        pcall(setclipboard, txt)
        return true
    end
    return false
end

------------------------------------------------------------------ COMMON
local function myChar() return LP.Character end
local function myHum()
    local c = myChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function myRoot()
    local c = myChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function amSurvivor()
    local t = LP.Team
    if not t then return true end
    return t.Name:lower():find("surviv") ~= nil
end

local function killers()
    local out = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Team and p.Team.Name:lower():find("killer") and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                out[#out + 1] = { player = p, char = p.Character, hum = hum, root = root }
            end
        end
    end
    return out
end

local function angDiff(a, b)
    local d = (a - b) % 360
    if d > 180 then d = d - 360 end
    return d
end

local function nameHas(name, pats)
    name = name:lower()
    for _, p in ipairs(pats) do
        if name:find(p, 1, true) then return true end
    end
    return false
end

------------------------------------------------------------------ INPUT
local function parseBind(raw)
    if raw == "MouseButton1" then return "mouse", 0 end
    if raw == "MouseButton2" then return "mouse", 1 end
    local ok, kc = pcall(function() return Enum.KeyCode[raw] end)
    if ok and kc then return "key", kc end
    return nil
end

local function getBind(attr, default)
    local raw = LP:GetAttribute(attr)
    if type(raw) ~= "string" or raw == "" then raw = default end
    return raw
end

local function viewCenter()
    local cam = workspace.CurrentCamera
    local s = cam and cam.ViewportSize or Vector2.new(800, 600)
    return s.X / 2, s.Y / 2
end

local function fakeInput(kind, v, down)
    local cx, cy = viewCenter()
    local utype, kcode
    if kind == "mouse" then
        utype = (v == 0) and Enum.UserInputType.MouseButton1 or Enum.UserInputType.MouseButton2
        kcode = Enum.KeyCode.Unknown
    else
        utype = Enum.UserInputType.Keyboard
        kcode = v
    end
    return {
        UserInputType  = utype,
        KeyCode        = kcode,
        UserInputState = down and Enum.UserInputState.Begin or Enum.UserInputState.End,
        Position       = Vector3.new(cx, cy, 0),
        Delta          = Vector3.new(0, 0, 0),
    }
end

local function isOurs(f)
    if not isexecutorclosure then return false end
    local ok, r = pcall(isexecutorclosure, f)
    return ok and r == true
end

local function sendInput(raw, down)
    local kind, v = parseBind(raw)
    if not kind then return false end
    local mode = CFG.input
    if mode == "remote" then mode = "signal" end

    if mode == "signal" and getconnections then
        local obj = fakeInput(kind, v, down)
        local okc, conns = pcall(getconnections, down and UIS.InputBegan or UIS.InputEnded)
        if okc and conns then
            local n = 0
            for _, c in ipairs(conns) do
                local okf, f = pcall(function() return c.Function end)
                if okf and type(f) == "function" and not isOurs(f) then
                    task.spawn(pcall, f, obj, false)
                    n = n + 1
                end
            end
            if n > 0 then return true end
        end
    end

    if VIM then
        local cx, cy = viewCenter()
        if kind == "mouse" then
            VIM:SendMouseButtonEvent(cx, cy, v, down, game, 0)
        else
            VIM:SendKeyEvent(down, v, false, game)
        end
        return true
    end
    return false
end

local function click(raw, hold)
    sendInput(raw, true)
    task.wait(hold or 0.04)
    sendInput(raw, false)
end

------------------------------------------------------------------ REMOTE SPY + HOOK
local Spy = {}   -- [RemoteEvent] = nama
local Gun = { fire = nil, aim = nil, hold = nil, busy = false, lockPart = nil, hookOK = false }

local function logSpy(name, args, n)
    local parts = {}
    for i = 1, math.min(n, 6) do parts[#parts + 1] = tostring(args[i]) end
    log("SEND " .. name, table.concat(parts, ", "))
end

local rayP = RaycastParams.new()
rayP.FilterType = Enum.RaycastFilterType.Exclude
rayP.IgnoreWater = true

local function pickPart(char)
    return char:FindFirstChild(CFG.gun.aimPart)
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

-- sama kayak TwistoffateEffects.safeOrigin: titik muncul peluru
local function muzzleOrigin()
    local root = myRoot()
    if not root then return nil end
    local a = root.Position + Vector3.new(0, 1.373, 0)
    local b = (root.CFrame * CFrame.new(0.7, 1.373, -2.5)).Position
    local d = b - a
    if d.Magnitude <= 0 then return b end
    rayP.FilterDescendantsInstances = { myChar() }
    local ok, res = pcall(function()
        return workspace:Blockcast(CFrame.new(a, b), Vector3.new(0.5, 0.5, 0.5), d, rayP)
    end)
    if ok and res then return res.Position - d.Unit * 0.5 end
    return b
end

local function visibleFrom(origin, part)
    rayP.FilterDescendantsInstances = { myChar(), part.Parent }
    return workspace:Raycast(origin, part.Position - origin, rayP) == nil
end

local function dirTo(origin, part)
    local pos = part.Position
    if CFG.gun.lead > 0 then
        local v = part.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
        local t = (pos - origin).Magnitude / CFG.gun.bulletSpeed
        pos = pos + v * t * CFG.gun.lead
    end
    local d = pos - origin
    if d.Magnitude < 0.01 then return nil end
    return d.Unit
end

-- dipanggil dari hook: orig = arah bidikan asli game
local function rewriteDir(orig)
    local origin = muzzleOrigin()
    if not origin or orig.Magnitude < 0.01 then return nil end
    local o = orig.Unit
    local best, bestAng, bestDist
    for _, k in ipairs(killers()) do
        local part = pickPart(k.char)
        if part then
            local to = part.Position - origin
            local dist = to.Magnitude
            if dist <= CFG.gun.maxDist and dist > 0.5 then
                local ang = math.deg(math.acos(math.clamp(o:Dot(to.Unit), -1, 1)))
                if ang <= CFG.gun.fov and (not best or ang < bestAng) then
                    if (not CFG.gun.losHit) or visibleFrom(origin, part) then
                        best, bestAng, bestDist = part, ang, dist
                    end
                end
            end
        end
    end
    if not best then
        log("HIT", "ga ada killer di FOV " .. CFG.gun.fov)
        return nil
    end
    local nd = dirTo(origin, best)
    if nd then
        log("HIT", string.format("belok %.0f deg -> %s (%.0f stud)", bestAng, best.Parent.Name, bestDist))
    end
    return nd
end

local oldNC
local function hookBody(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" and Spy[self] and alive() then
        local name = Spy[self]
        local n = select("#", ...)
        local args = { ... }
        if name == "gun.Fire" and CFG.gun.hit and amSurvivor() and typeof(args[2]) == "Vector3" then
            local ok, nd = pcall(rewriteDir, args[2])
            if ok and nd then args[2] = nd end
        end
        pcall(logSpy, name, args, n)
        setnamecallmethod(method)
        return oldNC(self, table.unpack(args, 1, n))
    end
    return oldNC(self, ...)
end

local function installHook()
    if not (hookmetamethod and getnamecallmethod and setnamecallmethod and newcclosure) then
        log("HOOK", "executor ga support hookmetamethod -> pakai kunci kamera")
        return false
    end
    local ok, err = pcall(function()
        oldNC = hookmetamethod(game, "__namecall", newcclosure(hookBody))
    end)
    if not ok then log("HOOK", "gagal: " .. tostring(err)) end
    return ok
end
Gun.hookOK = installHook()

