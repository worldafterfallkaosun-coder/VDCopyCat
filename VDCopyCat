-- loop efek visual: border berputar, kilau judul, aurora, partikel, scanline, glitch
local FXT = { glitch = os.clock() + 4 }
track(RunService.Heartbeat:Connect(function(dt)
    if not S.fx then return end
    -- v13.5: pas tarung (hasil hit / block baru aja berubah) atau fps < 40, animasi dekorasi dibekukan biar frame time nggak naik
    if S.fxFight and (V.sys.fps < 40 or (V.par.lastAct and os.clock() - V.par.lastAct < 4)) then return end
    -- v13.9: dekorasi cukup 30 Hz (dt dikumpulin biar kecepatan animasi tetap sama)
    FXT.acc = (FXT.acc or 0) + dt
    if FXT.acc < 0.033 then return end
    dt, FXT.acc = FXT.acc, 0
    local now = os.clock()
    local t = now - START
    local s = (math.sin(t * 2.4) + 1) / 2
    UI.fabHalo.BackgroundTransparency = 0.88 - 0.1 * s
    local z = 52 + 6 * s
    UI.fabHalo.Size = UDim2.fromOffset(z, z)
    if MINI then UI.mgrad.Rotation = (t * 40) % 360 end
    if not OPEN then return end
    UI.bgrad.Rotation = (t * 40) % 360
    UI.tgrad.Offset = Vector2.new(((t * 0.35) % 2.4) - 1.2, 0)
    for _, b in ipairs(UI.blobs) do
        b.f.Position = UDim2.new(0.5 + 0.38 * math.sin(t * b.sp + b.ph), 0, 0.5 + 0.4 * math.cos(t * b.sp * 0.8 + b.ph), 0)
    end
    for i, p in ipairs(UI.parts) do
        p.y = p.y - p.v * dt
        if p.y < -0.03 then p.y = 1.03; p.x = math.random() end
        p.f.Position = UDim2.new(p.x + 0.012 * math.sin(t + i), 0, p.y, 0)
    end
    UI.scan.Position = UDim2.new(0, 0, ((t * 0.18) % 1.5) - 0.25, 0)
    if now > FXT.glitch then
        FXT.glitch = now + 5 + math.random() * 5
        UI.doGlitch()
    end
end))

