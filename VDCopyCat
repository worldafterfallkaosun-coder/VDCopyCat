local function refreshOwners()
    Skill.owners = {}
    if not getconnections then return end
    for _, ev in pairs(Skill.events) do
        local ok, conns = pcall(getconnections, ev.OnClientEvent)
        if ok and conns then
            for _, c in ipairs(conns) do
                local okf, f = pcall(function() return c.Function end)
                if okf and type(f) == "function" and not isOurs(f) then
                    local nm = ownerOf(f)
                    if nm and nm ~= "" then Skill.owners[nm] = true end
                end
            end
        end
    end
end

