local function pressSkill()
    local raw = getBind("kb_skillcheck", "Space")
    local list = skillTiers()
    if #list == 0 then log("SKILL", "ga ada cara kirim input (getconnections/VIM ga ada)"); return nil end
    local tier = Skill.tierName
    if not tier or not indexOf(list, tier) then tier = list[1] end
    Skill.pressClock = os.clock()
    local ok, how = sendTier(tier, raw)
    if not ok then
        -- tier ini mati total (0 handler / VIM error): lompat ke tier berikut langsung
        local nxt = list[(indexOf(list, tier) % #list) + 1]
        log("SKILL", string.format("tier %s ga bisa (%s) -> %s", tier, tostring(how), nxt))
        tier = nxt
        Skill.tierName = tier
        ok, how = sendTier(tier, raw)
    end
    log("SKILL", string.format("input via %s (%s)", tier, tostring(how)))
    return tier
end

-- cek tekanan masuk: masuk = ada hasil (Result/Fail) <= 0.3s setelah tekan. Hasil telat = timeout, BUKAN tekanan kita.
-- Kalau ga masuk, tier diganti buat check BERIKUTNYA (retry sekarang percuma, jarum udah lewat).
local function verifyPress(p, tierUsed, myClock)
    task.delay(0.3, function()
        if not alive() or Skill.pressClock ~= myClock then return end
        tierUsed = tierUsed or "?"
        if Skill.lastResult >= myClock and Skill.lastResult - myClock <= 0.3 then
            Skill.tierGood[tierUsed] = true
            Skill.tierName = tierUsed
            return
        end
        if Skill.tierGood[tierUsed] then return end   -- tier ini pernah masuk, mungkin cuma check yang aneh
        Skill.tierBad = Skill.tierBad or {}
        Skill.tierBad[tierUsed] = true
        local list = skillTiers()
        local i = indexOf(list, tierUsed) or 0
        local nxt
        for step = 1, #list do
            local cand = list[((i + step - 1) % #list) + 1]
            if not Skill.tierBad[cand] then nxt = cand break end
        end
        if not nxt then Skill.tierBad = {}; nxt = list[(i % #list) + 1] end
        Skill.tierName = nxt
        log("SKILL", "tekanan ga masuk (" .. tierUsed .. ") -> check berikutnya pakai " .. tostring(nxt))
    end)
end

