        end
    end
    Gun.chargeStart = now
    if amSurvivor() and typeof(args[2]) == "Vector3" then
        local nd = snapDir(args[2], args[1])
        if nd then args[2] = nd end
    end
    Gun.pending = nil
end

local oldNC
local function hookBody(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" then
        local name = Spy[self]
        if name and alive() then
            local n = select("#", ...)
            local args = { ... }
            inHook = true
            if name == "gun.Fire" then pcall(onGunFire, args) end
            if name == "Generator.Result" or name == "Healing.Result"
                or name == "Generator.Fail" or name == "Healing.Fail" then
                pcall(SkillHook.judged, args, name)
            end
            pcall(logSpy, name, args, n)
            inHook = false
            setnamecallmethod(method)
            return oldNC(self, table.unpack(args, 1, n))
        end
    end
    return oldNC(self, ...)
end

local function installHook()
    if ENV.DP3_NOHOOK then
        log("HOOK", "DP3_NOHOOK aktif -> hook dimatikan (mode tes)")
        return false
    end
    if not (hookmetamethod and getnamecallmethod and setnamecallmethod and newcclosure) then
        log("HOOK", "executor ga support hookmetamethod -> snap/kunci arah ga jalan")
        return false
    end
    local D = ENV.DP3_HOOKD
    if type(D) == "table" and D.oldNC then
        oldNC = D.oldNC
        D.fn = hookBody
        log("HOOK", "dispatcher lama dipakai ulang (reload)")
        return true
    end
    local ok, err = pcall(function()
        local D2 = { fn = hookBody }
        ENV.DP3_HOOKD = D2
        D2.oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local f = D2.fn
            if f then return f(self, ...) end
            return D2.oldNC(self, ...)
        end))
        oldNC = D2.oldNC
    end)
    if not ok then
        ENV.DP3_HOOKD = nil
        log("HOOK", "gagal: " .. tostring(err))
    end
    return ok
end
