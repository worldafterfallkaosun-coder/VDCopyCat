-- true = ditangani (ditekan / selesai / ga muncul, trace ditulis ke log), false = GUI skill check ga ada -> metode lama
local function skillTrackNamed(evtInfo, gen)
    local P = skillPairs()
    if #P == 0 then return false end

    local t0 = os.clock()
    local trace, lastTr = {}, -1
    local function tr(s)
        if #trace < 40 then trace[#trace + 1] = string.format("%.2f %s", os.clock() - t0, s) end
    end
    local act, samples, prevA, moved = nil, {}, nil, false

    while os.clock() - t0 < 3.5 and alive() and CFG.skill.enabled and Skill.gen == gen do
        local dtf = RunService.RenderStepped:Wait()
        local now = os.clock()

        local cur
        for _, p in ipairs(P) do
            if p.chk.Parent and p.chk.Visible and p.gui.Enabled ~= false then cur = p break end
        end

        if now - lastTr >= 0.12 then
            lastTr = now
            local p = cur or P[1]
            tr(string.format("%s vis=%s L=%.0f G=%.0f", p.gui.Name == "SkillCheckPromptGui" and "kb" or "pad",
                tostring(cur ~= nil), p.line.AbsoluteRotation, p.goal.AbsoluteRotation))
        end

        if cur then
            if cur ~= act then
                act, samples, prevA = cur, {}, nil
                Skill.cur = { line = cur.line, goal = cur.goal, w = 0 }
                log("SKILL", string.format("check muncul %.2fs setelah event (tune=%.0fms)", now - t0, Skill.tune * 1000))
            end
            local a = act.line.AbsoluteRotation
            if prevA then a = prevA + angDiff(a, prevA) end         -- sudut kontinu (anti wrap 360)
            prevA = a
            samples[#samples + 1] = { now, a }
            if #samples > 6 then table.remove(samples, 1) end

            -- kecepatan jarum: 2 sample terakhir; kalau baru 1 sample pakai kecepatan check sebelumnya
            local w
            if #samples >= 2 then
                local f, l = samples[1], samples[#samples]
                w = (l[2] - f[2]) / math.max(l[1] - f[1], 1e-3)
                if #samples >= 4 and math.abs(w) > 20 then Skill.w0 = w end
            else
                w = Skill.w0
            end

            if w and math.abs(w) > 20 then
                moved = true
                Skill.cur.w = w
                local zone = act.goal.AbsoluteRotation + CFG.skill.offset
                local dir = (w >= 0) and 1 or -1
                local rem = ((zone - a) * dir) % 360                -- sisa sudut ke tengah zona, searah jarum
                local frame = math.max(dtf, 1 / 120)
                if rem > 360 - math.abs(w) * frame * 0.5 then rem = 0 end
                local T = rem / math.abs(w)
                if T <= Skill.tune + frame * 0.5 then
                    pressSkill()
                    log("SKILL", string.format("TEKAN sisa=%.1f deg (%.0f ms) kecepatan=%.0f deg/s fps~%.0f sample=%d",
                        rem, T * 1000, w, 1 / frame, #samples))
                    return true
                end
            end
        elseif act then
            break      -- tadinya tampil, sekarang ketutup: check selesai
        end
    end

    local why
    if not act then why = "check ga pernah tampil dalam 3.5s"
    elseif not moved then why = "check tampil tapi jarum ga kebaca gerak"
    else why = "jarum kebaca tapi ga ketekan (kelewat / check selesai duluan)" end
    log("SKILL", why)
    log("SKILL", "TRACE " .. table.concat(trace, " | "))
    return true
end

-- dipanggil dari hook pas game ngirim hasil skill check: ukur seberapa meleset, lalu tune
SkillHook.judged = function(args)
    local c = Skill.cur
    if not c or not c.line.Parent then return end
    local since = os.clock() - Skill.pressClock
    local w = c.w or 0
    local dir = (w >= 0) and 1 or -1
    local err = angDiff(c.line.AbsoluteRotation, c.goal.AbsoluteRotation + CFG.skill.offset) * dir
    local errT = (math.abs(w) > 1) and (err / math.abs(w)) or 0
    local mine = since >= 0 and since < 0.8
    log("SKILL", string.format("HASIL %s %s | err=%+.1f deg (%+.0f ms %s) | tekan->hasil %.0f ms | %s",
        tostring(args[1]), tostring(args[2]), err, errT * 1000, errT > 0 and "telat" or "kecepatan",
        since * 1000, mine and "tekanan skrip" or "BUKAN dari tekanan skrip"))
    if mine and CFG.skill.learn and math.abs(errT) < 0.3 then
        Skill.tune = math.clamp(Skill.tune + 0.6 * errT, 0, 0.4)
    end
    Skill.cur = nil
end

local function skillTrack(evtInfo, gen)
    local ok, handled = pcall(skillTrackNamed, evtInfo, gen)
    if not ok then log("SKILL", "named error: " .. tostring(handled)) end
    if ok and handled then return end
    if Skill.gen ~= gen then return end   -- udah ada event baru
    log("SKILL", "Line/Goal ga ketemu -> metode lama")
    skillTrackLegacy(evtInfo, gen)
end

local function runSkillCheck(info)
    if not CFG.skill.enabled then return end
    Skill.gen = Skill.gen + 1          -- event baru selalu menang: tracker lama berhenti sendiri
    local gen = Skill.gen
    Skill.active = true
    task.spawn(function()
        local ok, err = pcall(skillTrack, info, gen)
        if not ok then log("SKILL", "error: " .. tostring(err)) end
        if Skill.gen == gen then Skill.active = false end
    end)
end

