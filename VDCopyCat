        ---------------------------------------------------------------- MATEMATIKA MURNI (angka doang, diuji di luar Roblox)
        -- MATH-BEGIN
        -- Arah lempar balistik (busur rendah). dx,dy,dz = selisih origin -> titik tujuan. S = kecepatan, g = gravitasi (stud/s^2, positif = turun).
        -- return ux, uy, uz (arah satuan), t (waktu terbang), reach (false = ga kejangkau, dikasih sudut jangkauan maksimum)
        local function ballistic(dx, dy, dz, S, g)
            local R2 = dx * dx + dz * dz
            local R = math.sqrt(R2)
            local D = math.sqrt(R2 + dy * dy)
            if D < 1e-4 then return 0, 1, 0, 0, true end
            if g <= 0.01 then
                return dx / D, dy / D, dz / D, D / S, true
            end
            if R < 1e-3 then
                return 0, (dy >= 0) and 1 or -1, 0, D / S, true
            end
            local S2 = S * S
            local disc = S2 * S2 - g * (g * R2 + 2 * dy * S2)
            local reach = true
            local tanT
            if disc < 0 then
                reach = false
                tanT = S2 / (g * R)
            else
                tanT = (S2 - math.sqrt(disc)) / (g * R)
            end
            local cosT = 1 / math.sqrt(1 + tanT * tanT)
            local sinT = tanT * cosT
            return dx / R * cosT, sinT, dz / R * cosT, R / (S * cosT), reach
        end

        local function det3(a, b, c, d, e, f, g, h, i)
            return a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
        end

        -- y(t) = c0 + c1 t + c2 t^2  (kuadrat terkecil). return c0, c1 (kecepatan awal), 2*c2 (percepatan)
        local function fitQuad(ts, ys, n)
            local s1, s2, s3, s4, y0, y1, y2 = 0, 0, 0, 0, 0, 0, 0
            for i = 1, n do
                local t, y = ts[i], ys[i]
                local t2 = t * t
                s1, s2, s3, s4 = s1 + t, s2 + t2, s3 + t2 * t, s4 + t2 * t2
                y0, y1, y2 = y0 + y, y1 + y * t, y2 + y * t2
            end
            local D = det3(n, s1, s2, s1, s2, s3, s2, s3, s4)
            if math.abs(D) < 1e-12 then return nil end
            local c0 = det3(y0, s1, s2, y1, s2, s3, y2, s3, s4) / D
            local c1 = det3(n, y0, s2, s1, y1, s3, s2, y2, s4) / D
            local c2 = det3(n, s1, y0, s1, s2, y1, s2, s3, y2) / D
            return c0, c1, 2 * c2
        end

        -- x(t) = c0 + c1 t. return c0, c1
        local function fitLin(ts, xs, n)
            local s1, s2, x0, x1 = 0, 0, 0, 0
            for i = 1, n do
                local t, x = ts[i], xs[i]
                s1, s2, x0, x1 = s1 + t, s2 + t * t, x0 + x, x1 + x * t
            end
            local D = n * s2 - s1 * s1
            if math.abs(D) < 1e-12 then return nil end
            return (x0 * s2 - s1 * x1) / D, (n * x1 - s1 * x0) / D
        end
        -- MATH-END
        V.ballistic, V.fitQuad, V.fitLin = ballistic, fitQuad, fitLin

        ---------------------------------------------------------------- IDENTITAS + DAFTAR SURVIVOR
        local function amKiller() return teamKind(LP.Team) == "killer" end

        local function holderIsVeil(h)
            if not h then return false end
            for _, key in ipairs({ "KillerName", "MorphedKiller", "SelectedKiller" }) do
                local v = h:GetAttribute(key)
                if type(v) == "string" and v:lower() == "veil" then return true end
            end
            return false
        end

        local roleAt, roleVeil = -1, false
        local function amVeil()
            local now = os.clock()
            if now - roleAt < 0.4 then return roleVeil end
            roleAt = now
            local r = false
            if C.forceVeil then r = true
            elseif amKiller() then r = holderIsVeil(myChar()) or holderIsVeil(LP) end
            if r ~= roleVeil then
                roleVeil = r
                if r then notify("Veil terdeteksi. Panel DP > Veil Panel") else log("VEIL", "bukan Veil lagi") end
            end
            return r
        end

        local SL = { t = -1, list = {} }
        local function survivors()
            local now = os.clock()
            if now - SL.t < 0.008 then return SL.list end
            local out = {}
            for _, p in ipairs(Players:GetPlayers()) do
                local ch = p.Character
                if p ~= LP and ch and teamKind(p.Team) == "survivor" then
                    local hum = ch:FindFirstChildOfClass("Humanoid")
                    local root = ch:FindFirstChild("HumanoidRootPart")
                    if hum and root and hum.Health > 0 then
                        out[#out + 1] = { player = p, char = ch, hum = hum, root = root }
                    end
                end
            end
            SL.t, SL.list = now, out
            return out
        end

        -- kecepatan survivor dihitung sendiri dari perpindahan posisi (EMA), sama kayak Track killer di v10.1
        local VT = {}
        keep(RunService.Heartbeat:Connect(function()
            if not alive() then return end
            if not (C.enabled and (amKiller() or C.forceVeil)) then return end
            local now = os.clock()
            for _, k in ipairs(survivors()) do
                local pos = k.root.Position
                local tr = VT[k.char]
                if not tr then
                    VT[k.char] = { pos = pos, t = now, vel = ZERO, grounded = true }
                else
                    local dt = now - tr.t
                    if dt > 0.003 then
                        if dt > 0.4 or (pos - tr.pos).Magnitude > 40 then
                            tr.vel = ZERO
                        else
                            tr.vel = tr.vel:Lerp((pos - tr.pos) / dt, 1 - math.exp(-dt / 0.06))
                        end
                        tr.pos, tr.t = pos, now
                        tr.grounded = k.hum.FloorMaterial ~= Enum.Material.Air
                        local h = tr.hist
                        if not h then
                            h = {}
                            tr.hist = h
                        end
                        h[#h + 1] = { t = now, v = tr.vel }
                        while #h > 0 and now - h[1].t > 0.4 do table.remove(h, 1) end
                    end
                end
            end
            for ch in pairs(VT) do
                if not ch.Parent then VT[ch] = nil end
            end
        end))

        function V.steady(char)   -- lurus = arah + kecepatan stabil ~0.4s terakhir
            local tr = VT[char]
            if not tr or not tr.hist or #tr.hist < 4 then return true end
            local old, cur = tr.hist[1].v, tr.vel
            local a, b = Vector3.new(old.X, 0, old.Z), Vector3.new(cur.X, 0, cur.Z)
            local sa, sb = a.Magnitude, b.Magnitude
            if sa < 2 and sb < 2 then return true end
            if math.abs(sa - sb) > CFG.gun.steadyAcc * math.max(sa, sb, 6) then return false end
            if sa < 2 or sb < 2 then return false end
            return math.deg(math.acos(math.clamp(a.Unit:Dot(b.Unit), -1, 1))) <= CFG.gun.steadyAng
        end

        ---------------------------------------------------------------- PREDIKSI (lead ping + waktu terbang + busur gravitasi)
        function V.speed() return V.calibSpeed or V.seedSpeed or C.speed end
        function V.grav()
            if V.calibG ~= nil then return V.calibG end
            if V.seedG ~= nil then return V.seedG end
            return C.gravity
        end
        function V.cdTotal() return V.cdLearn or C.cooldown end
        function V.cdLeft(now) return math.max(0, V.cdUntil - (now or os.clock())) end

        -- waktu tambahan di luar waktu terbang: posisi survivor di server sudah maju dari yang kamu lihat (ping + interpolasi),
        -- ditambah jeda animasi lempar (ThrowStartDelay) kalau kebaca dari SpearMath. leadAdj = koreksi hasil belajar.
        local function leadTime()
            if not C.assist then return 0 end
            local t = 0
            if C.leadPing > 0 then t = Net.rtt * C.leadPing + C.leadBase + V.leadAdj end
            if C.useThrowDelay and V.math.throwDelay then t = t + V.math.throwDelay end
            return math.clamp(t, 0, C.leadMax)
        end
        V.leadTime = leadTime

        -- return titik bidik masa depan (T), arah lempar dari origin (satuan), waktu terbang, kejangkau?
        function V.solve(origin, k, point)
            local tr = VT[k.char]
            local S, g = V.speed(), V.grav()
            local v, airborne = ZERO, false
            if C.assist and tr then
                v = tr.vel
                if tr.grounded then v = Vector3.new(v.X, 0, v.Z) else airborne = true end
                if v.Magnitude > 60 then v = v.Unit * 60 end
                if C.steady and not V.steady(k.char) then v = v * C.unsteadyScale end
            end
            local L = leadTime()
            local t = (point - origin).Magnitude / S
            local fut, ux, uy, uz, reach = point, 0, 1, 0, true
            local wsG = Workspace.Gravity
            for _ = 1, 4 do
                local ahead = L + t
                fut = point + v * ahead
                if airborne then   -- lagi lompat / jatuh: sumbu vertikal ikut gravitasi dunia (dibatasi 0.45s biar ga nembus tanah)
                    local av = math.min(ahead, 0.45)
                    fut = Vector3.new(fut.X, point.Y + v.Y * av - 0.5 * wsG * av * av, fut.Z)
                end
                fut = fut + Vector3.new(0, V.vBias, 0)
                local d = fut - origin
                local t2
                ux, uy, uz, t2, reach = ballistic(d.X, d.Y, d.Z, S, g)
                t = t2
            end
            return fut, Vector3.new(ux, uy, uz), t, reach
        end

        -- titik spear muncul. SpawnOffset (kalau kebaca): Vector3 = relatif ke HumanoidRootPart, angka = maju sekian stud
        local function spawnOrigin()
            local root = myRoot()
            if not root then return nil end
            local off = V.math.spawnOffset
            if typeof(off) == "Vector3" then return (root.CFrame * CFrame.new(off)).Position end
            local p = root.Position + Vector3.new(0, 1.4, 0)
            if type(off) == "number" then p = p + root.CFrame.LookVector * off end
            return p
        end

        ---------------------------------------------------------------- CEK HALANGAN
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.IgnoreWater = true
        local LOSC = setmetatable({}, { __mode = "k" })   -- [karakter] = { [tag] = {t, v} }

        local function losRaw(origin, point, ch)
            local ign = {}
            local mc = myChar()
            if mc then ign[#ign + 1] = mc end
            ign[#ign + 1] = ch
            for _, s in ipairs(survivors()) do ign[#ign + 1] = s.char end   -- kena survivor lain tetap kena, bukan halangan
            local o, dir = origin, point - origin
            local left = dir.Magnitude
            if left < 0.5 then return true end
            for _ = 1, 6 do
                rp.FilterDescendantsInstances = ign
                local res = Workspace:Raycast(o, dir, rp)
                if not res then return true end
                local inst = res.Instance
                if inst.CanCollide and inst.Transparency < 0.95 then return false end   -- part tembus (CanCollide off / transparan) dilewatin
                ign[#ign + 1] = inst
                local adv = (res.Distance or 0) + 0.05
                left = left - adv
                if left <= 0.3 then return true end
                local u = dir.Unit
                o = o + u * adv
                dir = u * left
            end
            return false
        end

        local function los(origin, point, ch, tag)
            if not C.needLOS then return true end
            local now = os.clock()
            local c = LOSC[ch]
            if not c then
                c = {}
                LOSC[ch] = c
            end
            local e = c[tag]
            if e and now - e.t < 0.06 then return e.v end
            local v = losRaw(origin, point, ch)
            c[tag] = { t = now, v = v }
            return v
        end

        ---------------------------------------------------------------- PILIH TARGET
        -- return offset titik bidik dari HumanoidRootPart + nama bagian
        local function chooseAim(k, origin)
            local root = k.root
            local head = k.char:FindFirstChild("Head")
            local bodyOff = Vector3.new(0, 0.3, 0)
            if C.part == "body" or not head then return bodyOff, "BODY" end
            local headOff = head.Position - root.Position
            if C.part == "head" then return headOff, "HEAD" end
            -- auto: kepala kalau kelihatan; musuh jauh + lari kenceng = badan (lebih gede, lebih gampang kena)
            local tr = VT[k.char]
            local spd = tr and Vector3.new(tr.vel.X, 0, tr.vel.Z).Magnitude or 0
            if (root.Position - origin).Magnitude > 90 and spd > 12 then return bodyOff, "BODY" end
            if los(origin, head.Position, k.char, "HEAD") then return headOff, "HEAD" end
            return bodyOff, "BODY"
        end

        local function pickTarget(origin, cam)
            local camCF = cam.CFrame
            local look = camCF.LookVector
            local cur = V.targetChar
            local best
            for _, k in ipairs(survivors()) do
                local ch = k.char
                local skip = C.skipHooked and (ch:GetAttribute("IsHooked") or ch:GetAttribute("IsCarried"))
                local dist = (k.root.Position - origin).Magnitude
                if not skip and dist <= C.maxDist and dist > 1 then
                    local off, kindName = chooseAim(k, origin)
                    local point = k.root.Position + off
                    local T, dir, flight, reach = V.solve(origin, k, point)
                    local P = origin + dir * (T - origin).Magnitude
                    local to = P - camCF.Position
                    if to.Magnitude > 0.1 then
                        local ang = math.deg(math.acos(math.clamp(look:Dot(to.Unit), -1, 1)))
                        local isCur = (ch == cur)
                        if ang <= C.fov * (isCur and 1.4 or 1) and los(origin, point, ch, kindName) then
                            local score
                            if C.priority == "near" then score = dist - (isCur and 10 or 0)
                            elseif C.priority == "lowhp" then
                                score = ang + (k.hum.Health / math.max(k.hum.MaxHealth, 1)) * 25 - (isCur and C.stickBonus or 0)
                            else score = ang - (isCur and C.stickBonus or 0) end
                            if ch:GetAttribute("Trapped") then score = score - 6 end   -- survivor kena trap = bebek diam
                            if not best or score < best.score then
                                best = { k = k, off = off, kind = kindName, T = T, dir = dir, flight = flight, reach = reach,
                                         P = P, ang = ang, dist = dist, score = score }
                            end
                        end
                    end
                end
            end
            return best
        end

        ---------------------------------------------------------------- OVERLAY GAMBAR (adornment di gethui/CoreGui, ga nyentuh objek game)
        local AD = { folder = nil, pool = {}, trail = {}, arc = {} }
        do
            local old = ENV.DP3_VEILFOLDER   -- sisa instance sebelumnya (reload)
            if old then pcall(function() old:Destroy() end) end
        end
        local function guiParent()
            local parent
            pcall(function() parent = (gethui and gethui()) or game:GetService("CoreGui") end)
            return parent or LP:FindFirstChildOfClass("PlayerGui")
        end
        local function adFolder()
            if AD.folder and AD.folder.Parent then return AD.folder end
            local parent = guiParent()
            if not parent then return nil end
            local f = Instance.new("Folder")
            f.Name = "DP3_VEIL"
            f.Parent = parent
            AD.folder, AD.pool, AD.trail, AD.arc = f, {}, {}, {}   -- adornment lama ikut kebuang bareng foldernya
            ENV.DP3_VEILFOLDER = f
            return f
        end
        local function acquireBox()
            local bx = table.remove(AD.pool)
            if bx and bx.Parent then return bx end
            local f = adFolder()
            if not f then return nil end
            bx = Instance.new("BoxHandleAdornment")
            bx.ZIndex = 1
            bx.AlwaysOnTop = true
            bx.Parent = f
            return bx
        end
        local function releaseBox(bx)
            bx.Visible = false
            AD.pool[#AD.pool + 1] = bx
        end

        local MINE_COL, OTHER_COL = Color3.fromRGB(120, 200, 255), Color3.fromRGB(255, 120, 120)
        local function addSeg(a, b, col)
            local len = (b - a).Magnitude
            if len < 0.05 then return end
            if not adFolder() then return end
            if #AD.trail >= 180 then
                local o = table.remove(AD.trail, 1)
                releaseBox(o.bx)
            end
            local bx = acquireBox()
            if not bx then return end
            bx.Color3 = col
            bx.Size = Vector3.new(0.14, 0.14, len)
            AD.trail[#AD.trail + 1] = { bx = bx, cf = CFrame.lookAt((a + b) / 2, b), born = os.clock() }
        end

        local function drawTrails(me, now)
            for i = #AD.trail, 1, -1 do
                local e = AD.trail[i]
                local age = now - e.born
                if age > C.trail then
                    releaseBox(e.bx)
                    table.remove(AD.trail, i)
                elseif me then
                    if e.bx.Adornee ~= me then e.bx.Adornee = me end
                    e.bx.CFrame = me.CFrame:ToObjectSpace(e.cf)
                    e.bx.Transparency = 0.2 + 0.8 * (age / C.trail)
                    e.bx.Visible = true
                else
                    e.bx.Visible = false
                end
            end
        end

        local ARC_N = 14
        local function hideArc()
            for _, bx in ipairs(AD.arc) do bx.Visible = false end
        end
        -- busur lempar yang diprediksi: dari titik spawn sampai titik target (garis lurus kalau gravitasi 0)
        local function drawArc(me, origin, dir, S, g, flight, col)
            if not (C.arc and me and origin and flight and flight > 0) then
                hideArc()
                return
            end
            if not adFolder() then return end
            local arc = AD.arc
            while #arc < ARC_N do
                local bx = acquireBox()
                if not bx then return end
                arc[#arc + 1] = bx
            end
            local v0 = dir * S
            local prev = origin
            for i = 1, ARC_N do
                local t = flight * i / ARC_N
                local p = origin + v0 * t + Vector3.new(0, -0.5 * g * t * t, 0)
                local bx = arc[i]
                local len = (p - prev).Magnitude
                if len > 0.05 then
                    if bx.Adornee ~= me then bx.Adornee = me end
                    bx.Size = Vector3.new(0.1, 0.1, len)
                    bx.CFrame = me.CFrame:ToObjectSpace(CFrame.lookAt((prev + p) / 2, p))
                    bx.Color3 = col
                    bx.Transparency = 0.45
                    bx.Visible = true
                else
                    bx.Visible = false
                end
                prev = p
            end
        end

