-- ---------- auto boost: naikkan tahap optimasi sampai FPS mencapai target ----------
local AB = { stage = 0, low = 0, cool = 0, needApply = false }
local AB_STAGES = {
    { "Ringan", function()
        K.boostSet("quality", true, true); K.boostSet("unlock", true, true); K.lagPresetQuiet("SAFE")
    end },
    { "Sedang", function()
        K.lagPresetQuiet("BALANCED"); K.boostSet("light", true, true)
        S.bst.dist = 140; K.boostSet("far", true, true)
    end },
    { "Berat", function()
        K.lagPresetQuiet("MAX"); S.bst.dist = 90; K.boostSet("sweep", true, true)
    end },
    { "Ekstrem", function()
        K.boostSet("mute", true, true); K.lagSlSet("Render Distance", 64, 1024, 64, 192, true)
    end },
}
function K.abStage() return AB.stage end
function K.abName() return AB.stage > 0 and AB_STAGES[AB.stage][1] or "-" end
function K.abTick()
    if S.ab.mode == 0 then return end
    if AB.needApply and MOD.lag.state == "ready" and not V.lag.running then
        AB.needApply = false
        K.lagApply()
    end
    local st = K.fpsStats()
    if not st then return end
    local maxStage = (S.ab.mode == 1) and 2 or 4
    AB.low = (st.avg < S.ab.target * 0.85) and (AB.low + 1) or 0
    local now = os.clock()
    if AB.low >= 8 and now >= AB.cool and AB.stage < maxStage then
        AB.stage, AB.cool, AB.low = AB.stage + 1, now + 14, 0
        AB_STAGES[AB.stage][2]()
        AB.needApply = true
        say("warn", "Auto boost naik: tahap " .. AB.stage .. " (" .. AB_STAGES[AB.stage][1] .. ")")
    end
end
function K.abReset()
    AB.stage, AB.low, AB.needApply = 0, 0, false
    K.boostNone()
    K.lagRestore()
end

