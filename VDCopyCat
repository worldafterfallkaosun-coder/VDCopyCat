    light = "Pencahayaan Compatibility", mute = "Audio dibisukan", far = "Sembunyikan pemain jauh", sweep = "Sapu efek lanjutan", protect = "Lindungi tampilan pemain" }

function K.boostGet(k)
    if k == "render3d" then return BOOST.render3d == true end
    return S.bst[k] == true
end
function K.boostSet(k, on, quiet)
    local fx = BOOST_FX[k]
    if not fx then return false end
    if K.boostGet(k) == on then return true end
    local ok, why = fx[on and "on" or "off"]()
    if not ok then
        if not quiet then toast(tostring(why or "Gagal menerapkan opsi ini di executor ini"), "warn") end
        return false
    end
    if k == "render3d" then BOOST.render3d = on else S.bst[k] = on; K.saveSoon() end
    if not quiet then log(BOOST_LABEL[k] .. (on and " aktif" or " dimatikan"), on and "ok" or "info") end
    return true
end
function K.boostFlip(k) K.boostSet(k, not K.boostGet(k)) end

-- sembunyikan pemain jauh: hanya tampilan (LocalTransparencyModifier), animasi dan posisi tetap jalan
function K.setLTM(part, v) part.LocalTransparencyModifier = v end
function K.farStep()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local cp, D = cam.CFrame.Position, S.bst.dist
    local refreshed = false -- v13.9: maksimal satu pemain per panggilan yang di-scan ulang (dulu semua serentak = spike)
    for _, pl in ipairs(Players:GetPlayers()) do
        local ch = pl ~= LP and pl.Character
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        if root then
            local far = (root.Position - cp).Magnitude > D
            local st = BOOST.far[ch]
            if not st then st = { parts = {}, hidden = false, t = 0 }; BOOST.far[ch] = st end
            if not refreshed and os.clock() - st.t > 6 then
                refreshed = true
                st.t, st.parts = os.clock(), {}
                for _, d in ipairs(ch:GetDescendants()) do
                    if d:IsA("BasePart") then st.parts[#st.parts + 1] = d end
                end
                if st.hidden then far = true; st.hidden = false end
            end
            if far ~= st.hidden then
                st.hidden = far
                local v = far and 1 or 0
                local ps = st.parts
                for i = 1, #ps do pcall(K.setLTM, ps[i], v) end
            end
        end
    end
end
function K.farRestore()
    for _, st in pairs(BOOST.far) do
        if st.hidden then
            for _, part in ipairs(st.parts) do pcall(function() part.LocalTransparencyModifier = 0 end) end
            st.hidden = false
        end
    end
end

function K.boostAll()
    local n = 0
    for _, k in ipairs({ "unlock", "quality", "light", "far", "sweep" }) do
