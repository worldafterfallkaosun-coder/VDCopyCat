local TOAST_KIND = { ok = "on", warn = "amb", err = "err" }
local function toast(msg, kind)
    if not UI.toasts then return end
    local col = TH[TOAST_KIND[kind or ""] or "mute"]
    local f = new("Frame", { Size = UDim2.fromOffset(0, 32), AutomaticSize = AUTO_XY, BackgroundColor3 = TH.toast,
        BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = nextLO() }, UI.toasts)
    corner(f, 10)
    local st = stroke(f, col, 1, 1)
    padd(f, 6, 12, 8, 16)
    local bar = new("Frame", { Size = UDim2.new(0, 3, 1, 0), Position = UDim2.new(0, -10, 0, 0), BackgroundColor3 = col,
        BackgroundTransparency = 1, BorderSizePixel = 0 }, f)
    corner(bar, 2)
    local tl = label(f, tostring(msg), 12, TH.bone, FB, { Size = UDim2.fromOffset(0, 20), AutomaticSize = AUTO_XY,
        TextWrapped = true, TextTransparency = 1 })
    new("UISizeConstraint", { MaxSize = Vector2.new(300, 120) }, tl)
    local prog = new("Frame", { Size = UDim2.new(1, 0, 0, 2), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 6),
        BackgroundColor3 = col, BackgroundTransparency = 0.2, BorderSizePixel = 0 }, f)
    TweenService:Create(prog, TweenInfo.new(2.8, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()
    tw(f, 0.18, { BackgroundTransparency = 0.04 }); tw(st, 0.18, { Transparency = 0.45 })
    tw(bar, 0.18, { BackgroundTransparency = 0 }); tw(tl, 0.18, { TextTransparency = 0 })
    local list = {}
    for _, c in ipairs(UI.toasts:GetChildren()) do if c:IsA("Frame") then list[#list + 1] = c end end
    if #list > 3 then list[1]:Destroy() end
    task.delay(2.8, function()
        if not f.Parent then return end
        tw(f, 0.2, { BackgroundTransparency = 1 }); tw(st, 0.2, { Transparency = 1 })
        tw(bar, 0.2, { BackgroundTransparency = 1 }); tw(tl, 0.2, { TextTransparency = 1 }); tw(prog, 0.2, { BackgroundTransparency = 1 })
        task.delay(0.25, function() if f.Parent then f:Destroy() end end)
    end)
end
