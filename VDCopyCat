            parts[#parts + 1] = mark .. (o:GetFullName():match("[^%.]+%.[^%.]+$") or o.Name)
        end
        log("DIAG", "di atas tombol (atas>bawah, * = tombol, ! = Active/penghalang): " .. table.concat(parts, " > "))
    end
    if getconnections then
        local rows, objs = {}, { act }
        for _, d in ipairs(act:GetDescendants()) do
            if d:IsA("GuiObject") and #objs < 7 then objs[#objs + 1] = d end
        end
        for _, o in ipairs(objs) do
