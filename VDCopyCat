                local s = seatCache[node]
                if s == nil then
                    s = node:FindFirstChildWhichIsA("BaseSeat") ~= nil
                    seatCache[node] = s
                end
                seat = s
            end
            depth += 1
        end
        node = node.Parent
    end
    return seat and "seat" or nil
end

local leafKW = {
    "leaf", "leaves", "daun", "foliage", "tree", "pohon", "bush", "shrub",
    "grass", "rumput", "plant", "tanaman", "bark", "branch", "vine", "fern",
}
-- v13.5: cocokkan KATA UTUH (nama dipecah di huruf besar / angka / simbol), bukan substring.
-- Dulu "tree" kena "Street" dan "plant" kena "Implant" -> lantai ikut disembunyikan + CanCollide dimatiin.
local leafSet = {}
for _, k in ipairs(leafKW) do leafSet[k] = true end
local leafCache = {}
local function isLeafName(name)
    local hit = leafCache[name]
    if hit ~= nil then return hit end
    hit = false
    local spaced = name:gsub("(%l)(%u)", "%1 %2")
    for word in spaced:lower():gmatch("%a+") do
        if leafSet[word] or (word:sub(-1) == "s" and leafSet[word:sub(1, -2)]) then
            hit = true
            break
        end
    end
    leafCache[name] = hit
    return hit
end

local FX     = {ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true, Sparkles = true,
    Highlight = true, Explosion = true, ForceField = true}
local POSTFX = {BlurEffect = true, BloomEffect = true, ColorCorrectionEffect = true, SunRaysEffect = true,
    DepthOfFieldEffect = true}

-- v13.7: ParticleEmitter:Emit() tetap jalan walau Enabled = false, dan itu cara game bikin VFX hit / skill.
-- Jadi Enabled = false saja nggak cukup. Emitter dimatiin lewat lifetime 0 + ukuran 0 + transparan penuh
-- (nilai-nilai ini juga kena ke partikel yang sudah terlanjur keluar), beam / trail / highlight dibuat transparan
-- karena game sering cuma nge-toggle Enabled. Nilai asli disimpan sekali buat Restore.
-- NumberSequence / NumberRange nggak dibandingin pakai ==, makanya nggak lewat set().
local ZERO_SEQ, ONE_SEQ, ZERO_RANGE = NumberSequence.new(0), NumberSequence.new(1), NumberRange.new(0)

local function fset(obj, prop, val)
    local o = orig[obj]
    if not o then o = {}; orig[obj] = o end
    if o[prop] == nil then o[prop] = obj[prop] end
    obj[prop] = val
end

local function killFx(obj, cls)
    if cls == "ParticleEmitter" then
        fset(obj, "Enabled", false)
        fset(obj, "Lifetime", ZERO_RANGE)
        fset(obj, "Rate", 0)
        fset(obj, "Size", ZERO_SEQ)
        fset(obj, "Transparency", ONE_SEQ)
    elseif cls == "Beam" then
        fset(obj, "Enabled", false)
        fset(obj, "Transparency", ONE_SEQ)
        fset(obj, "Width0", 0)
        fset(obj, "Width1", 0)
    elseif cls == "Trail" then
        fset(obj, "Enabled", false)
        fset(obj, "Transparency", ONE_SEQ)
        fset(obj, "Lifetime", 0)
    elseif cls == "Highlight" then
        fset(obj, "Enabled", false)
        fset(obj, "FillTransparency", 1)
        fset(obj, "OutlineTransparency", 1)
    elseif cls == "Explosion" or cls == "ForceField" then
        fset(obj, "Visible", false)
    else -- Fire / Smoke / Sparkles
        fset(obj, "Enabled", false)
    end
end

-- Post FX dikunci: kalau game nyalain lagi (blur / flash pas kena), langsung dimatiin lagi.
local guardConn = setmetatable({}, weak)
local function guardOff(obj)
    if guardConn[obj] then return end
    guardConn[obj] = obj:GetPropertyChangedSignal("Enabled"):Connect(function()
        if applied and state.post and obj.Enabled then pset(obj, "Enabled", false) end
    end)
end

-- Deteksi part efek lewat nama (kata utuh, cache dibatasi biar nama unik nggak numpuk selamanya)
local function toSet(list)
    local s = {}
    for _, k in ipairs(list) do s[k] = true end
    return s
end
local VFX_CONT = toSet({"vfx", "fx", "effect", "effects", "particle", "particles", "debris"})
local VFX_PART = toSet({"vfx", "fx", "effect", "particle", "shockwave", "slash", "impact", "aura", "spark",
    "explosion", "ripple", "swirl", "burst", "afterimage", "trail", "flash"})
local partNames, contNames = {t = {}, n = 0}, {t = {}, n = 0}

local function wordHit(name, set, cache)
    local hit = cache.t[name]
    if hit ~= nil then return hit end
    hit = false
    for word in name:gsub("(%l)(%u)", "%1 %2"):lower():gmatch("%a+") do
        if set[word] or (word:sub(-1) == "s" and set[word:sub(1, -2)]) then
            hit = true
            break
        end
    end
    if cache.n > 2000 then cache.t, cache.n = {}, 0 end
    cache.t[name] = hit
    cache.n += 1
    return hit
end

local vfxCache = setmetatable({}, weak)
local function inVfxContainer(p)
    local node, depth = p.Parent, 0
    while node and node ~= workspace and depth < 5 do
        local v = vfxCache[node]
        if v == nil then
            v = wordHit(node.Name, VFX_CONT, contNames)
            vfxCache[node] = v
        end
        if v then return true end
        node, depth = node.Parent, depth + 1
    end
    return false
end

-- fresh = part muncul SETELAH Apply (efek skill / hit). Part baru yang nggak nabrak, nggak bisa di-query dan
-- nggak kena touch hampir pasti efek. Part map yang udah ada sebelum Apply nggak kena aturan ini.
local function isVfxPart(p, fresh)
    if wordHit(p.Name, VFX_PART, partNames) or inVfxContainer(p) then return true end
    return fresh == true and not p.CanCollide and not p.CanQuery and not p.CanTouch and p.Size.Magnitude < 80
end

-- Template efek di ReplicatedStorage dinetralin sekali, jadi hasil Clone() udah mati dari lahir
-- (Emit() di template yang sudah dinetralin nggak ngeluarin apa-apa).
local RepStorage = game:GetService("ReplicatedStorage")
function NX.killTemplates()
    task.spawn(function()
        local list = RepStorage:GetDescendants()
        local t0 = os.clock()
        for i = 1, #list do
            local o = list[i]
            local c = o.ClassName
            if FX[c] and applied and state.fx then pcall(killFx, o, c) end
            if os.clock() - t0 > 0.002 then task.wait(); t0 = os.clock() end
        end
    end)
end
local LIGHT  = {PointLight = true, SpotLight = true, SurfaceLight = true}
local DECAL  = {Decal = true, Texture = true}
local CONSTR = {SpringConstraint = true, RopeConstraint = true, RodConstraint = true,
    HingeConstraint = true, BallSocketConstraint = true, PrismaticConstraint = true}
local MOVER  = {BodyVelocity = true, BodyPosition = true, BodyForce = true, BodyGyro = true}
local SELECT = {SelectionBox = true, SelectionSphere = true}
local HUM_STATES = {
    Enum.HumanoidStateType.FallingDown,
    Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.GettingUp,
}
local ATMO_PROPS  = {"Density", "Glare", "Haze", "Offset"}
local WATER_PROPS = {"WaterWaveSize", "WaterWaveSpeed", "WaterReflectance", "WaterTransparency"}

local parts, partIdx, cursor, culledN = {}, {}, 0, 0
local radius   = setmetatable({}, weak) -- v13.7: setengah diagonal part, dihitung sekali (bukan baca Size tiap frame)
local freshSet = setmetatable({}, weak) -- part yang muncul setelah Apply

local function addPart(p)
    parts[#parts + 1] = p
    partIdx[p] = #parts
    radius[p] = p.Size.Magnitude * 0.5
end

local function removePart(p)
    local i = partIdx[p]
    if not i then return end
    local last = parts[#parts]
    parts[i] = last
    partIdx[last] = i
    parts[#parts] = nil
    partIdx[p] = nil
    if culled[p] then culled[p] = nil; culledN -= 1 end
end

local function processPart(p, fresh)
    local prot = protection(p)
    -- v13.7: part efek (VFX mesh / neon / part non-interaktif yang baru muncul) disembunyiin total.
    -- LocalTransparencyModifier ikut diset karena game biasanya nge-tween Transparency (fade in / out)
    -- dan tween itu nimpa Transparency = 1. Collision / touch / query nggak disentuh.
    if state.fx and CFG.fxHard and prot ~= "char" and isVfxPart(p, fresh) then
        set(p, "Transparency", 1)
        set(p, "LocalTransparencyModifier", 1)
        set(p, "CastShadow", false)
        return
    end
    -- v13.5: avatar / NPC dicek DULU. Dulu tekstur + material karakter dihapus lebih dulu lalu "dipulihkan" hub tiap 1 detik
    -- (avatar sempat blank). Sekarang karakter cuma kena CastShadow, tampilannya nggak disentuh.
    if state.texture and prot ~= "char" then
        set(p, "Material", Enum.Material.SmoothPlastic)
        set(p, "Reflectance", 0)
        if p:IsA("MeshPart") then
            pset(p, "TextureID", "")
            pset(p, "RenderFidelity", Enum.RenderFidelity.Performance)
        end
    end
    if state.shadow then set(p, "CastShadow", false) end
    if prot == "char" then return end
    -- Hide Leaves: part besar (lantai / tanah / tembok) nggak pernah disentuh, dan collision nggak diubah.
    if state.leaf and isLeafName(p.Name) and p.Size.Magnitude < 40 then
        set(p, "Transparency", 1)
        return
    end
    if state.anchor and not prot and not p.Anchored then set(p, "Anchored", true) end
    if p.Transparency < 1 and not partIdx[p] then addPart(p) end
end

-- BillboardGui dan Sound sengaja tidak disentuh.
local function processObject(obj, fresh)
    local cls = obj.ClassName
    if cls == "Terrain" then return end
    if POSTFX[cls] then
        if state.post then pset(obj, "Enabled", false); guardOff(obj) end
        return
    end
    if obj:IsA("BasePart") then return processPart(obj, fresh) end
    if cls == "Humanoid" then
        if obj.Parent ~= lp.Character and not touchedHum[obj] then
            touchedHum[obj] = true
            for _, s in ipairs(HUM_STATES) do obj:SetStateEnabled(s, false) end
        end
        return
    end
    if state.texture and (cls == "SpecialMesh" or cls == "SurfaceAppearance" or DECAL[cls]) then
        -- v13.5: tekstur / decal / baju milik karakter (wajah, aksesori, SurfaceAppearance) nggak disentuh
        if protection(obj) == "char" then return end
        if cls == "SpecialMesh" then return pset(obj, "TextureId", "") end
        if cls == "SurfaceAppearance" then return stash(obj) end
        return pset(obj, "Transparency", 1)
    end
    if state.shadow and LIGHT[cls] then return pset(obj, "Enabled", false) end
    if state.fx then
        if FX[cls] then return pcall(killFx, obj, cls) end
        if cls == "SurfaceGui" and protection(obj) ~= "char" then
            return pset(obj, "Enabled", false)
        end
        -- v13.7: billboard gambar (hit flash / ikon efek) ikut mati; yang ada teksnya (nameplate, angka damage) tetap
        if cls == "BillboardGui" and CFG.fxHard and protection(obj) ~= "char"
            and not obj:FindFirstChildWhichIsA("TextLabel", true) then
            return pset(obj, "Enabled", false)
        end
    end
    if state.aggr and (CONSTR[cls] or MOVER[cls] or SELECT[cls] or cls == "ClickDetector")
        and not protection(obj) then
        if CONSTR[cls] then return pset(obj, "Enabled", false) end
        if cls == "ClickDetector" then return pset(obj, "MaxActivationDistance", 0) end
        return stash(obj)
    end
end

