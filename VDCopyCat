        ---------------------------------------------------------------- SPEARMATH (nilai konstanta dibaca langsung dari modul game) + SpearState
        function V.dumpMath()
            local ok, m = pcall(function() return require(RS.Modules.Killers.Veil.SpearMath) end)
            if not ok or type(m) ~= "table" then
                log("VEIL", "SpearMath ga kebaca: " .. tostring(m))
                return
            end
            local flat, fns, lines = {}, {}, {}
            local function walk(t, prefix, depth)
                for k, v in pairs(t) do
                    local name = prefix .. tostring(k)
                    local tv = typeof(v)
                    if tv == "number" or tv == "Vector3" or tv == "boolean" or tv == "string" then
                        flat[name] = v
                        lines[#lines + 1] = name .. "=" .. tostring(v)
                    elseif tv == "function" then
                        fns[#fns + 1] = name .. "()"
                    elseif tv == "table" and depth < 2 then
                        walk(v, name .. ".", depth + 1)
                    end
                end
            end
            walk(m, "", 0)
            table.sort(lines)
            table.sort(fns)
            local line = ""
            for _, p in ipairs(lines) do
                if #line + #p > 230 then
                    log("SPEARMATH", line)
                    line = ""
                end
                line = line .. (line == "" and "" or " | ") .. p
            end
            if line ~= "" then log("SPEARMATH", line) end
            if #fns > 0 then log("SPEARMATH", "fungsi: " .. table.concat(fns, ", ")) end

            local speedKey, speed, gKey, g
            local function pick(lname)   -- cari berdasarkan akhiran nama (tanpa prefix tabel)
                for name, v in pairs(flat) do
                    local l = name:lower()
                    if l == lname or l:sub(-#lname - 1) == "." .. lname then return v end
                end
            end
            V.math.maxCharge = pick("maxchargetime")
            V.math.minCharge = pick("minimumchargetime")
            V.math.throwDelay = pick("throwstartdelay")
            V.math.maxLife = pick("maxlife")
            V.math.spawnOffset = pick("spawnoffset")
            local names = {}
            for name in pairs(flat) do names[#names + 1] = name end
            table.sort(names)
            for _, name in ipairs(names) do
                local v, l = flat[name], name:lower()
                if type(v) == "number" then
                    if (l:find("speed", 1, true) or l:find("velocity", 1, true)) and v > 20 and v < 800 then
                        if not speed or (l:find("max", 1, true) and not speedKey:lower():find("max", 1, true)) then speed, speedKey = v, name end
                    elseif l:find("grav", 1, true) and v >= 0 and v <= 600 and not gKey then
                        g, gKey = v, name
                    end
                end
            end
            for kname, val in pairs(V.math) do
                if type(val) ~= "number" and typeof(val) ~= "Vector3" then V.math[kname] = nil end
            end
            if speed then
                V.seedSpeed = speed
                log("SPEARMATH", string.format("kecepatan awal dari %s = %.0f (nanti ditimpa kalibrasi lemparan)", speedKey, speed))
            end
            if g then
                V.seedG = g
                log("SPEARMATH", string.format("gravitasi awal dari %s = %.1f", gKey, g))
            end
            log("SPEARMATH", string.format("charge %s..%s | delay %s | umur %s | offset %s",
                tostring(V.math.minCharge), tostring(V.math.maxCharge), tostring(V.math.throwDelay), tostring(V.math.maxLife),
                tostring(V.math.spawnOffset)))
        end

        task.spawn(function()
            task.wait(2.5)
            if alive() then pcall(V.dumpMath) end
            local ok = pcall(function()
                local ev = RS:WaitForChild("Remotes", 30):WaitForChild("Killers", 30):WaitForChild("Veil", 30):WaitForChild("SpearState", 30)
                local seen = 0
                keep(ev.OnClientEvent:Connect(function(...)
                    V.lastState = os.clock()
                    seen = seen + 1
                    if seen > 40 then return end
                    local parts = {}
                    for i = 1, math.min(select("#", ...), 6) do
                        local v = (select(i, ...))
                        parts[#parts + 1] = typeof(v) .. "=" .. tostring(v)
                    end
                    log("SPEAR state", table.concat(parts, ", "))
                end))
            end)
            if not ok then log("VEIL", "remote SpearState ga ketemu (ga masalah, cuma buat diagnosa)") end
        end)

        ---------------------------------------------------------------- BELAJAR TERSIMPAN / RESET / STATUS
        function V.save()
            return { speed = V.calibSpeed, g = V.calibG, cd = V.cdLearn, lead = V.leadAdj, vb = V.vBias }
        end
        function V.load(d)
            local function num(v, lo, hi)
                if type(v) ~= "number" or v ~= v then return nil end
                return math.clamp(v, lo, hi)
            end
            V.calibSpeed = num(d.speed, 20, 700) or V.calibSpeed
            V.calibG = num(d.g, 0, 600) or V.calibG
            V.cdLearn = num(d.cd, 1, 60) or V.cdLearn
            if V.cdLearn then V.cdMin, V.cdSamples = V.cdLearn, 2 end
            V.leadAdj = num(d.lead, -0.2, 0.45) or V.leadAdj
            V.vBias = num(d.vb, -2.5, 2.5) or V.vBias
            log("BELAJAR", string.format("Veil dimuat: speed %s | g %s | cd %s | lead %+.0f ms | tinggi %+.2f",
                V.calibSpeed and string.format("%.0f", V.calibSpeed) or "-", V.calibG and string.format("%.1f", V.calibG) or "-",
                V.cdLearn and string.format("%.1f", V.cdLearn) or "-", V.leadAdj * 1000, V.vBias))
        end
        function V.wipe()
            V.calibSpeed, V.calibG, V.cdLearn, V.cdMin, V.cdSamples = nil, nil, nil, nil, 0
            V.leadAdj, V.vBias, V.shots, V.hits = 0, 0, 0, 0
        end
        function V.resetCalib()
            V.wipe()
            log("VEIL", "kalibrasi dihapus: kecepatan / gravitasi / cooldown / lead belajar ulang dari lemparan berikutnya")
        end
        function V.reset()
            V.targetChar, V.lockedNow, V.snap = nil, false, nil
            V.heldKey, V.heldBtn, V.toggled = false, false, false
            V.cdUntil = 0
        end
        function V.statusText()
            local now = os.clock()
            return string.format("%s | speed %.0f%s | g %.0f%s | lead %.0fms\ncd %.1fs%s | lempar %d/%d | tinggi %+.1f",
                V.isVeil and "VEIL" or "bukan Veil", V.speed(), V.calibSpeed and "*" or "", V.grav(), V.calibG and "*" or "",
                leadTime() * 1000, V.cdTotal(), V.cdLearn and "*" or "", V.hits, V.shots, V.vBias)
        end

        log("VEIL", "modul dimuat (tanda * = hasil kalibrasi / belajar)")
    end)
    if not okV then log("VEIL", "modul gagal dimuat: " .. tostring(errV)) end
end

