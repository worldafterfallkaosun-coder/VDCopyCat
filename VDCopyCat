-- tengah zona sukses relatif ke Goal.Rotation (kode game: 102 <= Line.Rotation - Goal.Rotation <= 116)
local function zoneMid() return (CFG.skill.zoneLo + CFG.skill.zoneHi) / 2 end

-- v10: frame-snap. Zona sukses cuma 14 derajat (~50 ms di kecepatan normal). Di 20-30 FPS satu frame bisa lompat lewat zona, jadi
-- sesaat sebelum handler game dipanggil (sinkron), Line.Rotation dirapihin ke tengah zona KALAU jarum tinggal <= snapFrames frame
-- dari tengah (geser maksimal ~1.5 frame, ga kelihatan). Tier async (vim/tap/click) ga di-snap: frame berikutnya tween nimpa lagi.
function Skill.snap(tier)
    local C = CFG.skill
    local c = Skill.cur
    if not (C.frameSnap and Skill.syncTier[tier] and c and c.line and c.line.Parent and c.goal and c.goal.Parent) then return end
    local w = c.w or 0
    if math.abs(w) < 20 then return end
    local dir = (w >= 0) and 1 or -1
    local frame = math.clamp(Net.frameDt, 1 / 120, 1 / 15)
    local target = c.goal.Rotation + zoneMid()
    local delta = angDiff(target, c.line.Rotation) * dir      -- > 0 = jarum belum sampai tengah
    local span = math.abs(w) * frame
    if delta < -span or delta > span * C.snapFrames or math.abs(delta) < 0.4 then return end
    local okS = pcall(function() c.line.Rotation = target end)
    if okS then
        Skill.snapAt, Skill.snapDelta = os.clock(), delta
        log("SKILL", string.format("frame-snap %+.1f deg ke tengah zona (fps~%.0f)", delta, 1 / frame))
    end
end

-- regresi linear: kecepatan sudut (deg/s) dari sample (waktu, sudut kontinu)
local function slope(samples)
    local n = #samples
    if n < 2 then return nil end
    local t0 = samples[1][1]
    local sx, sy, sxx, sxy = 0, 0, 0, 0
    for i = 1, n do
        local x, y = samples[i][1] - t0, samples[i][2]
        sx, sy, sxx, sxy = sx + x, sy + y, sxx + x * x, sxy + x * y
    end
    local den = n * sxx - sx * sx
    if math.abs(den) < 1e-9 then return nil end
    return (n * sxy - sx * sy) / den
end

-- true = ditangani (ditekan / selesai / ga muncul, trace ditulis ke log), false = GUI skill check ga ada -> metode lama
local function skillTrackNamed(evtInfo, gen)
    local P = skillPairs()
    if #P == 0 then return false end
    Skill.ladder = buildLadder()
    if not Skill.probed then
        Skill.probed = true
        task.spawn(function() pcall(skillProbe) end)
    end

    local t0 = os.clock()
    local trace, lastTr = {}, -1
    local function tr(s)
        if #trace < 40 then trace[#trace + 1] = string.format("%.2f %s", os.clock() - t0, s) end
    end
    local act, samples, moved = nil, {}, false
    local lastRot
    local seedW = Skill.seedOmega(evtInfo)     -- v10: kecepatan jarum dari game, ga nunggu regresi 3 sample

    while os.clock() - t0 < 5 and alive() and CFG.skill.enabled and Skill.gen == gen do
        local dtf = RunService.RenderStepped:Wait()
        local now = os.clock()

        local cur
        for _, p in ipairs(P) do
            if p.chk.Parent and p.chk.Visible and p.gui.Enabled ~= false then cur = p break end
        end

        if now - lastTr >= 0.12 then
            lastTr = now
            local p = cur or P[1]
            tr(string.format("%s vis=%s L=%.0f G=%.0f", p.gui.Name == "SkillCheckPromptGui" and "kb" or "pad",
                tostring(cur ~= nil), p.line.Rotation, p.goal.Rotation))
        end

        if cur then
            if cur ~= act then
                act, samples, lastRot = cur, {}, nil
                Skill.cur = { line = cur.line, goal = cur.goal, w = 0 }
                local kids = {}
                for _, c in ipairs(cur.goal:GetChildren()) do kids[#kids + 1] = c.ClassName .. ":" .. c.Name end
                log("SKILL", string.format("check muncul %.2fs setelah event (tune=%.0fms) goal anak={%s}",
                    now - t0, curTune(math.clamp(dtf, 1 / 120, 1 / 20)) * 1000, table.concat(kids, ",")))
            end
            local raw = act.line.Rotation
            local a = raw
            if #samples > 0 then a = samples[#samples][2] + angDiff(raw, samples[#samples][2]) end   -- kontinu (anti wrap)
            -- sample baru cuma kalau jarum beneran gerak (game update per frame, jangan dobel)
            if (not lastRot) or math.abs(angDiff(raw, lastRot)) > 0.01 then
                samples[#samples + 1] = { now, a }
                if #samples > 5 then table.remove(samples, 1) end
                lastRot = raw
            end

            local w
            if #samples >= 3 then
                w = slope(samples)
                if w and math.abs(w) > 20 then Skill.w0 = w end
            else
                w = seedW or Skill.w0 or ((#samples == 2) and slope(samples) or nil)
            end

            if w and math.abs(w) > 20 and #samples >= 1 then
                moved = true
                Skill.cur.w = w
                local last = samples[#samples]
                local zone = act.goal.Rotation + zoneMid() + CFG.skill.offset
                local dir = (w >= 0) and 1 or -1
                local rem = ((zone - last[2]) * dir) % 360          -- sisa sudut ke tengah zona, searah jarum
                rem = rem - w * dir * (now - last[1]) * 0 + 0       -- sample udah terbaru (per frame)
                local frame = math.clamp(dtf, 1 / 120, 1 / 20)
                if rem > 360 - math.abs(w) * frame * 0.5 then rem = 0 end
                local T = rem / math.abs(w)
                if T <= curTune(frame) + frame * 0.5 then
                    Skill.retried = false
                    log("SKILL", string.format("TEKAN sisa=%.1f deg (%.0f ms) kecepatan=%.0f deg/s fps~%.0f sample=%d",
                        rem, T * 1000, w, 1 / frame, #samples))
                    pressLadder()
                    return true
                end
            end
        elseif act then
            break      -- tadinya tampil, sekarang ketutup: check selesai
        end
    end

    local why
    if not act then why = "check ga pernah tampil dalam 5s"
    elseif not moved then why = "check tampil tapi jarum ga kebaca gerak"
    else why = "jarum kebaca tapi ga ketekan (kelewat / check selesai duluan)" end
    log("SKILL", why)
    log("SKILL", "TRACE " .. table.concat(trace, " | "))
    return true
end

-- hook ngirim: game ngirim hasil skill check (Result ATAU Fail): ukur seberapa meleset, lalu tune per cara input.
-- resultN dipakai tangga input buat tau apakah tekanan barusan MASUK ke game.
SkillHook.judged = function(args, name)
    Skill.resultN = Skill.resultN + 1
    Skill.lastResult = os.clock()
    local c = Skill.cur
    if not c or not c.line.Parent then return end
    local since = os.clock() - Skill.pressClock
    local w = c.w or 0
    local dir = (w >= 0) and 1 or -1
    local err = angDiff(c.line.Rotation, c.goal.Rotation + zoneMid() + CFG.skill.offset) * dir
    if Skill.snapAt and Skill.snapDelta and os.clock() - Skill.snapAt < 0.3 then
        err = -Skill.snapDelta   -- rotasi udah dirapihin frame-snap: belajar dari selisih SEBELUM dirapihin
    end
    Skill.snapAt = nil
    local errT = (math.abs(w) > 1) and (err / math.abs(w)) or 0
    local mine = since >= 0 and since < 0.3
    log("SKILL", string.format("HASIL %s %s %s | err=%+.1f deg (%+.0f ms %s) | tekan->hasil %.0f ms | %s",
        tostring(name), tostring(args[1]), tostring(args[2]), err, errT * 1000, errT > 0 and "telat" or "kecepatan",
        since * 1000, mine and ("tekanan skrip via " .. tostring(Skill.pressTier)) or "BUKAN dari tekanan skrip"))
    -- belajar cuma dari tekanan di rung pertama (rung berikutnya telat by design, bakal ngerusak tune)
    if mine and CFG.skill.learn and math.abs(errT) < 0.25 and Skill.pressRung == 1 then
        local k = Skill.pressTier or "?"
        Skill.tuneDelta[k] = math.clamp((Skill.tuneDelta[k] or 0) + 0.5 * errT, -0.08, 0.25)
    end
    Skill.cur = nil
end

local function skillTrackLegacy(evtInfo, gen)
    local t0 = os.clock()
    local stats = {}
    local list, lastList, lastZone = {}, -1, -1
    local needle, zone, prevDiff
    local wide, dumped = false, false

    local ZONE_NAMES = { "great", "perfect", "success", "zone", "target", "area", "good", "safe", "hit" }
    local function pickNeedle(lst, st)
        local best, bestE = nil, 30
        for _, o in ipairs(lst) do
            local s = st[o]
            if s and s.n >= 3 and s.ema > bestE and o.Parent and shown(o) then best, bestE = o, s.ema end
        end
        return best
    end
    local function pickZone(lst, st, nd)
        local best, bestScore, bestArea
        for _, o in ipairs(lst) do
            local s = st[o]
            if s and o ~= nd and s.still >= 8 and o.Parent and shown(o) then
                local score = 0
                if nameHas(o.Name, ZONE_NAMES) then score = 3 end
                if math.abs(angDiff(s.rot, 0)) > 1 then score = score + 1 end
                if o:IsA("UIGradient") then score = score + 0.5 end
                if score >= 1 then
                    local area = 0
                    if o:IsA("GuiObject") then area = o.AbsoluteSize.X * o.AbsoluteSize.Y end
                    if not best or score > bestScore or (score == bestScore and area < bestArea) then
                        best, bestScore, bestArea = o, score, area
                    end
                end
            end
        end
        return best
    end

    while os.clock() - t0 < CFG.skill.maxWait and alive() and CFG.skill.enabled and (not gen or Skill.gen == gen) do
        local dt = RunService.RenderStepped:Wait()
        local now = os.clock()

        if now - lastList > 0.25 then
            lastList = now
            if (not wide) and now - t0 > 1.2 and not needle then
                wide = true
                log("SKILL", "needle ga ketemu di SkillCheckPromptGui -> scan seluruh PlayerGui")
            end
            list = collect(wide)
        end

        for _, o in ipairs(list) do
            if o.Parent then
                local r = absRot(o)
                local s = stats[o]
                if not s then
                    stats[o] = { last = r, rot = r, n = 0, ema = 0, sv = 0, still = 0 }
                else
                    local d = angDiff(r, s.last)
                    local sp = d / math.max(dt, 1e-3)
                    s.last, s.rot, s.n = r, r, s.n + 1
                    s.ema = s.ema * 0.8 + math.abs(sp) * 0.2
                    s.sv = s.sv * 0.6 + sp * 0.4
                    if math.abs(d) < 0.05 then s.still = s.still + 1 else s.still = 0 end
                end
            end
        end

        if not dumped and now - t0 > 0.35 then
            dumped = true
            snapshot("skillcheck start", evtInfo)
        end

        if not needle or not needle.Parent or not stats[needle] or stats[needle].ema < 15 then
            needle = pickNeedle(list, stats)
            zone = nil
        end
        if needle and (not zone or not zone.Parent or now - lastZone > 0.3) then
            lastZone = now
            zone = pickZone(list, stats, needle)
        end

        if needle and zone then
            local ns, zs = stats[needle], stats[zone]
            local pred = ns.rot + ns.sv * CFG.skill.lead
            local diff = angDiff(pred, zs.rot + CFG.skill.offset)
            local tight = math.max(1.2, math.abs(ns.sv) * dt * 0.8)
            local crossed = prevDiff and (prevDiff * diff < 0) and (math.abs(prevDiff) + math.abs(diff) < 30)
            if math.abs(diff) <= tight or crossed then
                Skill.retried = true
                pressLadder()
                log("SKILL", string.format("TEKAN (lama) diff=%.1f needle=%s zone=%s", diff, needle.Name, zone.Name))
                task.delay(0.3, function() snapshot("skillcheck after press") end)
                return
            end
            prevDiff = diff
        else
            prevDiff = nil
        end
    end

    local rows = {}
    for _, o in ipairs(list) do
        local s = stats[o]
        if s and (s.ema > 0 or o:GetFullName():find("SkillCheck", 1, true)) then
            rows[#rows + 1] = string.format("%s [%s] ema=%.0f still=%d rot=%.1f", o:GetFullName(), o.ClassName, s.ema, s.still, s.rot)
        end
    end
    table.sort(rows)
    snapshot("skillcheck GAGAL", "kandidat:\n" .. table.concat(rows, "\n", 1, math.min(#rows, 60)))
    log("SKILL", "needle/zona ga ketemu - tap Copy Dump")
end

local function skillTrack(evtInfo, gen)
    local ok, handled = pcall(skillTrackNamed, evtInfo, gen)
    if not ok then log("SKILL", "named error: " .. tostring(handled)) end
    if ok and handled then return end
    if Skill.gen ~= gen then return end   -- udah ada event baru
    log("SKILL", "Line/Goal ga ketemu -> metode lama")
    skillTrackLegacy(evtInfo, gen)
end

local function unhideChecks()
    for chk, _ in pairs(Skill.hidden) do
        if chk.Parent then pcall(function() chk.Visible = true end) end
        Skill.hidden[chk] = nil
    end
end

local function runSkillCheck(info)
    if not CFG.skill.enabled then return end
    Skill.gen = Skill.gen + 1          -- event baru selalu menang: tracker lama berhenti sendiri
    Skill.lastEvent = os.clock()
    unhideChecks()                     -- Check yang tadi kita sembunyiin (nyangkut) dibalikin, game yang atur sisanya
    local gen = Skill.gen
    Skill.active = true
    task.spawn(function() pcall(refreshGameFns) end)
    task.spawn(function()
        local ok, err = pcall(skillTrack, info, gen)
        if not ok then log("SKILL", "error: " .. tostring(err)) end
        if Skill.gen == gen then Skill.active = false end
    end)
end

-- SkillCheckEvent ga ada di lobby (remote dibuat pas ronde). Jadi dipantau terus, bukan WaitForChild lalu nyerah,
-- dan dipasang ulang kalau remote-nya diganti. Remote Result/Fail juga didaftarin ke Spy dari sini.
local function hookSkillEvents(folder)
    task.spawn(function()
        local conn, cur
        while alive() do
            local remotes = RS:FindFirstChild("Remotes")
            local f = remotes and remotes:FindFirstChild(folder)
            if f then
                for nm, tag in pairs({ SkillCheckResultEvent = ".Result", SkillCheckFailEvent = ".Fail" }) do
                    local r = f:FindFirstChild(nm)
                    if r and not Spy[r] then Spy[r] = folder .. tag end
                end
                local ev = f:FindFirstChild("SkillCheckEvent")
                if ev ~= cur then
                    if conn then
                        conn:Disconnect()
                        conn = nil
                    end
                    cur = ev
                    Skill.events[folder] = ev
                    if ev then
                        local okc, c = pcall(function()
                            return keep(ev.OnClientEvent:Connect(function(...)
                                local parts = {}
                                for i = 1, math.min(select("#", ...), 8) do
                                    local v = (select(i, ...))
                                    parts[#parts + 1] = typeof(v) .. "=" .. tostring(v)
                                end
                                local info = folder .. " event args: " .. table.concat(parts, ", ")
                                log("SKILL", info)
                                runSkillCheck(info)
                            end))
                        end)
                        if okc then
                            conn = c
                            log("SKILL", "hooked " .. folder .. " (" .. ev.ClassName .. ")")
                        else
                            log("SKILL", "gagal hook " .. folder .. ": " .. tostring(c))
                        end
                    end
                end
            end
            task.wait(0.5)
        end
        if conn then conn:Disconnect() end
    end)
end
