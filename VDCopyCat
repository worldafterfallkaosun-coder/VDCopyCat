function Gun.steady(char)
local tr=Track[char]
if not tr or not tr.hist or#tr.hist<4 then return true end
local old,cur=tr.hist[1].v,tr.vel
local a,b=Vector3.new(old.X,0,old.Z),Vector3.new(cur.X,0,cur.Z)
local sa,sb=a.Magnitude,b.Magnitude
if sa<2 and sb<2 then return true end
if math.abs(sa-sb)>CFG.gun.steadyAcc*math.max(sa,sb,6)then return false end
if sa<2 or sb<2 then return false end
local ang=math.deg(math.acos(math.clamp(a.Unit:Dot(b.Unit),-1,1)))
return ang<=CFG.gun.steadyAng
end
local function leadTime(dist)
local G=CFG.gun
local t=0
if G.leadPing>0 then t=t+Net.aimLag()*G.leadPing+G.leadBase+Gun.leadAdj end
if G.lead>0 and G.bulletSpeed>0 then t=t+(dist/G.bulletSpeed)*G.lead end
return math.clamp(t,0,G.leadMax)
end
function Gun.aimOf(part,origin,force)
local G=CFG.gun
local body=part.Position
if part.Name~="HumanoidRootPart"then return body,"BODY",part end
body=body+Vector3.new(0,G.aimYOffset or 0,0)
local mode=G.aimPoint or"body"
if force=="BODY"or mode=="body"then return body,"BODY",part end
local ch=part.Parent
local head=ch and ch:FindFirstChild("Head")
if not(head and head:IsA("BasePart"))then return body,"BODY",part end
local headPos=head.Position+Vector3.new(0,G.headYOffset or 0,0)
if force=="HEAD"then return headPos,"HEAD",head end
local want=true
if mode=="auto"then
local tr=Track[ch]
local spd=tr and Vector3.new(tr.vel.X,0,tr.vel.Z).Magnitude or 0
if spd>(G.headMaxSpeed or 14)or(part.Position-origin).Magnitude>(G.headMaxDist or 120)then want=false end
if want then
local tt=(part.Position-origin).Magnitude/math.max(G.bulletSpeed or 800,1)+Net.aimLag()*(G.leadPing or 1)+(G.leadBase or 0)
if spd*(Net.jitter*2+0.05)+spd*0.1*math.min(tt,0.7)>(G.headMaxErr or 1.0)then want=false end
end
end
local now=os.clock()
local ak=Gun.aimK[ch]
if not ak then
ak={kind="BODY",t=-10}
Gun.aimK[ch]=ak
end
local ok=want and visibleFrom(origin,head)
if not ok then
if ak.kind~="BODY"then ak.kind,ak.t="BODY",now end
elseif ak.kind~="HEAD"and now-ak.t>=(G.aimHold or 0.3)then
ak.kind,ak.t="HEAD",now
end
if ak.kind=="HEAD"then return headPos,"HEAD",head end
return body,"BODY",part
end
