function W.startDrag(obj, input, onTap, onHold, onDone)
    local sx, sy = input.Position.X, input.Position.Y
    local ox, oy = obj.Position.X.Offset, obj.Position.Y.Offset
    local moved, held, token = false, false, {}
    DRAG = {
        tk = token,
        move = function(p)
            local dx, dy = p.X - sx, p.Y - sy
            if not moved and math.abs(dx) + math.abs(dy) < 8 then return end
            moved = true
            clampTo(obj, ox + dx, oy + dy)
        end,
        stop = function()
            if moved then
                LASTDRAG = os.clock()
                if onDone then onDone() end
            elseif not held and onTap then
                onTap()
            end
        end,
    }
    if onHold then
        task.delay(0.5, function()
            if DRAG and DRAG.tk == token and not moved then held = true; onHold() end
        end)
    end
end

