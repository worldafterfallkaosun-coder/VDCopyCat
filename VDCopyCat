------------------------------------------------------------------ 1) AUTO PARRY
-- v8.3: delay dipelajari PER ANIMASI dari damage yang beneran kena. Waktu "animasi mulai -> kamu kena" dicatat,
-- parry berikutnya ditembak aimLead detik sebelum itu. Sebelum ada data, pakai CFG.parry.delay.
local Parry = {
    watched = setmetatable({}, { __mode = "k" }), last = 0, cdUntil = 0, remote = nil,
    delay = {}, hitT = {}, recent = {}, hpHum = nil,
}
local parrySeenAt, parryWhyAt, parryCdAt, parryHpAt = 0, 0, 0, 0

local function delayFor(key)
    return Parry.delay[key] or CFG.parry.delay
end

local function shortKey(key)
    return tostring(key):match("%d+") or tostring(key)
end

local function findDagger()
    local c = myChar()
    if not c then return nil end
    local t = c:FindFirstChild("Parrying Dagger")
    if t then return t, true end
    local bp = LP:FindFirstChildOfClass("Backpack")
    t = bp and bp:FindFirstChild("Parrying Dagger")
    return t, false
end

-- true kalau parry terkirim
local function parryNow(entry, base)
    if not CFG.parry.enabled then return false end
    local now = os.clock()
    if now - Parry.last < CFG.parry.spacing then return false end
    if CFG.parry.useServerCd and now < Parry.cdUntil then
        if now - parryCdAt > 2 then
            parryCdAt = now
            log("PARRY", string.format("parry masih cooldown %.1fs lagi, ga dikirim", Parry.cdUntil - now))
        end
        return false
    end
    local hum, char = myHum(), myChar()
    if not hum or hum.Health <= 0 or not char then return false end
    if hum.Health < hum.MaxHealth * 0.5 then   -- client game nolak parry kalau HP < 50%
        if now - parryHpAt > 3 then
            parryHpAt = now
            log("PARRY", "HP < 50%: game nolak parry (ParryClient._isLowHealth)")
        end
        return false
    end

    local tool, equipped = findDagger()
    if not tool then
        if now - parryWhyAt > 3 then
            parryWhyAt = now
            log("PARRY", "Parrying Dagger ga ada di tangan / backpack")
        end
        return false
    end
    if not equipped then
        if not CFG.parry.autoEquip then return false end
        hum:EquipTool(tool)
        task.wait(0.08)
    end

    Parry.last = os.clock()
    entry.fired = Parry.last
    local before = char:GetAttribute("ParryLands") or 0

    if CFG.parry.via == "input" then
        local ok = press(getBind("kb_item", "MouseButton2"), 0.04, "vim")
        if not ok then press(getBind("kb_item", "MouseButton2"), 0.04, "all") end
    else
        -- cari ulang tiap kali (sama kayak script lama), jangan pegang remote lama yang bisa udah ke-replace
        local ev = Parry.remote
        if not (ev and ev.Parent) then
            local okf, r = pcall(function() return RS.Remotes.Items["Parrying Dagger"].parry end)
            if okf and r then
                ev = r
                Parry.remote = r
            end
        end
        if not ev then
            log("PARRY", "remote parry ga ketemu")
            return false
        end
        ev:FireServer(char)
    end
    log("PARRY", string.format("kirim parry [%s] delay %.2f (%.0f ms setelah animasi mulai)",
        shortKey(entry.key), base or 0, (Parry.last - entry.t0) * 1000))

    task.delay(0.9, function()
        if not alive() then return end
        local after = (myChar() == char) and (char:GetAttribute("ParryLands") or 0) or before
        local ok = after > before
        entry.landed = ok
        if ok then Parry.delay[entry.key] = base end   -- delay ini terbukti landing, kunci
        log("PARRY", string.format("[%s] delay=%.2f %s", shortKey(entry.key), base or 0, ok and "SUKSES" or "meleset"))
    end)
    return true
end

-- killer ngancam kita? lead = prediksi gerak (lunge)
local function threatens(k, lead)
    local me = myRoot()
    if not me or not k.root.Parent then return false end
    local vel = Vector3.new(0, 0, 0)
    pcall(function() vel = k.root.AssemblyLinearVelocity end)
    local pos = k.root.Position + vel * (lead or 0)
    local to = me.Position - pos
    local dist = to.Magnitude
    if dist > CFG.parry.range then return false end
    if dist < 0.01 then return true end
    return k.root.CFrame.LookVector:Dot(to.Unit) >= CFG.parry.frontDot
end

local function watchKiller(k)
    local animator = k.hum:FindFirstChildOfClass("Animator")
    if not animator or Parry.watched[animator] then return end
    Parry.watched[animator] = true
    animator.AnimationPlayed:Connect(function(track)
        if not alive() or not CFG.parry.enabled or not amSurvivor() then return end
        if track.Looped then return end
        if track.Priority.Value < CFG.parry.minPriority.Value then return end
        local key = (track.Animation and track.Animation.AnimationId) or track.Name
        local t0 = os.clock()
        local entry = { key = key, t0 = t0 }
        local rec = Parry.recent
        rec[#rec + 1] = entry
        while #rec > 8 or (rec[1] and t0 - rec[1].t0 > 3) do table.remove(rec, 1) end

        task.spawn(function()
            local base = delayFor(key)
            local jit = (math.random() * 2 - 1) * CFG.parry.jitter
            local fireAt = t0 + math.max(CFG.parry.minDelay, base + jit)
            local untilT = fireAt + CFG.parry.pollWindow
            local sent, seen = false, false
            while alive() and CFG.parry.enabled and track.IsPlaying and os.clock() < untilT do
                if os.clock() >= fireAt and threatens(k, CFG.parry.lead) then
                    seen = true
                    sent = parryNow(entry, base)
                    break
                end
                RunService.Heartbeat:Wait()
            end
            if not sent and not seen and os.clock() - parrySeenAt > 2 then
                parrySeenAt = os.clock()
                log("PARRY", "animasi serang kebaca tapi killer ga ngancam (jarak/arah)")
            end
        end)
    end)
end

-- belajar dari damage: kapan sebenernya kita kena setelah animasi mulai
local function hookHealth()
    local hum = myHum()
    if not hum or Parry.hpHum == hum then return end
    Parry.hpHum = hum
    local last = hum.Health
    hum.HealthChanged:Connect(function(h)
        local drop = last - h
        last = h
        if drop <= 0.5 or not alive() or not CFG.parry.learn then return end
        local now = os.clock()
        local best
        for i = #Parry.recent, 1, -1 do
            local e = Parry.recent[i]
            local age = now - e.t0
            if age > 1.5 then break end
            if age >= 0.05 and not e.landed and not e.hit then best = e break end
        end
        if not best then return end
        best.hit = now
        local tHit = now - best.t0
        local old = Parry.hitT[best.key]
        local new = old and (old * 0.5 + tHit * 0.5) or tHit
        Parry.hitT[best.key] = new
        local d = math.clamp(new - CFG.parry.aimLead, CFG.parry.minDelay, CFG.parry.maxDelay)
        Parry.delay[best.key] = d
        log("PARRY", string.format("[%s] kena damage %.0f ms setelah animasi mulai -> delay jadi %.2f",
            shortKey(best.key), tHit * 1000, d))
    end)
end

task.spawn(function()
    pcall(function()
        local pd = RS:WaitForChild("Remotes", 20):WaitForChild("Items", 20):WaitForChild("Parrying Dagger", 20)
        Parry.remote = pd:WaitForChild("parry", 10)
        -- sengaja ga didaftarin ke Spy: parry ga boleh lewat hook, biar sama persis kayak script lama
        -- args asli game: (success, cooldown, permanent, chained, character)
        pd:WaitForChild("parryResult", 10).OnClientEvent:Connect(function(success, cooldown, permanent, chained)
            local cd = tonumber(cooldown)
            if cd and cd > 0 then Parry.cdUntil = os.clock() + cd end
            if chained == true then Parry.cdUntil = 0 end   -- parry nyambung: game ngehapus cooldown
            log("PARRY", "result success=" .. tostring(success) .. " cd=" .. tostring(cooldown)
                .. (permanent and " permanent" or "") .. (chained == true and " chained" or ""))
        end)
    end)
    while alive() do
        pcall(hookHealth)
        if CFG.parry.enabled then
            for _, k in ipairs(killers()) do watchKiller(k) end
        end
        task.wait(1)
    end
end)

