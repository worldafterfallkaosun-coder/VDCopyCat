-- statistik frame time: rata-rata, 1% low, terendah, tertinggi
function K.fpsStats()
    local buf = FT.buf
    local now = os.clock()
    -- v13.9: hasil di-cache 0.4 dtk (capWatch / abTick / UI manggil bareng) dan array kerja dipakai ulang (nol alokasi array)
    if FT.cache and FT.cacheBuf == buf and now - FT.cacheAt < 0.4 then return FT.cache end
    local c = #buf
    if c < 30 then return nil end
    local arr = FT.work
    if not arr then arr = {}; FT.work = arr end
    local sum = 0
    for i = 1, c do local d = buf[i]; arr[i] = d; sum = sum + d end
    for i = #arr, c + 1, -1 do arr[i] = nil end
    table.sort(arr)
    local lowN = math.max(1, math.floor(c * 0.01))
    local ls = 0
    for i = c - lowN + 1, c do ls = ls + arr[i] end
    local k10 = math.max(1, math.ceil(c * 0.1))
    local res = { avg = c / sum, min = 1 / math.max(arr[c], 1e-4), max = 1 / math.max(arr[1], 1e-4), low1 = lowN / math.max(ls, 1e-4), hi = 1 / math.max(arr[k10], 1e-4) }
    FT.cache, FT.cacheBuf, FT.cacheAt = res, buf, now
    return res
end

-- v13.9: true kalau frame terakhir nggak hitch; poll berat ditunda pas frame lagi berat
function K.calm()
    local dt = FT.buf[FT.n]
    return dt == nil or dt < 0.034
end

