end)
function V.arcAim(dx,dy,dz)
local S,G,B=FLASK.S,FLASK.G,FLASK.B
local wx,wy,wz,tp,reach=ballistic(dx,dy,dz,S,G)
local k=B*wy+math.sqrt(math.max(0,1-B*B*(1-wy*wy)))
local ax,ay,az=k*wx,k*wy-B,k*wz
local m=math.sqrt(ax*ax+ay*ay+az*az)
if m<1e-6 then return wx,wy,wz,tp,reach end
local len,px,py,pz=0,0,0,0
local N=12
for i=1,N do
local tt=tp*i/N
local x,y,z=wx*S*tt,wy*S*tt-0.5*G*tt*tt,wz*S*tt
len=len+math.sqrt((x-px)^2+(y-py)^2+(z-pz)^2)
px,py,pz=x,y,z
end
return ax/m,ay/m,az/m,len/FLASK.travel,reach
end
function V.solve(origin,k,point)
