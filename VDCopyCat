    label(row, title, 13, TH.bone, FB, { Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, -112, 0, 20), TextTruncate = Enum.TextTruncate.AtEnd })
    local function stepBtn(txt, xoff)
        local b = new("TextButton", { Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, xoff, 0, 7),
