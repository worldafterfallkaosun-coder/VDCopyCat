-- slider anti-lag: input tiruan ke slider aslinya, dilepas lewat handler InputEnded milik Nono
function K.lagSlSet(name, mn, mx, step, v, final)
    if MOD.lag.state ~= "ready" then return end
    local api = K.nono()
    if api then
        -- cap: kalau hub megang cap (Buka batas FPS nyala) nilai Nono cuma disinkronkan, nggak ikut nyetel
        if name == "FPS Cap (bypass)" then api.SetCap(v, (not final) or env.NonoHubCap == true)
        elseif name == "Render Distance" then if final then api.SetDist(v) end end
        return
    end
    local s = LG.sl[name]
    if not s or not s.track or not s.hit or not CAP.getconnections or #MOD.lag.ended == 0 then
        if final then toast("Slider anti-lag butuh executor dengan getconnections", "warn") end
        return
    end
    local now = os.clock()
    if not final and now - s.last < 0.12 then return end
    s.last = now
    local pct = math.clamp((v - mn + step * 0.25) / (mx - mn), 0, 1)
    local pos = Vector3.new(s.track.AbsolutePosition.X + pct * s.track.AbsoluteSize.X, s.track.AbsolutePosition.Y + 3, 0)
    local function fake(state)
        return { UserInputType = Enum.UserInputType.MouseButton1, UserInputState = state, Position = pos, KeyCode = Enum.KeyCode.Unknown }
    end
    pcall(function() for _, c in ipairs(getconnections(s.hit.InputBegan)) do c:Fire(fake(Enum.UserInputState.Begin)) end end)
    for _, c in ipairs(MOD.lag.ended) do pcall(function() c:Fire(fake(Enum.UserInputState.End)) end) end
end

