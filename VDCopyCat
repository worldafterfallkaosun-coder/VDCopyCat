local function label(parent, txt, size, col, font, props)
    local p = { Text = txt, TextSize = size, TextColor3 = col, Font = font or FB, BackgroundTransparency = 1,
        BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Left }
