------------------------------------------------------------------ 4) SEMBUNYIIN UI SKILL CHECK
-- pas Auto Skill Check ON: jarum, zona, tombol Space, dll di SkillCheckPromptGui dibikin transparan tiap frame.
-- Visible / Enabled / rotasi sengaja ga disentuh, jadi game dan tracker skill check tetep jalan normal.
local hideOrig = setmetatable({}, { __mode = "k" })   -- [objek] = { prop = nilai asli }
local hideWasOn, hideErrAt = false, 0

local function forceT(d, prop)
    local cur = d[prop]
    if cur ~= 1 then
        local o = hideOrig[d]
        if not o then
            o = {}
            hideOrig[d] = o
        end
        if o[prop] == nil then o[prop] = cur end
        d[prop] = 1
    end
end

local function hideObj(d)
    if d:IsA("GuiObject") then
        forceT(d, "BackgroundTransparency")
        if d:IsA("ImageLabel") or d:IsA("ImageButton") then forceT(d, "ImageTransparency") end
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            forceT(d, "TextTransparency")
            forceT(d, "TextStrokeTransparency")
        end
    elseif d:IsA("UIStroke") then
        forceT(d, "Transparency")
    end
end

local function restoreHidden()
    for d, o in pairs(hideOrig) do
        if d.Parent then
            for prop, v in pairs(o) do pcall(function() d[prop] = v end) end
        end
        hideOrig[d] = nil
    end
end

local function hideStep()
    if not alive() then
        pcall(function() RunService:UnbindFromRenderStep("DP3_HideSkillUI") end)
        return
    end
    if not (CFG.skill.enabled and CFG.skill.hideUI) then
        if hideWasOn then
            hideWasOn = false
            restoreHidden()
        end
        return
    end
    hideWasOn = true
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    for _, n in ipairs({ "SkillCheckPromptGui", "SkillCheckPromptGui-con" }) do
        local g = pg:FindFirstChild(n)
        if g then
            for _, d in ipairs(g:GetDescendants()) do hideObj(d) end
        end
    end
end

pcall(function() RunService:UnbindFromRenderStep("DP3_HideSkillUI") end)
RunService:BindToRenderStep("DP3_HideSkillUI", Enum.RenderPriority.Last.Value, function()
    local ok, err = pcall(hideStep)
    if not ok and os.clock() - hideErrAt > 5 then
        hideErrAt = os.clock()
        log("HIDE", "error: " .. tostring(err))
    end
end)

------------------------------------------------------------------ RESET
local function resetAll()
    Gun.pending, Gun.firing, Gun.holdoff, Gun.failStreak, Gun.cycles = nil, false, 0, 0, 0
    Gun.pauseUntil, Gun.lockUntil, Gun.tierIdx, Gun.tierGood = 0, 0, 1, {}
    Gun.lockTarget, Gun.lockAng = nil, 180
    Skill.tierName, Skill.tierGood, Skill.retried, Skill.tierBad = nil, {}, false, {}
    Skill.gen = Skill.gen + 1
    unhideChecks()
    pcall(function() RunService:UnbindFromRenderStep("DP3_CamLock") end)
    notify("Reset: state gun/skill dibersihin")
end

------------------------------------------------------------------ UI
local panel, statusLabel
local function buildUI()
    local parent
    pcall(function() parent = (gethui and gethui()) or game:GetService("CoreGui") end)
    if not parent then parent = LP:WaitForChild("PlayerGui") end
    local old = parent:FindFirstChild("DP3_Gui")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn, gui.DisplayOrder, gui.IgnoreGuiInset = "DP3_Gui", false, 9999, true
    gui.Parent = parent

    local function corner(o, r)
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, r)
        c.Parent = o
    end

    local fab = Instance.new("TextButton")
    fab.Size = UDim2.fromOffset(44, 44)
    fab.Position = UDim2.new(0, 10, 0.5, -22)
    fab.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
    fab.TextColor3 = Color3.fromRGB(120, 255, 140)
    fab.Font, fab.TextSize, fab.Text = Enum.Font.GothamBold, 15, "DP"
    fab.Parent = gui
    corner(fab, 22)

    panel = Instance.new("Frame")
    panel.Size = UDim2.fromOffset(238, 0)
    panel.AutomaticSize = Enum.AutomaticSize.Y
    panel.Position = UDim2.new(0, 60, 0.5, -190)
    panel.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
    panel.BackgroundTransparency = 0.08
    panel.Visible = false
    panel.Parent = gui
    corner(panel, 10)
    local pad = Instance.new("UIPadding")
    pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 6), UDim.new(0, 6)
    pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 6), UDim.new(0, 6)
    pad.Parent = panel
    local lay = Instance.new("UIListLayout")
    lay.Padding = UDim.new(0, 4)
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    lay.Parent = panel

    local function mkBtn(parentObj, getText, onClick, width)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(width or 1, width and -2 or 0, 0, 30)
        b.Font, b.TextSize, b.TextColor3 = Enum.Font.GothamMedium, 12, Color3.new(1, 1, 1)
        b.Parent = parentObj
        corner(b, 6)
        local function refresh()
            local txt, on = getText()
            b.Text = txt
            b.BackgroundColor3 = (on == false) and Color3.fromRGB(70, 35, 35) or Color3.fromRGB(35, 60, 45)
        end
        b.MouseButton1Click:Connect(function()
            onClick()
            refresh()
        end)
        refresh()
        return b
    end
    local function onoff(v) return v and "ON" or "OFF" end
    local function cycle(list, cur)
        for i, v in ipairs(list) do
            if v == cur then return list[i % #list + 1] end
        end
        return list[1]
    end
    local function mkRow()
        local row = Instance.new("Frame")
        row.Size, row.BackgroundTransparency = UDim2.new(1, 0, 0, 30), 1
        row.Parent = panel
        local l = Instance.new("UIListLayout")
        l.FillDirection = Enum.FillDirection.Horizontal
        l.Padding = UDim.new(0, 4)
        l.Parent = row
        return row
    end

    local r1 = mkRow()
    mkBtn(r1, function() return "Parry: " .. onoff(CFG.parry.enabled), CFG.parry.enabled end,
        function() CFG.parry.enabled = not CFG.parry.enabled end, 0.5)
    mkBtn(r1, function() return "Via: " .. CFG.parry.via:upper(), true end,
        function() CFG.parry.via = (CFG.parry.via == "remote") and "input" or "remote" end, 0.5)

    local r2 = mkRow()
    mkBtn(r2, function() return "Auto Fire: " .. onoff(CFG.gun.trigger), CFG.gun.trigger end,
        function() CFG.gun.trigger = not CFG.gun.trigger end, 0.5)
    mkBtn(r2, function() return "Snap: " .. onoff(CFG.gun.snap), CFG.gun.snap end,
        function() CFG.gun.snap = not CFG.gun.snap end, 0.5)

    local r3 = mkRow()
    mkBtn(r3, function() return "Aim Lock: " .. onoff(CFG.gun.aimLock), CFG.gun.aimLock end,
        function()
            CFG.gun.aimLock = not CFG.gun.aimLock
            if not CFG.gun.aimLock then Gun.lockTarget = nil end
        end, 0.5)
    mkBtn(r3, function() return "Hide UI: " .. onoff(CFG.skill.hideUI), CFG.skill.hideUI end,
        function() CFG.skill.hideUI = not CFG.skill.hideUI end, 0.5)

    local r4 = mkRow()
    mkBtn(r4, function() return "Step: " .. (CFG.gun.fireStep == 0 and "auto" or CFG.gun.fireStep), true end,
        function() CFG.gun.fireStep = cycle({ 0, 3, 2, 1 }, CFG.gun.fireStep) end, 0.5)
    mkBtn(r4, function() return "Radius: " .. CFG.gun.hitRadius, true end,
        function() CFG.gun.hitRadius = cycle({ 1.6, 2.2, 3.0, 4.0 }, CFG.gun.hitRadius) end, 0.5)

    local r5 = mkRow()
    mkBtn(r5, function() return "Lock FOV: " .. CFG.gun.lockFov, true end,
        function() CFG.gun.lockFov = cycle({ 30, 60, 90, 180 }, CFG.gun.lockFov) end, 0.5)
    mkBtn(r5, function() return "Smooth: " .. CFG.gun.lockSmooth, true end,
        function() CFG.gun.lockSmooth = cycle({ 0.25, 0.6, 1 }, CFG.gun.lockSmooth) end, 0.5)

    local r6 = mkRow()
    mkBtn(r6, function() return "Skill: " .. onoff(CFG.skill.enabled), CFG.skill.enabled end,
        function() CFG.skill.enabled = not CFG.skill.enabled end, 0.5)
    mkBtn(r6, function() return "Reset", true end, resetAll, 0.5)

    local r7 = mkRow()
    mkBtn(r7, function() return string.format("Zona -2 (%d)", CFG.skill.offset), true end,
        function() CFG.skill.offset = CFG.skill.offset - 2 end, 0.5)
    mkBtn(r7, function() return string.format("Zona +2 (%d)", CFG.skill.offset), true end,
        function() CFG.skill.offset = CFG.skill.offset + 2 end, 0.5)

    local r8 = mkRow()
    mkBtn(r8, function() return "Copy Log", true end, function()
        notify(copy(table.concat(LOG, "\n")) and "Log disalin" or "setclipboard ga ada")
    end, 0.5)
    mkBtn(r8, function() return "Copy Dump", true end, function()
        notify(copy(Skill.lastDump) and "Dump disalin" or "setclipboard ga ada")
    end, 0.5)

    statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, 0, 0, 30)
    statusLabel.BackgroundColor3 = Color3.new(0, 0, 0)
    statusLabel.BackgroundTransparency = 0.35
    statusLabel.TextColor3 = Color3.fromRGB(255, 220, 120)
    statusLabel.Font, statusLabel.TextSize = Enum.Font.Code, 11
    statusLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel.TextWrapped = true
    statusLabel.Text = "gun: -"
    statusLabel.Parent = panel
    corner(statusLabel, 6)

    logLabel = Instance.new("TextLabel")
    logLabel.Size = UDim2.new(1, 0, 0, 60)
    logLabel.BackgroundColor3 = Color3.new(0, 0, 0)
    logLabel.BackgroundTransparency = 0.35
    logLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
    logLabel.Font, logLabel.TextSize = Enum.Font.Code, 10
    logLabel.TextXAlignment, logLabel.TextYAlignment = Enum.TextXAlignment.Left, Enum.TextYAlignment.Bottom
    logLabel.TextWrapped = true
    logLabel.Text = "log..."
    logLabel.Parent = panel
    corner(logLabel, 6)

    -- tombol bulat bisa digeser; tap = buka/tutup panel
    local dragging, moved, dragStart, startPos = false, false, nil, nil
    fab.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, moved, dragStart, startPos = true, false, i.Position, fab.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            if d.Magnitude > 8 then moved = true end
            if moved then
                fab.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
                panel.Position = UDim2.new(fab.Position.X.Scale, fab.Position.X.Offset + 50, fab.Position.Y.Scale, fab.Position.Y.Offset - 168)
            end
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    fab.MouseButton1Click:Connect(function()
        if not moved then panel.Visible = not panel.Visible end
    end)

    task.spawn(function()
        while alive() and gui.Parent do
            task.wait(0.25)
            if panel.Visible then
                if statusLabel then statusLabel.Text = "gun: " .. tostring(Gun.status) end
                if logDirty and logLabel then
                    logDirty = false
                    logLabel.Text = table.concat(LOG, "\n", math.max(1, #LOG - 8), #LOG)
                end
            end
        end
    end)
end
local okUI, errUI = pcall(buildUI)
if not okUI then print("[DP3] UI gagal: " .. tostring(errUI)) end

------------------------------------------------------------------ HOTKEYS
UIS.InputBegan:Connect(function(i, gp)
    if not alive() or gp or i.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local k = i.KeyCode
    if k == CFG.keys.parry then
        CFG.parry.enabled = not CFG.parry.enabled
        notify("Auto Parry: " .. (CFG.parry.enabled and "ON" or "OFF"))
    elseif k == CFG.keys.snap then
        CFG.gun.snap = not CFG.gun.snap
        notify("Gun Snap: " .. (CFG.gun.snap and "ON" or "OFF"))
    elseif k == CFG.keys.trig then
        CFG.gun.trigger = not CFG.gun.trigger
        notify("Gun Auto Trigger: " .. (CFG.gun.trigger and "ON" or "OFF"))
    elseif k == CFG.keys.skill then
        CFG.skill.enabled = not CFG.skill.enabled
        notify("Auto Skill Check: " .. (CFG.skill.enabled and "ON" or "OFF"))
    elseif k == CFG.keys.lock then
        CFG.gun.aimLock = not CFG.gun.aimLock
        if not CFG.gun.aimLock then Gun.lockTarget = nil end
        notify("Aim Lock: " .. (CFG.gun.aimLock and "ON" or "OFF"))
    elseif k == CFG.keys.hide then
        CFG.skill.hideUI = not CFG.skill.hideUI
        notify("Hide Skill UI: " .. (CFG.skill.hideUI and "ON" or "OFF"))
    elseif k == CFG.keys.panel and panel then
        panel.Visible = not panel.Visible
    end
end)

