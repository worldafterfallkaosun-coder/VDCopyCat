-- v10: nama team di-cache (dicek ulang kalau namanya berubah) dan daftar killer dipakai bareng dalam satu frame.
-- Dulu killers() dipanggil belasan kali per frame (Track, aim lock, ring, ESP, parry) dan tiap kali loop semua pemain + lower/find.
local TeamC = { k = setmetatable({}, { __mode = "k" }), t = -1, list = {} }

local function teamKind(t)   -- "killer" | "survivor" | "other" | "none"
    if not t then return "none" end
    local nm = t.Name
    local c = TeamC.k[t]
    if not c or c.n ~= nm then
        local l = nm:lower()
        c = { n = nm, kind = l:find("killer", 1, true) and "killer" or (l:find("surviv", 1, true) and "survivor" or "other") }
        TeamC.k[t] = c
    end
    return c.kind
end

local function amSurvivor()
    local t = LP.Team
    if not t then return true end
    return teamKind(t) == "survivor"
end

local function killers()
    local now = os.clock()
    if now - TeamC.t < 0.008 then return TeamC.list end
    local out = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local ch = p.Character
        if p ~= LP and ch and teamKind(p.Team) == "killer" then
            local hum = ch:FindFirstChildOfClass("Humanoid")
            local root = ch:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                out[#out + 1] = { player = p, char = ch, hum = hum, root = root }
            end
        end
    end
    TeamC.t, TeamC.list = now, out
    return out
end

local function angDiff(a, b)
    local d = (a - b) % 360
    if d > 180 then d = d - 360 end
    return d
end

local function nameHas(name, pats)
