local hideOrig = setmetatable({}, { __mode = "k" })
local hideWasOn, hideErrAt = false, 0

local function forceT(d, prop)
    local cur = d[prop]
    if cur ~= 1 then
        local o = hideOrig[d]
        if not o then o = {}; hideOrig[d] = o end
        if o[prop] == nil then o[prop] = cur end
        d[prop] = 1
    end
end

local function hideObj(d)
    if d:IsA("GuiObject") then
        forceT(d, "BackgroundTransparency")
        if d:IsA("ImageLabel") or d:IsA("ImageButton") then forceT(d, "ImageTransparency") end
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            forceT(d, "TextTransparency")
            forceT(d, "TextStrokeTransparency")
        end
    elseif d:IsA("UIStroke") then
        forceT(d, "Transparency")
    end
end

local function restoreHidden()
    for d, o in pairs(hideOrig) do
        if d.Parent then
            for prop, v in pairs(o) do pcall(function() d[prop] = v end) end
        end
        hideOrig[d] = nil
    end
end

