    if c and now - c.t < 0.05 then return c.v end
    local v = visibleRaw(origin, part)
    Gun.vis[part] = { t = now, v = v }
    return v
end

local Track = {}
local function trackChar(k, now)
    local pos = k.root.Position
    local tr = Track[k.char]
    if not tr then
        Track[k.char] = { pos = pos, t = now, vel = Vector3.new(0, 0, 0), grounded = true }
    else
        local dt = now - tr.t
        if dt > 0.003 then
            if dt > 0.4 or (pos - tr.pos).Magnitude > 40 then
                tr.vel = Vector3.new(0, 0, 0)
            else
                local a = 1 - math.exp(-dt / 0.06)
                tr.vel = tr.vel:Lerp((pos - tr.pos) / dt, a)
            end
            tr.pos, tr.t = pos, now
            tr.grounded = k.hum.FloorMaterial ~= Enum.Material.Air
            local h = tr.hist
            if not h then h = {}; tr.hist = h end
            h[#h + 1] = { t = now, v = tr.vel }
            while #h > 0 and now - h[1].t > 0.4 do table.remove(h, 1) end
        end
    end
end
