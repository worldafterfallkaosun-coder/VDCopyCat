--[[
    Distrik Pembantai (PlaceId 93978595733734) - Delta script
    Fitur : Auto Parry (Parrying Dagger) | Auto Aim + Auto Fire (Twist of Fate) | Auto Skill Check
    Executor: Delta (Luau)

    Hotkey (bisa diubah di CFG.keys):
        F1 = toggle Auto Parry
        F2 = toggle Auto Aim / Auto Fire gun
        F3 = toggle Auto Skill Check
        F4 = dump isi GUI skill check ke console (buat kalibrasi)

    Yang SUDAH terverifikasi dari dump:
      - Parry   : Remotes.Items["Parrying Dagger"].parry:FireServer(character)
                  syarat client: dagger ke-equip, HP >= 50%, tidak busy (trapped/hooked/carried/vault/dll)
                  tombol parry = attribute player "kb_item" (default MouseButton2)
      - Gun     : Remotes.Items["Twist of Fate"].Fire:FireServer(tool, aimDirection, stepIndex)
                  tombol aim = "kb_item" (hold), tembak = "kb_itemtrigger" (MouseButton1)
                  jam roll: step 1 jam 40%, step 2 jam 20%, step 3 jam 0%  (STEPS.at = 0.75 / 1.8 / 3.0 detik,
                  ranked 0.75 / 1.3 / 2.0) -> nahan aim sampai step 3 = ga bakal jam
      - Skill   : Remotes.Generator.SkillCheckEvent + Remotes.Healing.SkillCheckEvent (server -> client)
                  tombol = attribute "kb_skillcheck" (default Space)
      - Team    : Teams.Survivors / Teams.Killer / Teams.Spectator

    Yang BELUM ada di dump (script skill check generator & animasi serangan killer ga ke-dump karena
    dump diambil pas jadi Spectator di lobby), jadi:
      - deteksi serangan killer = heuristik animasi (tuning di CFG.parry)
      - deteksi needle/zone skill check = heuristik GUI + logger (F4 buat dump struktur aslinya)
]]

------------------------------------------------------------------ CONFIG
local CFG = {
    keys = {
        parry      = Enum.KeyCode.F1,
        gun        = Enum.KeyCode.F2,
        skillcheck = Enum.KeyCode.F3,
        dump       = Enum.KeyCode.F4,
    },

    parry = {
        enabled     = true,
        range       = 13,     -- stud: killer harus segini deket
        frontDot    = 0.35,   -- killer harus madep ke kita (dot LookVector . arahKeKita)
        delay       = 0.12,   -- jeda setelah animasi serang mulai, sebelum parry (detik)
        jitter      = 0.03,   -- acak biar ga robotik
        cooldown    = 0.6,    -- jangan spam parry
        autoEquip   = true,   -- auto equip Parrying Dagger kalau ada di Backpack
        useRemote   = false,  -- true = FireServer langsung (skip input). default simulasi tombol asli
        minPriority = Enum.AnimationPriority.Action, -- animasi killer >= ini dianggap serangan
    },

    gun = {
        enabled     = true,
        fov         = 220,    -- px dari tengah layar, target di luar ini diabaikan
        maxDist     = 140,    -- stud
        aimPart     = "UpperTorso", -- fallback: Torso / HumanoidRootPart
        smooth      = 0.35,   -- 0..1 (1 = snap instan). rendah = halus
        needLOS     = true,   -- cek garis pandang (ga ketutup tembok)
        autoFire    = true,   -- tembak otomatis kalau target pas di crosshair
        fullCharge  = 3.0,    -- detik nahan aim sebelum nembak (3.0 casual / 2.0 ranked -> no jam)
        fireTol     = 0.04,   -- toleransi sudut (radian) buat auto fire
    },

    skill = {
        enabled   = true,
        zoneHalf  = 9,        -- derajat, kalau zone lebar ga bisa dibaca dari GUI
        lead      = 0.015,    -- detik, kompensasi latency input
        verbose   = false,    -- print arg SkillCheckEvent ke console
    },
}

