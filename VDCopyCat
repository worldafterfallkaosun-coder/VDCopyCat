------------------------------------------------------------------ RING / CONE
do
    local R = { folder = nil, ring = nil, killers = {}, lastHum = nil, lastHp = 0, readyAt = -10, ready = true }
    local FLAT = 0.06

    local function dropAll()
        if R.folder then pcall(function() R.folder:Destroy() end) end
        R.folder, R.ring, R.killers = nil, nil, {}
        ENV.DP3_RINGFOLDER = nil
    end

    local function ensureFolder()
        if R.folder and R.folder.Parent then return R.folder end
        dropAll()
        local parent
        pcall(function() parent = (gethui and gethui()) or game:GetService("CoreGui") end)
        if not parent then parent = LP:FindFirstChildOfClass("PlayerGui") end
        if not parent then return nil end
        local f = Instance.new("Folder")
        f.Name = "DP3_RING"
        f.Parent = parent
        R.folder = f
        ENV.DP3_RINGFOLDER = f
        return f
    end

    local function newBox(f)
        local bx = Instance.new("BoxHandleAdornment")
        bx.Name = "ln"
        bx.ZIndex = 1
        bx.Parent = f
        return bx
    end

    do
        local old = ENV.DP3_RINGFOLDER
        if old then pcall(function() old:Destroy() end) end
    end

    task.spawn(function()
        local errAt = 0
        while alive() do
            RunService.RenderStepped:Wait()
            local ok, err = pcall(function()
                local C = CFG.ring
                local me, hum = myRoot(), myHum()
                if not (C.enabled and me and hum and hum.Health > 0 and amSurvivor()) then
                    if R.folder then dropAll() end
                    R.lastHum = nil
                    return
                end
                local f = ensureFolder()
                if not f then return end
                local now = os.clock()

                if R.lastHum ~= hum then R.lastHum, R.lastHp = hum, hum.Health end
                if C.learnRange and hum.Health < R.lastHp - 0.9 then
                    local best
                    for _, k in ipairs(killers()) do
                        local d = (k.root.Position - me.Position).Magnitude
                        if not best or d < best then best = d end
                    end
                    if best and best <= 20 and best + 1.5 > CFG.parry.range then
                        CFG.parry.range = math.clamp(best + 1.5, 8, 22)
                        log("RING", string.format("kena hit dari %.1f stud -> range %.1f", best, CFG.parry.range))
                    end
                end
                R.lastHp = hum.Health

                local range = CFG.parry.range
                local drop = (hum.HipHeight > 0 and hum.HipHeight or 2) + me.Size.Y / 2 - 0.08
                local onTop = C.onTop == true

                local near = false
                local seen = {}
                for _, k in ipairs(killers()) do
                    local dist = (k.root.Position - me.Position).Magnitude
                    local rel = k.root.CFrame:PointToObjectSpace(me.Position)
                    local fwd, lat = -rel.Z, rel.X
                    local inRange = dist <= range
                    local inCone = inRange and fwd > 0 and math.deg(math.atan2(math.abs(lat), fwd)) <= C.coneDeg
                    if inRange then near = true end
                    if C.cone and dist <= range * 3 then
                        seen[k.char] = true
                        local set = R.killers[k.char]
                        if not set then
                            set = { newBox(f), newBox(f), newBox(f) }
                            R.killers[k.char] = set
                        end
                        local kdrop = (k.hum.HipHeight > 0 and k.hum.HipHeight or 2) + k.root.Size.Y / 2 - 0.08
                        local col = inCone and C.danger or C.coneCol
                        local tr = inCone and 0.05 or 0.25
                        local th = inCone and 0.5 or 0.32
                        local ang = math.rad(C.coneDeg)
                        for i = 1, 2 do
                            local sgn = (i == 1) and -1 or 1
                            local d = Vector3.new(sgn * math.sin(ang), 0, -math.cos(ang))
                            local c = d * (range / 2) + Vector3.new(0, -kdrop, 0)
                            local bx = set[i]
                            bx.Adornee = k.root
                            bx.Size = Vector3.new(th, FLAT, range)
                            bx.CFrame = CFrame.lookAt(c, c + d)
                            bx.Color3, bx.Transparency, bx.AlwaysOnTop = col, tr, onTop
                            bx.Visible = true
                        end
                        local lk = set[3]
                        if dist <= range * 1.8 then
                            local p1 = k.root.Position - Vector3.new(0, kdrop, 0)
                            local p2 = me.Position - Vector3.new(0, drop, 0)
                            local len = (p2 - p1).Magnitude
                            if len > 0.5 then
                                lk.Adornee = me
                                lk.Size = Vector3.new(0.2, FLAT, len)
                                lk.CFrame = me.CFrame:ToObjectSpace(CFrame.lookAt((p1 + p2) / 2, p2))
                                lk.Color3, lk.Transparency, lk.AlwaysOnTop = col, inCone and 0.1 or 0.4, onTop
                                lk.Visible = true
                            else
                                lk.Visible = false
                            end
                        else
                            lk.Visible = false
                        end
                    end
                end
                for ch, set in pairs(R.killers) do
                    if not seen[ch] then
                        for _, bx in ipairs(set) do pcall(function() bx:Destroy() end) end
                        R.killers[ch] = nil
                    end
                end

                if now - R.readyAt >= 0.1 then
                    R.readyAt = now
                    if findDagger() ~= nil then
                        local okR, rd = pcall(parryReady, now)
                        R.ready = okR and rd == true
                    else
                        R.ready = true
                    end
                end
                local ring = R.ring
                if not (ring and ring.Parent) then
                    ring = Instance.new("CylinderHandleAdornment")
                    ring.Name = "ring"
                    ring.Height = FLAT
                    ring.ZIndex = 1
                    ring.Parent = f
                    R.ring = ring
                end
                local col
                if near then col = R.ready and C.inRange or C.danger
                else col = R.ready and C.ready or C.cooldown end
                local pulse = 0.5 + 0.5 * math.sin(now * (near and 8 or 3))
                ring.Adornee = me
                ring.Radius = range
                ring.InnerRadius = math.clamp(range - C.thickness, 0.1, range - 0.05)
                ring.CFrame = CFrame.new(0, -drop, 0) * CFrame.Angles(math.rad(90), 0, 0)
                ring.Color3 = col
                ring.AlwaysOnTop = onTop
                ring.Transparency = near and (0.1 + 0.15 * pulse) or (0.38 + 0.12 * pulse)
            end)
            if not ok and os.clock() - errAt > 5 then
                errAt = os.clock()
                log("RING", "error: " .. tostring(err))
            end
        end
        dropAll()
    end)
end

