    end
    say(n > 0 and "ok" or "warn", "Anti-lag Plus: " .. n .. " dari 5 opsi diterapkan")
end
function K.boostNone()
    for _, k in ipairs({ "unlock", "render3d", "quality", "light", "mute", "far", "sweep" }) do K.boostSet(k, false, true) end
    say("info", "Anti-lag Plus dipulihkan")
end
