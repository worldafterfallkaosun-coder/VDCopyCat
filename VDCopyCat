        Spy[Gun.fire] = "gun.Fire"
        local names = {}
        for _, ch in ipairs(tof:GetChildren()) do names[#names + 1] = ch.Name .. "(" .. ch.ClassName .. ")" end
        log("GUN", "remote: " .. table.concat(names, ", "))
        local seen = 0
        for _, ch in ipairs(tof:GetChildren()) do
            if ch:IsA("RemoteEvent") then
                keep(ch.OnClientEvent:Connect(function(...)
                    seen = seen + 1
