-- titik tekan buat tier "tap"/"click": tengah tombol aksi mobile (koordinat layar = koordinat GUI + inset atas)
local function tapTarget()
    local obj = findActionButton()
    if obj then
        local g = obj:FindFirstAncestorOfClass("ScreenGui")
        local inset = (g and g.IgnoreGuiInset) and 0 or GuiService:GetGuiInset().Y
        local p, s = obj.AbsolutePosition, obj.AbsoluteSize
        return p.X + s.X / 2, p.Y + s.Y / 2 + inset, obj
    end
    local cx, cy = viewCenter()
    return cx, cy, nil
end

local touchN = 0
local function tapAt(x, y, hold, mode)
    if not VIM then return false, "VIM ga ada" end
    if mode == "touch" then
        touchN = (touchN + 1) % 6
        local id = 200 + touchN
        local ok = pcall(function() VIM:SendTouchEvent(id, 0, x, y) end)
        if not ok then return false, "SendTouchEvent error" end
        task.delay(hold, function() pcall(function() VIM:SendTouchEvent(id, 2, x, y) end) end)
        return true, "touch"
    end
    local ok = pcall(function() VIM:SendMouseButtonEvent(x, y, 0, true, game, 0) end)
    if not ok then return false, "VIM mouse error" end
    task.delay(hold, function() pcall(function() VIM:SendMouseButtonEvent(x, y, 0, false, game, 0) end) end)
    return true, "mouse"
end

local VIM_RUNG = { tap = true, click = true, vim = true }   -- diproses game di frame berikutnya (butuh jendela verifikasi lebih lama)

-- tembak satu signal. firesignal kalau ada, kalau nggak getconnections + :Fire(). return jumlah yang ditembak
local function fireSig(sig, ...)
    local args = table.pack(...)
    if firesignal then
        return (pcall(firesignal, sig, table.unpack(args, 1, args.n))) and 1 or 0
    end
    if getconnections then
        local ok, conns = pcall(getconnections, sig)
        local n = 0
        if ok and conns then
            for _, c in ipairs(conns) do
                if pcall(function() c:Fire(table.unpack(args, 1, args.n)) end) then n = n + 1 end
            end
        end
        return n
    end
    return 0
end

-- tier "btn": nembak signal tombol langsung, TANPA lewat sistem input (ga kena overlay, ga butuh VIM).
-- target: tombol aksi + isinya, dan tombol di dalam GUI skill check kalau ada.
local function fireBtn()
    if not (firesignal or getconnections) then return false, "firesignal/getconnections ga ada" end
    local targets = {}
    local act = findActionButton()
    if act then
        targets[1] = act
        for _, d in ipairs(act:GetDescendants()) do
            if d:IsA("GuiObject") then targets[#targets + 1] = d end
            if #targets >= 10 then break end
        end
    end
    for _, root in ipairs(skillRoots(false)) do
        local nb = 0
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("GuiButton") and nb < 4 then
                targets[#targets + 1] = d
                nb = nb + 1
            end
        end
    end
    if #targets == 0 then return false, "ga ada tombol buat ditembak" end
    local cx, cy = tapTarget()
    local pos = Vector3.new(cx, cy, 0)
    local down, up = newInput("touch", nil, pos), newInput("touch", nil, pos)
    up.UserInputState = Enum.UserInputState.End
    local n = 0
    for _, t in ipairs(targets) do   -- tekan
        n = n + fireSig(t.InputBegan, down)
        if t:IsA("GuiButton") then n = n + fireSig(t.MouseButton1Down, cx, cy) end
    end
    for _, t in ipairs(targets) do   -- lepas
        n = n + fireSig(t.InputEnded, up)
        if t:IsA("GuiButton") then
            n = n + fireSig(t.MouseButton1Up, cx, cy)
            n = n + fireSig(t.Activated, up, 1)
            n = n + fireSig(t.MouseButton1Click)
        end
        n = n + fireSig(t.TouchTap, { Vector2.new(cx, cy) })
    end
    task.delay(0.3, function()
        pcall(function() down.__be:Destroy() end)
        pcall(function() up.__be:Destroy() end)
    end)
    return n > 0, string.format("%d signal ke %d tombol", n, #targets)
end

-- tier "game": panggil handleSkillCheck milik game langsung (Skillcheck-gen / Skillcheck-player). Fungsi itu yang
-- ngitung zona, nembak SkillCheckResultEvent dan beresin UI, jadi ga perlu simulasi input sama sekali.
local function scriptOfFn(f)
    if getfenv then
        local ok, env = pcall(getfenv, f)
        if ok and type(env) == "table" then
            local ok2, sc = pcall(function() return env.script end)
            if ok2 and typeof(sc) == "Instance" then return sc end
        end
    end
    return nil
end

local function gameFnLive(f)   -- script skill check di game nempel ke character yang lagi dipakai
    local sc = scriptOfFn(f)
    if sc then
        local c = myChar()
        return c ~= nil and sc.Parent == c
    end
    return true
end

local function refreshGameFns(force)
    local ok0 = #Skill.gameFns > 0
    for _, f in ipairs(Skill.gameFns) do
        if not gameFnLive(f) then ok0 = false break end
    end
    if ok0 and not force then return end
    local now = os.clock()
    if now - Skill.gameScanAt < 2.5 then return end
    Skill.gameScanAt = now
    if not (getgc and debug and debug.info) then return end
    local okg, list = pcall(getgc, false)
    if not okg or type(list) ~= "table" then return end
    local out, names = {}, {}
    for i = 1, #list do
        local f = list[i]
        if type(f) == "function" then
            local okn, name = pcall(debug.info, f, "n")
            if okn and name == "handleSkillCheck" and not isOurs(f) then
                local sc = scriptOfFn(f)
                local label = sc and sc.Name or (ownerOf(f) or "")
                if label:lower():find("skillcheck", 1, true) and gameFnLive(f) then
                    out[#out + 1] = f
                    names[#names + 1] = label
                end
            end
        end
    end
    Skill.gameFns = out
    log("SKILL", string.format("handler game: %d ketemu {%s}", #out, table.concat(names, ",")))
end

local function fireGameHandlers()
    local n = 0
    for _, f in ipairs(Skill.gameFns) do
        if gameFnLive(f) then
            n = n + 1
            task.spawn(pcall, f, "success")   -- game sendiri yang nentuin success/neutral/fail dari posisi jarum
        end
    end
    if n == 0 then return false, "game: ga ada handler hidup" end
    return true, string.format("game %d handler", n)
end

-- tier "down": MouseButton1Down tombol aksi tanpa argumen (handler skill check ga butuh koordinat)
local function fireActionDown()
    local act = findActionButton()
    if not act or not act:IsA("GuiButton") then return false, "tombol aksi (GuiButton) ga ketemu" end
    -- v10: jalur 1 = cuma handler milik script Skillcheck-gen / Skillcheck-player. firesignal manggil SEMUA handler tombol aksi
    -- (repair, interaksi, dll), jadi bisa ikut nyetop repair / nge-trigger aksi lain pas skill check.
    if getconnections then
        local okc, conns = pcall(getconnections, act.MouseButton1Down)
        local n = 0
        if okc and conns then
            for _, c in ipairs(conns) do
                local okf, f = pcall(function() return c.Function end)
                if okf and type(f) == "function" and not isOurs(f) then
                    local nm = (ownerOf(f) or ""):lower()
                    if nm:find("skillcheck", 1, true) then
                        task.spawn(pcall, f)
                        n = n + 1
                    end
                end
            end
        end
        if n > 0 then return true, string.format("handler skillcheck %d (getconnections)", n) end
    end
    if not firesignal then return false, "handler skillcheck ga ketemu & firesignal ga ada" end
    local ok = pcall(firesignal, act.MouseButton1Down)
    return ok, ok and "firesignal MouseButton1Down (semua handler)" or "firesignal error"
end

local function sendTier(tier, raw)
    if tier == "game" then return fireGameHandlers() end
    if tier == "down" then return fireActionDown() end
    if tier == "btn" then return fireBtn() end
    if tier == "tap" or tier == "click" then
        local x, y, obj = tapTarget()
        local ok, how = tapAt(x, y, 0.06, tier == "tap" and "touch" or "mouse")
        return ok, string.format("%s @%.0f,%.0f %s", how, x, y, obj and obj:GetFullName():match("[^%.]+%.[^%.]+$") or "tengah layar")
    end
    return press(raw, 0.06, tier, skillFilter)
end

-- urutan cara input. Dibikin pas check muncul (jeda ~0.5s sebelum jarum nyampe), bukan pas mau nekan.
local function buildLadder()
    local list = {}
    local function add(t) if not indexOf(list, t) then list[#list + 1] = t end end
    local act = findActionButton()
    local haveBtn = act ~= nil and (firesignal ~= nil or getconnections ~= nil)
    local haveOwner = false
    if getconnections then
        refreshOwners()
        haveOwner = next(Skill.owners) ~= nil
    end
    if #Skill.gameFns > 0 then add("game") end
    if act and act:IsA("GuiButton") and (firesignal or getconnections) then add("down") end
    if isMobile() then
        -- HP: skill check dipencet lewat tombol aksi, bukan Space
        if haveBtn then add("btn") end
        if VIM and act then add("tap"); add("click") end
        if haveOwner then add("owner") end
        if VIM then add("vim") end
    else
        if haveOwner then add("owner") end
        if VIM then add("vim") end
        if haveBtn then add("btn") end
        if VIM and act then add("click"); add("tap") end
    end
    if getconnections and CFG.skill.allowAll then add("all") end
    local first = Skill.tierName       -- cara yang udah terbukti masuk selalu duluan
    local at = first and indexOf(list, first)
    if at then
        table.remove(list, at)
        table.insert(list, 1, first)
    end
    return list
end

-- lead tekan (detik sebelum jarum di tengah zona). cara VIM diproses di frame berikutnya, jadi + 1 frame.
-- selisihnya dipelajari otomatis per cara (tuneDelta) dari hasil game.
local function curTune(frame)
    local t = Skill.tierName or (Skill.ladder and Skill.ladder[1]) or "?"
    local base = CFG.skill.latency + (VIM_RUNG[t] and frame or 0)
    return base + (Skill.tuneDelta[t] or 0)
end

-- tangga: coba cara input satu-satu di check yang SAMA. Tiap cara dikasih jendela singkat buat dibuktiin
-- (game ngirim Result/Fail). Ga ada hasil = cara berikutnya langsung, ga nunggu check berikutnya.
local function pressLadder()
    local raw = getBind("kb_skillcheck", "Space")
    local list = Skill.ladder or buildLadder()
    Skill.ladder = nil
    if #Skill.gameFns > 0 and not indexOf(list, "game") then table.insert(list, 1, "game") end   -- scan baru kelar setelah ladder dibikin
    if #list == 0 then
        log("SKILL", "ga ada cara kirim input (VIM/firesignal/getconnections ga ada)")
        return nil
    end
    local first = list[1]
    for idx, tier in ipairs(list) do
        local n0 = Skill.resultN
        local ln0 = Skill.cur and Skill.cur.line      -- v10: buat verifikasi mandiri (jarum berhenti = game nerima tekanan)
        if idx == 1 then Skill.snap(tier) end           -- v10: frame-snap cuma di tekanan pertama (yang tepat waktu)
        Skill.pressClock, Skill.pressTier, Skill.pressRung = os.clock(), tier, idx
        local ok, how = sendTier(tier, raw)
        log("SKILL", string.format("rung %d/%d %s: %s", idx, #list, tier, tostring(how)))
        if ok then
            local win = VIM_RUNG[tier] and CFG.skill.verifyVim or CFG.skill.verifySync
            local deadline = os.clock() + math.max(win, Net.frameDt * 3.5)
            local prev, still, frozen = (ln0 and ln0.Parent) and ln0.Rotation or nil, 0, false
            while alive() and Skill.resultN == n0 and os.clock() < deadline do
                RunService.Heartbeat:Wait()
                -- v10: verifikasi ga cuma lewat hook FireServer. Handler game ngebatalin tween jarum begitu nerima tekanan,
                -- jadi Line.Rotation berhenti berubah (tween normal geser 3-7 derajat per frame).
                if ln0 and ln0.Parent then
                    local rr = ln0.Rotation
                    if prev and math.abs(angDiff(rr, prev)) < 0.001 then still = still + 1 else still = 0 end
                    prev = rr
                    if still >= 2 then
                        frozen = true
                        break
                    end
                end
            end
            if Skill.resultN > n0 or frozen then
                Skill.tierGood[tier], Skill.tierFail[tier], Skill.tierName = true, 0, tier
                log("SKILL", string.format("rung %s MASUK (%s)", tier, Skill.resultN > n0
                    and string.format("hasil %.0f ms setelah dikirim", (Skill.lastResult - Skill.pressClock) * 1000)
                    or "jarum berhenti: game nerima tekanan, hook ga nangkep Result"))
                return tier
            end
        end
    end
    Skill.tierFail[first] = (Skill.tierFail[first] or 0) + 1
    if Skill.tierGood[first] and Skill.tierFail[first] >= 3 then
        Skill.tierGood[first], Skill.tierName = nil, nil
        log("SKILL", "rung " .. first .. " gagal 3x berturut-turut -> dilepas dari kunci")
    end
    log("SKILL", "semua rung ga ngasilin hasil di check ini")
    return nil
end

-- diagnosa tombol aksi: siapa yang ada di atasnya, handler apa yang nempel. Jalan otomatis sekali per sesi + tombol Probe.
local function skillProbe()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    local ins = GuiService:GetGuiInset()
    local cam = workspace.CurrentCamera
    log("DIAG", string.format("env mobile=%s touch=%s kb=%s VIM=%s firesignal=%s getconnections=%s inset=%.0f,%.0f view=%s",
        tostring(isMobile()), tostring(UIS.TouchEnabled), tostring(UIS.KeyboardEnabled), tostring(VIM ~= nil),
        tostring(firesignal ~= nil), tostring(getconnections ~= nil), ins.X, ins.Y,
        tostring(cam and cam.ViewportSize or "?")))
    local act = findActionButton()
    if not act then
        local names = {}
        if pg then
            for _, c in ipairs(pg:GetChildren()) do names[#names + 1] = c.Name end
        end
        log("DIAG", "tombol aksi Controls.action ga ketemu. PlayerGui: " .. table.concat(names, ", "))
        return
    end
    local sg = act:FindFirstAncestorOfClass("ScreenGui")
    local p, s = act.AbsolutePosition, act.AbsoluteSize
    log("DIAG", string.format("tombol %s %s pos=(%.0f,%.0f) size=(%.0f,%.0f) vis=%s active=%s ignoreInset=%s order=%s",
        act.ClassName, act:GetFullName():match("[^%.]+%.[^%.]+$") or act.Name, p.X, p.Y, s.X, s.Y,
        tostring(act.Visible), tostring(act.Active), tostring(sg and sg.IgnoreGuiInset), tostring(sg and sg.DisplayOrder)))
    local ok, list = pcall(function() return pg:GetGuiObjectsAtPosition(p.X + s.X / 2, p.Y + s.Y / 2) end)
    if ok and list then
        local parts = {}
        for i = 1, math.min(#list, 6) do
            local o = list[i]
