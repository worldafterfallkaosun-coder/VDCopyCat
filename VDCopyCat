-- urutan: anti-lag dulu, baru Distrik Pembantai. Hotkey bawaan Nono dikenali dari snapshot input waktu Nono diload;
-- kalau DP diload duluan, handler hotkey DP (RightShift veil dll) ikut ketangkap dan teredam.
log("Memuat anti-lag dan Distrik Pembantaiâ€¦")
K.loadMod("lag")
K.loadMod("par")

task.spawn(function()
    local tick, warned = 0, false
    while alive do
        task.wait(0.25)
        tick = tick + 1
        for _, fn in ipairs({ K.pollPar, K.pollLag }) do
            local ok, e = pcall(fn)
            if not ok and not warned then warned = true; log("Poll: " .. tostring(e), "err") end
        end
        if tick % 4 == 0 then pcall(K.pollSys) end
        local calm = K.calm() -- v13.9: poll berat ditunda kalau frame barusan hitch (maks ditunda beberapa tick)
        if tick % 2 == 0 and S.bst.far and (calm or tick % 8 == 0) then pcall(K.farStep) end
        if tick % 4 == 0 then
            if S.bst.unlock and not BOOST.probing then
                -- v13.9: cap nggak ditulis ulang tiap detik, cuma pas nilainya berubah + penegasan tiap 30 dtk
                if BOOST.capKey ~= S.bst.cap or tick % 120 == 0 then BOOST.capKey = S.bst.cap; pcall(K.setCap) end
            end
            pcall(K.capWatch)
            pcall(K.abTick)
            pcall(K.lodTick)
            if calm or tick % 16 == 0 then pcall(K.cpGuard) end
        end
        for _, r in ipairs((OPEN) and REF or REFC) do runR(r) end
        if tick % 8 == 0 and DIRTY and S.autosave then K.saveNow() end
    end
end)

