local function predictPos(part,origin)
local pos=Gun.aimOf(part,origin)
local tr=Track[part.Parent]
if not tr then return pos end
local G=CFG.gun
local base=(G.leadPing>0)and(Net.aimLag()*G.leadPing+G.leadBase+Gun.leadAdj)or 0
if base<=0 and G.lead<=0 then return pos end
local v=tr.vs or tr.vel
if tr.grounded then v=Vector3.new(v.X,0,v.Z)end
if v.Magnitude>70 then v=v.Unit*70 end
local us=G.unsteadyScale or 1
if us<1 and not Gun.steadyC(part.Parent,tr)then v=v*us end
local t=base
if G.lead>0 and G.bulletSpeed>0 then
for _=1,3 do
local p=pos+v*t
t=base+((p-origin).Magnitude/G.bulletSpeed)*G.lead
end
end
return pos+v*math.clamp(t,0,G.leadMax)
end
local function leadInfo(part,origin)
local tr=Track[part.Parent]
local spd=tr and Vector3.new(tr.vel.X,0,tr.vel.Z).Magnitude or 0
return string.format("spd %.0f lead %.0fms ping %.0fms (dipakai %.0f) fps %.0f",spd,leadTime((part.Position-origin).Magnitude)*1000,Net.rtt*1000,Net.aimLag()*1000,1/Net.frameDt)
end
local function dirTo(origin,part)
local pos=predictPos(part,origin)
local d=pos-origin
if d.Magnitude<0.01 then return nil end
local u=d.Unit
local bR,bU=Gun.biasR or 0,Gun.biasU or 0
if(bR~=0 or bU~=0)and CFG.gun.learn then
local r=u:Cross(Vector3.yAxis)
if r.Magnitude>1e-3 then
r=r.Unit
u=(u+r*bR+r:Cross(u)*bU).Unit
end
end
return u
end
local function pickSilent(origin,o)
local G=CFG.gun
local fov=G.snapFov
if G.silent then fov=math.max(fov,G.silentFov)end
local best,bestAng,bestDist,bestScore
for _,k in ipairs(killers())do
local part=pickPart(k.char)
if part then
local to=predictPos(part,origin)-origin
local dist=to.Magnitude
if dist<=G.maxDist and dist>0.5 then
local ang=math.deg(math.acos(math.clamp(o:Dot(to.Unit),-1,1)))
if ang<=fov then
local score=(G.silent and G.silentNear)and dist or ang
if(not bestScore or score<bestScore)and Gun.aimVis(origin,part)then
best,bestAng,bestDist,bestScore=part,ang,dist,score
end
end
end
end
end
return best,bestAng,bestDist
end
