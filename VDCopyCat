function Gun.steady(char)
    local tr = Track[char]
    if not tr or not tr.hist or #tr.hist < 4 then return true end
    local old, cur = tr.hist[1].v, tr.vel
    local a, b = Vector3.new(old.X, 0, old.Z), Vector3.new(cur.X, 0, cur.Z)
    local sa, sb = a.Magnitude, b.Magnitude
    if sa < 2 and sb < 2 then return true end
    if math.abs(sa - sb) > CFG.gun.steadyAcc * math.max(sa, sb, 6) then return false end
    if sa < 2 or sb < 2 then return false end
    local ang = math.deg(math.acos(math.clamp(a.Unit:Dot(b.Unit), -1, 1)))
    return ang <= CFG.gun.steadyAng
end

local function leadTime(dist)
    local G = CFG.gun
    local t = 0
    if G.leadPing > 0 then t = t + Net.rtt * G.leadPing + G.leadBase + Gun.leadAdj end
    if G.lead > 0 and G.bulletSpeed > 0 then t = t + (dist / G.bulletSpeed) * G.lead end
    return math.clamp(t, 0, G.leadMax)
end

local function predictPos(part, origin)
    local pos = part.Position
    if part.Name == "HumanoidRootPart" then pos = pos + Vector3.new(0, CFG.gun.aimYOffset or 0, 0) end
    local tr = Track[part.Parent]
    if not tr then return pos end
    local G = CFG.gun
    local base = (G.leadPing > 0) and (Net.rtt * G.leadPing + G.leadBase + Gun.leadAdj) or 0
    if base <= 0 and G.lead <= 0 then return pos end
    local v = tr.vel
    if tr.grounded then v = Vector3.new(v.X, 0, v.Z) end
    if v.Magnitude > 70 then v = v.Unit * 70 end
    local t = base
    if G.lead > 0 and G.bulletSpeed > 0 then
        for _ = 1, 3 do
            local p = pos + v * t
            t = base + ((p - origin).Magnitude / G.bulletSpeed) * G.lead
        end
    end
    return pos + v * math.clamp(t, 0, G.leadMax)
end

local function leadInfo(part, origin)
    local tr = Track[part.Parent]
    local spd = tr and Vector3.new(tr.vel.X, 0, tr.vel.Z).Magnitude or 0
    return string.format("spd %.0f lead %.0fms ping %.0fms", spd, leadTime((part.Position - origin).Magnitude) * 1000, Net.rtt * 1000)
end

local function dirTo(origin, part)
    local pos = predictPos(part, origin)
    local d = pos - origin
    if d.Magnitude < 0.01 then return nil end
    local u = d.Unit
    local bR, bU = Gun.biasR or 0, Gun.biasU or 0
    if (bR ~= 0 or bU ~= 0) and CFG.gun.learn then
        local r = u:Cross(Vector3.yAxis)
        if r.Magnitude > 1e-3 then
            r = r.Unit
            u = (u + r * bR + r:Cross(u) * bU).Unit
        end
    end
    return u
end

local function snapDir(orig, originArg)
    local origin = muzzleOrigin()
    if typeof(originArg) == "Vector3" and origin and (originArg - origin).Magnitude < 6 then origin = originArg end
    if not origin then return nil end
    local p = Gun.pending
    if p and p.Parent and os.clock() - Gun.pendingAt < 0.8 then
        local nd = dirTo(origin, p)
        if nd then
            log("HIT", string.format("kunci ke %s (%.0f stud) %s", p.Parent.Name, (p.Position - origin).Magnitude, leadInfo(p, origin)))
            if Gun.rec then Gun.rec(p, origin, nd) end
            return nd
        end
    end
    local lt = Gun.lockTarget
    if CFG.gun.aimLock and lt and lt.Parent then
        local nd = dirTo(origin, lt)
        if nd then
            log("HIT", string.format("lock -> %s (%.0f stud) %s", lt.Parent.Name, (lt.Position - origin).Magnitude, leadInfo(lt, origin)))
            if Gun.rec then Gun.rec(lt, origin, nd) end
            return nd
        end
    end
    if not CFG.gun.snap or orig.Magnitude < 0.01 then return nil end
    local o = orig.Unit
    local best, bestAng, bestDist
    for _, k in ipairs(killers()) do
        local part = pickPart(k.char)
        if part then
            local to = predictPos(part, origin) - origin
            local dist = to.Magnitude
            if dist <= CFG.gun.maxDist and dist > 0.5 then
                local ang = math.deg(math.acos(math.clamp(o:Dot(to.Unit), -1, 1)))
                if ang <= CFG.gun.snapFov and (not best or ang < bestAng) then
                    if visibleFrom(origin, part) then best, bestAng, bestDist = part, ang, dist end
                end
            end
        end
    end
    if not best then return nil end
    local nd = dirTo(origin, best)
    if nd then log("HIT", string.format("snap %.1f deg -> %s (%.0f stud) %s", bestAng, best.Parent.Name, bestDist, leadInfo(best, origin))) end
    if nd and Gun.rec then Gun.rec(best, origin, nd) end
    return nd
end

local function onGunFire(args)
    local now = os.clock()
    Gun.fireCount = Gun.fireCount + 1
    Gun.fireSeen = now
    if not Gun.selfFire then
        local t, hi = {}, 0
        for i = 1, 8 do
            if args[i] ~= nil then t[i], hi = args[i], i end
        end
        if hi >= 2 and typeof(t[2]) == "Vector3" then
            if not Gun.template then
