local SW = { orig = setmetatable({}, { __mode = "k" }), running = false, conn = nil }
local function swSet(obj, prop, val)
    local o = SW.orig[obj]
    if not o then o = {}; SW.orig[obj] = o end
    if o[prop] == nil then
        local ok, cur = pcall(function() return obj[prop] end)
        if not ok then return end
        o[prop] = cur
    end
    pcall(function() obj[prop] = val end)
end
local function swProcess(obj)
    local cls = obj.ClassName
    if cls == "Highlight" or cls == "Clouds" then swSet(obj, "Enabled", false) end
