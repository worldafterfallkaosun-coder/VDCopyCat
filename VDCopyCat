-- indikator lingkaran (gauge) dengan dua setengah lingkaran bergradien
function W.gauge(parent, D, T, pos)
    local box = new("Frame", { Size = UDim2.fromOffset(D, D), Position = pos, BackgroundTransparency = 1 }, parent)
    local inner = D - 2 * T
    local base = new("Frame", { Size = UDim2.fromOffset(inner, inner), Position = UDim2.fromOffset(T, T), BackgroundTransparency = 1 }, box)
    corner(base, inner / 2); stroke(base, WHITE, T, 0.9)
    local seq = ns(0, 0, 0.5, 0, 0.501, 1, 1, 1)
    local strokes, grads = {}, {}
    for _, right in ipairs({ true, false }) do
        local clip = new("Frame", { Size = UDim2.fromOffset(D / 2, D), Position = UDim2.fromOffset(right and D / 2 or 0, 0), BackgroundTransparency = 1, ClipsDescendants = true }, box)
        local circ = new("Frame", { Size = UDim2.fromOffset(inner, inner), Position = UDim2.fromOffset(right and (T - D / 2) or T, T), BackgroundTransparency = 1 }, clip)
        corner(circ, inner / 2)
        local st = stroke(circ, TH.brand, T, 0)
        grads[#grads + 1] = new("UIGradient", { Transparency = seq, Rotation = right and 0 or 180 }, st)
        strokes[#strokes + 1] = st
    end
    local val = label(box, "--", math.floor(D * 0.27), TH.bone, BLACK, { Size = UDim2.new(1, 0, 0, math.floor(D * 0.3)),
        Position = UDim2.new(0, 0, 0.5, -math.floor(D * 0.2)), TextXAlignment = Enum.TextXAlignment.Center })
    local cap = label(box, "FPS", 10, TH.mute, MONO, { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0.5, math.floor(D * 0.12)),
        TextXAlignment = Enum.TextXAlignment.Center })
    return function(pct, color, text, caption)
        local ang = math.clamp(pct, 0, 1) * 360
        tw(grads[1], 0.35, { Rotation = math.clamp(ang, 0, 180) })
        tw(grads[2], 0.35, { Rotation = math.clamp(ang, 180, 360) })
        for _, s in ipairs(strokes) do tw(s, 0.3, { Color = color }) end
        val.Text = text
        if caption then cap.Text = caption end
    end
end

