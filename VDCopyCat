-- kebalikan dari syarat yang dicek TwistoffateClient sebelum game mau mulai aim
-- (return nil = aman, string = alasan kenapa game bakal nolak)
local function whyNoAim(tool)
    local c, hum, root = myChar(), myHum(), myRoot()
    if not (c and hum and root) or hum.Health <= 0 then return "karakter belum siap/mati" end
    if os.clock() < Gun.pauseUntil then return "jeda (aim ditolak berulang)" end
    if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return "kamu lagi aim manual" end
    if hum.Health < hum.MaxHealth * 0.5 then return "HP < 50% (game nolak aim)" end
    if CS:HasTag(c, "Silenced") then return "Silenced" end
    if tool:GetAttribute("tofState") == "cooldown" then return "gun cooldown" end
    local shots = tool:GetAttribute("shots")
    if (shots == nil and 1 or shots) <= 0 then return "peluru habis (shots=0)" end
    if os.clock() < Gun.lockUntil then return "lock setelah jam" end
    for _, a in ipairs({ "Trapped", "IsCarried", "IsHooked" }) do
        if c:GetAttribute(a) then return a end
    end
    if LP:GetAttribute("IsDead") then return "IsDead" end
    if CS:HasTag(root, "doing action") and not aimingNow() then return "lagi action (repair/heal/vault)" end
    local ci = c:FindFirstChild("CheckInterractable")
    if ci then
        for _, a in ipairs(NO_AIM_FLAGS) do
            if ci:GetAttribute(a) then return a end
        end
    end
    if os.clock() - Gun.lastShot < CFG.gun.fireCooldown then return "jeda antar tembakan" end
    return nil
end

local function autoFire(tool, part)
    Gun.busy = true
    local aimRaw  = getBind("kb_item", "MouseButton2")
    local trigRaw = getBind("kb_itemtrigger", "MouseButton1")
    local useRemote = (CFG.input == "remote") and Gun.fire and Gun.aim and Gun.hold
    local lock = CFG.gun.lockCamera or not Gun.hookOK

    local function release()
        if useRemote then
            pcall(function() Gun.hold:FireServer(tool, false) end)
            pcall(function() Gun.aim:FireServer(tool, false) end)
        else
            sendInput(aimRaw, false)
        end
        Gun.lockPart = nil
    end

    -- 1) mulai aim. kamera BELUM dikunci: biar ketahuan game beneran masuk mode aim atau nolak
    local t0 = os.clock()
    if useRemote then
        pcall(function() Gun.hold:FireServer(tool, true) end)
        pcall(function() Gun.aim:FireServer(tool, true) end)
    else
        sendInput(aimRaw, true)
    end
    local aimOK, viaAttr = useRemote and true or false, false
    while not aimOK and os.clock() - t0 < 0.8 do
        task.wait(0.03)
        viaAttr = aimingNow()
        aimOK = viaAttr or Gun.aimSeen >= t0
    end
    if not aimOK then
        log("AUTO", "game ga nerima input aim (kb_item=" .. tostring(aimRaw) .. ") -> bukan cuma kamera, aim game ga jalan")
        dumpGun(tool, "AUTO")
        Gun.lockPart = nil     -- aim ga pernah mulai: JANGAN kirim release palsu (bisa batalin aim manualmu)
        Gun.failStreak = Gun.failStreak + 1
        if Gun.failStreak >= 3 then
            Gun.failStreak = 0
            Gun.pauseUntil = os.clock() + 10
            log("AUTO", "aim ditolak 3x berturut-turut -> auto gun jeda 10 detik")
        end
        task.wait(1.5)
        Gun.busy = false
        return
    end
    Gun.failStreak = 0

    -- 2) charge penuh (dihitung dari aim mulai)
    if lock then Gun.lockPart = part end
    local need = chargeTime() + CFG.gun.chargeMargin
    local aimT = os.clock()
    local ok = true
    while os.clock() - aimT < need do
        task.wait(0.05)
        local hum = myHum()
        if not (alive() and CFG.gun.auto and equippedGun() == tool and part.Parent and hum and hum.Health > 0) then
            ok = false
            break
        end
        if viaAttr and not aimingNow() then
            log("AUTO", "aim dibatalin game (kena damage/silenced/dll)")
            ok = false
            break
        end
    end

    -- 3) tembak + verifikasi
    if ok then
        local echo0 = Gun.echo
        local shots0, state0 = tool:GetAttribute("shots"), tool:GetAttribute("tofState")
        if useRemote then
            local origin = muzzleOrigin()
            local d = origin and dirTo(origin, part)
            if d then pcall(function() Gun.fire:FireServer(tool, d, 3) end) end
        else
            click(trigRaw, 0.04)
        end
        Gun.lastShot = os.clock()
        log("AUTO", string.format("tembak (charge %.1fs)", os.clock() - aimT))
        task.wait(0.15)
        Gun.lockPart = nil

        local accepted = false
        local tv = os.clock()
        while os.clock() - tv < CFG.gun.confirmWait do
            if Gun.echo > echo0 or tool:GetAttribute("shots") ~= shots0
                or (tool:GetAttribute("tofState") == "cooldown" and state0 ~= "cooldown") then
                accepted = true
                break
            end
            task.wait(0.05)
        end
        if accepted then
            log("AUTO", "tembakan masuk")
        else
            log("AUTO", "tembakan ga masuk (server nolak / jam) - cek Copy Log")
            dumpGun(tool, "AUTO")
        end
    end

    release()
    task.wait(CFG.gun.fireCooldown)
    Gun.busy = false
end

