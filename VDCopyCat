local function updatePlayerLOD()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local cp = cam.CFrame.Position
    local lodDist = CFG.playerLODDist * TIER_DIST[tier + 1]
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr ~= lp and plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            local far = (root.Position - cp).Magnitude > lodDist
            for _, acc in ipairs(char:GetChildren()) do
                local h = acc:IsA("Accessory") and acc:FindFirstChild("Handle")
                if h then
                    if far then
                        pset(h, "Transparency", 1)
                    else
                        local o = orig[h]
                        if o and o.Transparency ~= nil then h.Transparency = o.Transparency end
                    end
                end
            end
        end
    end
end

