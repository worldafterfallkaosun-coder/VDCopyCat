-- sama kayak TwistoffateEffects.safeOrigin: titik muncul peluru
local function muzzleOrigin()
    local root = myRoot()
    if not root then return nil end
    local nowM = os.clock()
    local mc = Gun.mzc
    if mc and mc.root == root and nowM - mc.t < 0.004 then return mc.v end
    local a = root.Position + Vector3.new(0, 1.373, 0)
    local b = (root.CFrame * CFrame.new(0.7, 1.373, -2.5)).Position
    local d = b - a
    if d.Magnitude <= 0 then return b end
    rayP.FilterDescendantsInstances = { myChar() }
    local ok, res = pcall(function()
        return workspace:Blockcast(CFrame.new(a, b), Vector3.new(0.5, 0.5, 0.5), d, rayP)
    end)
    local pos = b
    if ok and res then pos = res.Position - d.Unit * 0.5 end
    -- v9.1: posisi kamu di SERVER ketinggalan dari posisi di layar kamu (replikasi). Kalau lagi gerak, titik tembak server
    -- ada di belakang titik tembak lokal -> geser origin mundur sejauh kecepatan x originLag (dipelajari dari VisualizeBullet).
    local lag = CFG.gun.originLag
    if lag and lag > 0 then
        local v = Vector3.new(0, 0, 0)
        pcall(function() v = root.AssemblyLinearVelocity end)
        v = Vector3.new(v.X, 0, v.Z)
        if v.Magnitude > 60 then v = v.Unit * 60 end
        pos = pos - v * lag
    end
    Gun.mzc = { t = nowM, v = pos, root = root }
    return pos
end

-- survivor lain ditembus peluru (lihat aimPoint/survivorOf di game), jadi ga dianggap penghalang
local function visibleRaw(origin, part)
    local ign = { myChar(), part.Parent }
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and not (p.Team and p.Team.Name:lower():find("killer")) then
            ign[#ign + 1] = p.Character
        end
    end
    -- v9.1: sama kayak piercingBlockcast game (Blockcast 0.5 stud, nembus part transparan selain HumanoidRootPart + aksesori).
    -- Raycast tipis v9.0 bilang "keliatan" padahal Blockcast game nyangkut di sudut tembok -> peluru kena tembok.
    local o, dir = origin, part.Position - origin
    local left = dir.Magnitude
    if left < 0.5 then return true end
    for _ = 1, 8 do
        rayP.FilterDescendantsInstances = ign
        local okc, res = pcall(function()
            return workspace:Blockcast(CFrame.new(o, o + dir), Vector3.new(0.5, 0.5, 0.5), dir, rayP)
        end)
        if not okc then res = workspace:Raycast(o, dir, rayP) end
        if not res then return true end
        local inst = res.Instance
        local pierce = (inst.Transparency > 0.01 and inst.Name ~= "HumanoidRootPart")
            or inst:FindFirstAncestorWhichIsA("Accessory") ~= nil
        if not pierce then return false end
        ign[#ign + 1] = inst
        local adv = (res.Distance or 0) + 0.05
        left = left - adv
        if left <= 0.3 then return true end
        local u = dir.Unit
        o = o + u * adv
        dir = u * left
    end
    return false
end

-- v10: hasil cek halangan dipakai ulang 50 ms per killer (aim lock + findTarget manggil ini tiap frame buat tiap killer)
local function visibleFrom(origin, part)
    local now = os.clock()
    local c = Gun.vis[part]
    if c and now - c.t < 0.05 then return c.v end
    local v = visibleRaw(origin, part)
    Gun.vis[part] = { t = now, v = v }
    return v
end

-- v8.8: PREDIKSI GERAK. Kecepatan killer dihitung sendiri dari perpindahan posisi per frame (EMA, tahan lag spike).
-- Server nembak pakai posisi killer yang udah maju dari yang kamu liat (ping + interpolasi), jadi tembakan diarahkan
-- ke posisi killer di depan sejauh leadTime(). leadPing = 0 -> persis kayak v8.7 (tanpa prediksi).
local Track = {}   -- [Model karakter killer] = { pos, t, vel, grounded }
keep(RunService.Heartbeat:Connect(function()
    if not alive() then return end
    local now = os.clock()
    for _, k in ipairs(killers()) do
        local pos = k.root.Position
        local tr = Track[k.char]
        if not tr then
            Track[k.char] = { pos = pos, t = now, vel = Vector3.new(0, 0, 0), grounded = true }
        else
            local dt = now - tr.t
            if dt > 0.003 then
                if dt > 0.4 or (pos - tr.pos).Magnitude > 40 then
                    tr.vel = Vector3.new(0, 0, 0)               -- respawn / teleport: jangan dihitung sebagai kecepatan
                else
                    local a = 1 - math.exp(-dt / 0.06)
                    tr.vel = tr.vel:Lerp((pos - tr.pos) / dt, a)
                end
                tr.pos, tr.t = pos, now
                tr.grounded = k.hum.FloorMaterial ~= Enum.Material.Air
                local h = tr.hist
                if not h then
                    h = {}
                    tr.hist = h
                end
                h[#h + 1] = { t = now, v = tr.vel }
                while #h > 0 and now - h[1].t > 0.4 do table.remove(h, 1) end
            end
        end
    end
    for ch in pairs(Track) do
        if not ch.Parent then Track[ch] = nil end
    end
end))

-- v9.1: killer lagi lurus? (arah + kecepatan gerak stabil dalam ~0.4s terakhir). Prediksi cuma bisa akurat kalau iya.
function Gun.steady(char)
    local tr = Track[char]
    if not tr or not tr.hist or #tr.hist < 4 then return true end
    local old, cur = tr.hist[1].v, tr.vel
    local a, b = Vector3.new(old.X, 0, old.Z), Vector3.new(cur.X, 0, cur.Z)
    local sa, sb = a.Magnitude, b.Magnitude
    if sa < 2 and sb < 2 then return true end
    if math.abs(sa - sb) > CFG.gun.steadyAcc * math.max(sa, sb, 6) then return false end
    if sa < 2 or sb < 2 then return false end
    local ang = math.deg(math.acos(math.clamp(a.Unit:Dot(b.Unit), -1, 1)))
    return ang <= CFG.gun.steadyAng
end

local function leadTime(dist)
    local G = CFG.gun
    local t = 0
    if G.leadPing > 0 then t = t + Net.rtt * G.leadPing + G.leadBase + Gun.leadAdj end
    if G.lead > 0 and G.bulletSpeed > 0 then t = t + (dist / G.bulletSpeed) * G.lead end
    return math.clamp(t, 0, G.leadMax)
end

local function predictPos(part, origin)
    local pos = part.Position
    if part.Name == "HumanoidRootPart" then pos = pos + Vector3.new(0, CFG.gun.aimYOffset or 0, 0) end   -- v9.1: pusat badan
    local tr = Track[part.Parent]
    if not tr then return pos end
    local G = CFG.gun
    local base = (G.leadPing > 0) and (Net.rtt * G.leadPing + G.leadBase + Gun.leadAdj) or 0
    if base <= 0 and G.lead <= 0 then return pos end
    local v = tr.vel
    if tr.grounded then v = Vector3.new(v.X, 0, v.Z) end      -- lagi napak tanah: ga usah nebak naik/turun
    if v.Magnitude > 70 then v = v.Unit * 70 end              -- batas kecepatan masuk akal (dash), glitch ga bikin tembakan nyasar
    local t = base
    if G.lead > 0 and G.bulletSpeed > 0 then                  -- waktu tempuh peluru (kalau ada): diselesaikan iteratif
        for _ = 1, 3 do
            local p = pos + v * t
            t = base + ((p - origin).Magnitude / G.bulletSpeed) * G.lead
        end
    end
    return pos + v * math.clamp(t, 0, G.leadMax)
end

-- ringkasan buat log tembakan (diagnosa aim)
local function leadInfo(part, origin)
    local tr = Track[part.Parent]
    local spd = tr and Vector3.new(tr.vel.X, 0, tr.vel.Z).Magnitude or 0
    return string.format("spd %.0f lead %.0fms ping %.0fms", spd, leadTime((part.Position - origin).Magnitude) * 1000, Net.rtt * 1000)
end

local function dirTo(origin, part)
    local pos = predictPos(part, origin)
    local d = pos - origin
    if d.Magnitude < 0.01 then return nil end
    local u = d.Unit
    -- v9.1: bias arah yang dipelajari dari tembakan diam yang lewat di sebelah killer
    local bR, bU = Gun.biasR or 0, Gun.biasU or 0
    if (bR ~= 0 or bU ~= 0) and CFG.gun.learn then
        local r = u:Cross(Vector3.yAxis)
        if r.Magnitude > 1e-3 then
            r = r.Unit
            u = (u + r * bR + r:Cross(u) * bU).Unit
        end
    end
    return u
end

-- dipanggil dari hook pas game ngirim gun.Fire. orig = arah bidikan asli game
local function snapDir(orig, originArg)
    local origin = muzzleOrigin()
    -- v8.9: kalau game ngirim origin tembakan (Vector3 dekat moncong), pakai itu: server nembak dari titik itu
    if typeof(originArg) == "Vector3" and origin and (originArg - origin).Magnitude < 6 then origin = originArg end
    if not origin then return nil end

    -- 1) tembakan dari auto-trigger: target udah dipilih, arah dihitung ULANG pas ini (posisi paling baru)
    local p = Gun.pending
    if p and p.Parent and os.clock() - Gun.pendingAt < 0.8 then
        local nd = dirTo(origin, p)
        if nd then
            log("HIT", string.format("kunci ke %s (%.0f stud) %s", p.Parent.Name, (p.Position - origin).Magnitude, leadInfo(p, origin)))
            if Gun.rec then Gun.rec(p, origin, nd) end
            return nd
        end
    end

    -- 1b) aim lock aktif: tembakan apapun (manual atau trigger) diarahkan ke badan target kunci
    local lt = Gun.lockTarget
    if CFG.gun.aimLock and lt and lt.Parent then
        local nd = dirTo(origin, lt)
        if nd then
            log("HIT", string.format("lock -> %s (%.0f stud) %s", lt.Parent.Name, (lt.Position - origin).Magnitude, leadInfo(lt, origin)))
            if Gun.rec then Gun.rec(lt, origin, nd) end
            return nd
        end
    end

    -- 2) tembakan manual: belok kalau killer deket arah bidikan
    if not CFG.gun.snap or orig.Magnitude < 0.01 then return nil end
    local o = orig.Unit
    local best, bestAng, bestDist
    for _, k in ipairs(killers()) do
        local part = pickPart(k.char)
        if part then
            local to = predictPos(part, origin) - origin
            local dist = to.Magnitude
            if dist <= CFG.gun.maxDist and dist > 0.5 then
                local ang = math.deg(math.acos(math.clamp(o:Dot(to.Unit), -1, 1)))
                if ang <= CFG.gun.snapFov and (not best or ang < bestAng) then
                    if visibleFrom(origin, part) then best, bestAng, bestDist = part, ang, dist end
                end
            end
        end
    end
    if not best then return nil end
    local nd = dirTo(origin, best)
    if nd then log("HIT", string.format("snap %.1f deg -> %s (%.0f stud) %s", bestAng, best.Parent.Name, bestDist, leadInfo(best, origin))) end
    if nd and Gun.rec then Gun.rec(best, origin, nd) end
    return nd
end

local function onGunFire(args)
    local now = os.clock()
    Gun.fireCount = Gun.fireCount + 1
    Gun.fireSeen = now
    if not Gun.selfFire then   -- simpen format argumen tembakan asli (dipakai tier "remote")
        local t, hi = {}, 0
        for i = 1, 8 do
            if args[i] ~= nil then t[i], hi = args[i], i end
        end
        if hi >= 2 and typeof(t[2]) == "Vector3" then
            if not Gun.template then
                local ty = {}
                for i = 1, hi do ty[i] = typeof(t[i]) end
                log("GUN", "format remote ketangkep: " .. table.concat(ty, ", "))
            end
            Gun.template, Gun.templateN = t, hi
        end
    end
    Gun.chargeStart = now            -- charge mulai ulang dari tembakan (sama kayak game)
    if amSurvivor() and typeof(args[2]) == "Vector3" then
        local nd = snapDir(args[2], args[1])
        if nd then args[2] = nd end
    end
    Gun.pending = nil
end

local oldNC
local function hookBody(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" then
        local name = Spy[self]
        if name and alive() then
            local n = select("#", ...)
            local args = { ... }
            inHook = true
            if name == "gun.Fire" then pcall(onGunFire, args) end
            if name == "Generator.Result" or name == "Healing.Result"
                or name == "Generator.Fail" or name == "Healing.Fail" then
                pcall(SkillHook.judged, args, name)
            end
            pcall(logSpy, name, args, n)
            inHook = false
            setnamecallmethod(method)
            return oldNC(self, table.unpack(args, 1, n))
        end
    end
    return oldNC(self, ...)
end

local function installHook()
    if not (hookmetamethod and getnamecallmethod and setnamecallmethod and newcclosure) then
        log("HOOK", "executor ga support hookmetamethod -> snap/kunci arah ga jalan")
        return false
    end
    -- v10: hook dipasang SEKALI per sesi executor. Reload cuma ganti isi dispatcher (v9.1: tiap reload nambah 1 lapis hook).
    local D = ENV.DP3_HOOKD
    if type(D) == "table" and D.oldNC then
        oldNC = D.oldNC
        D.fn = hookBody
        log("HOOK", "dispatcher lama dipakai ulang (reload)")
        return true
    end
    local ok, err = pcall(function()
        local D2 = { fn = hookBody }
        ENV.DP3_HOOKD = D2
        D2.oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local f = D2.fn
            if f then return f(self, ...) end
            return D2.oldNC(self, ...)
        end))
        oldNC = D2.oldNC
    end)
    if not ok then
        ENV.DP3_HOOKD = nil
        log("HOOK", "gagal: " .. tostring(err))
    end
    return ok
end
