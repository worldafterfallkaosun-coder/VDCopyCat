local function parseBind(raw)
    if raw == "MouseButton1" then return "mouse", 0 end
    if raw == "MouseButton2" then return "mouse", 1 end
    local ok, kc = pcall(function() return Enum.KeyCode[raw] end)
    if ok and kc then return "key", kc end
    return nil
end

local function getBind(attr, default)
    local raw = LP:GetAttribute(attr)
    if type(raw) ~= "string" or raw == "" then raw = default end
    return raw
end

local function viewCenter()
    local cam = workspace.CurrentCamera
    local s = cam and cam.ViewportSize or Vector2.new(800, 600)
    return s.X / 2, s.Y / 2
end

local function newInput(kind, v, pos)
    local cx, cy = viewCenter()
    local utype, kcode
    if kind == "mouse" then
        utype = (v == 0) and Enum.UserInputType.MouseButton1 or Enum.UserInputType.MouseButton2
        kcode = Enum.KeyCode.Unknown
    elseif kind == "touch" then
        utype = Enum.UserInputType.Touch
        kcode = Enum.KeyCode.Unknown
    else
        utype = Enum.UserInputType.Keyboard
        kcode = v
    end
    local be = Instance.new("BindableEvent")
    local obj = {
        UserInputType  = utype,
        KeyCode        = kcode,
        UserInputState = Enum.UserInputState.Begin,
        Position       = pos or Vector3.new(cx, cy, 0),
        Delta          = Vector3.new(0, 0, 0),
        Changed        = be.Event,
    }
    function obj:GetPropertyChangedSignal() return be.Event end
    function obj:IsModifierKeyDown() return false end
    obj.__be = be
    return obj
end

local function setState(obj, st)
    obj.UserInputState = st
    pcall(function() obj.__be:Fire("UserInputState") end)
end

local function isOurs(f)
    if not isexecutorclosure then return false end
    local ok, r = pcall(isexecutorclosure, f)
    return ok and r == true
end

local ownerCache = setmetatable({}, { __mode = "k" })
local function ownerOf(f)
    local c = ownerCache[f]
    if c ~= nil then return c or nil end
    local name
    if debug and debug.info then
        local ok, s = pcall(debug.info, f, "s")
        if ok and type(s) == "string" and s ~= "" and s ~= "[C]" then name = s end
    end
    if not name and getfenv then
        local ok, env = pcall(getfenv, f)
        if ok and type(env) == "table" then
            local ok2, sc = pcall(function() return env.script end)
            if ok2 and typeof(sc) == "Instance" then name = sc:GetFullName() end
        end
    end
    ownerCache[f] = name or false
    return name
end

local function fireHandlers(sig, obj, filter)
    if ENV.DP3_NOFIRE then return 0, 0 end
    local ok, conns = pcall(getconnections, sig)
    if not ok or not conns then return 0, 0 end
    local n, total = 0, 0
    for _, c in ipairs(conns) do
        local okf, f = pcall(function() return c.Function end)
        local en = true
        pcall(function() if c.Enabled == false then en = false end end)
        if en and okf and type(f) == "function" and not isOurs(f) then
            total = total + 1
            if (not filter) or filter(ownerOf(f) or "") then
                task.spawn(pcall, f, obj, false)
                n = n + 1
            end
        end
    end
    return n, total
end

local function press(raw, hold, tier, filter)
    local kind, v = parseBind(raw)
    if not kind then return false, "bind ga dikenal: " .. tostring(raw) end
    hold = hold or 0.04
    tier = tier or "all"

    if tier == "vim" then
        if not VIM then return false, "VIM ga ada" end
        local cx, cy = viewCenter()
        local ok = pcall(function()
            if kind == "mouse" then VIM:SendMouseButtonEvent(cx, cy, v, true, game, 0)
            else VIM:SendKeyEvent(true, v, false, game) end
        end)
        if not ok then return false, "VIM error" end
        task.delay(hold, function()
            pcall(function()
                if kind == "mouse" then VIM:SendMouseButtonEvent(cx, cy, v, false, game, 0)
                else VIM:SendKeyEvent(false, v, false, game) end
            end)
        end)
        return true, "vim"
    end

    if not getconnections then return false, "getconnections ga ada" end
    local flt = (tier == "owner") and filter or nil
    local obj = newInput(kind, v)
    local n, total = fireHandlers(UIS.InputBegan, obj, flt)
    if n == 0 then
        pcall(function() obj.__be:Destroy() end)
        return false, string.format("%s: ga ada handler (0/%d)", tier, total)
    end
    task.delay(hold, function()
        setState(obj, Enum.UserInputState.End)
        fireHandlers(UIS.InputEnded, obj, flt)
        task.delay(0.05, function() pcall(function() obj.__be:Destroy() end) end)
    end)
    return true, string.format("%s %d/%d handler", tier, n, total)
end

