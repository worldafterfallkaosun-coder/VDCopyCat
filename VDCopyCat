-- v13.9: penjelajah workspace bertahap (DFS pakai GetChildren, dibatasi waktu per frame); isi antrean sama dengan GetDescendants dulu
function NX.stepWalk(t0, lim)
    local w = NX.walk
    if not w then return end
    local stack, sp = w.stack, w.sp
    while sp > 0 do
        local node = stack[sp]
        stack[sp] = nil
        sp -= 1
        local ok, kids = pcall(node.GetChildren, node)
        if ok then
            local n = #kids
            for i = 1, n do
                local c = kids[i]
                qt += 1
                queue[qt] = c
                sp += 1
                stack[sp] = c
            end
            nukeTotal += n
        end
        if os.clock() - t0 > lim then break end
    end
    w.sp = sp
    if sp == 0 then NX.walk = nil end
end

local lodTimer, adaptTimer, logTimer = 0, 0, 0
trackConn(RunService.Heartbeat:Connect(function(dt)
    if not applied then return end
    local t0 = os.clock()
    -- v13.7: budget nuke ngikut frame time (2.5 ms di 144 fps, maks 4 ms) supaya Apply nggak bikin frame time melonjak
    local budget = nukeActive and math.clamp(dt * 0.25, 0.0015, 0.004) or 0.001

    if NX.walk then NX.stepWalk(t0, budget * 0.4) end
    while qh <= qt and os.clock() - t0 < budget do
        local obj = queue[qh]
        queue[qh] = nil
        qh += 1
        if obj.Parent then pcall(processObject, obj, freshSet[obj]) end
        freshSet[obj] = nil
        nukeDone += 1
    end
    if qh > qt and qt > 0 then queue, qh, qt = {}, 1, 0 end

    local n = #parts
    local cam = workspace.CurrentCamera
    if n > 0 and cam then
        local cp = cam.CFrame.Position
        local far = userDist * TIER_DIST[tier + 1]
        local near = far * 0.85
        local i = cursor
        local tc = os.clock()
        for k = 1, math.min(n, math.max(400, math.floor(n / 30))) do
            -- v13.7: satu pass culling dibatasi ~0.8 ms per frame supaya nggak ngegedein frame time di map besar
            if k % 64 == 0 and os.clock() - tc > 0.0008 then break end
            i = i % n + 1
            local p = parts[i]
            -- Ukuran part dikurangi dari jarak supaya lantai besar tidak ikut hilang (radius di-cache).
            local d = (p.Position - cp).Magnitude - (radius[p] or 0)
            if d > far then
                if not culled[p] then
                    culled[p] = true
                    culledN += 1
                    set(p, "Transparency", 1)
                end
            elseif d < near and culled[p] then
                culled[p] = nil
                culledN -= 1
                local o = orig[p]
                if o and o.Transparency ~= nil then p.Transparency = o.Transparency end
            end
        end
        cursor = i
    end

    if nukeActive then
        logTimer += dt
        if logTimer >= 0.25 then
            logTimer = 0
            log("nuking " .. math.min(nukeDone, nukeTotal) .. "/" .. nukeTotal)
        end
        if qh > qt and not NX.walk then NX.onNukeDone() end
        return
    end

    lodTimer += dt
    if lodTimer >= 1 then lodTimer = 0; updatePlayerLOD() end
    adaptTimer += dt
    if adaptTimer >= 3 then adaptTimer = 0; NX.adaptiveStep() end
end))

