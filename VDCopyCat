    panel = Instance.new("Frame")
    panel.Size = UDim2.fromOffset(238, 0)
    panel.AutomaticSize = Enum.AutomaticSize.Y
    panel.Position = UDim2.new(0, 60, 0.5, -170)
    panel.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
    panel.BackgroundTransparency = 0.08
    panel.Visible = false
    panel.Parent = gui
    corner(panel, 10)
    local pad = Instance.new("UIPadding")
    pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 6), UDim.new(0, 6)
    pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 6), UDim.new(0, 6)
    pad.Parent = panel
    local lay = Instance.new("UIListLayout")
    lay.Padding = UDim.new(0, 4)
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    lay.Parent = panel

    local function mkBtn(parentObj, getText, onClick, width)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(width or 1, width and -2 or 0, 0, 30)
        b.Font, b.TextSize, b.TextColor3 = Enum.Font.GothamMedium, 12, Color3.new(1, 1, 1)
        b.Parent = parentObj
        corner(b, 6)
        local function refresh()
            local txt, on = getText()
            b.Text = txt
            b.BackgroundColor3 = (on == false) and Color3.fromRGB(70, 35, 35) or Color3.fromRGB(35, 60, 45)
        end
        b.MouseButton1Click:Connect(function()
            onClick()
            refresh()
        end)
        refresh()
        return b
    end
    local function onoff(v) return v and "ON" or "OFF" end

    mkBtn(panel, function() return "Auto Parry: " .. onoff(CFG.parry.enabled), CFG.parry.enabled end,
        function() CFG.parry.enabled = not CFG.parry.enabled end)
    mkBtn(panel, function() return "Parry via: " .. CFG.parry.via:upper(), true end,
        function() CFG.parry.via = (CFG.parry.via == "remote") and "input" or "remote" end)
    mkBtn(panel, function() return "Gun Auto-Hit: " .. onoff(CFG.gun.hit), CFG.gun.hit end,
        function() CFG.gun.hit = not CFG.gun.hit end)
    mkBtn(panel, function() return "Gun Auto Fire: " .. onoff(CFG.gun.auto), CFG.gun.auto end,
        function() CFG.gun.auto = not CFG.gun.auto end)
    mkBtn(panel, function() return "Skill Check: " .. onoff(CFG.skill.enabled), CFG.skill.enabled end,
        function() CFG.skill.enabled = not CFG.skill.enabled end)
