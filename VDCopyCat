local NO_AIM_FLAGS = { "isVaulting", "isSliding", "isDroppingPallet", "isRepairing", "isHealing", "isUnhooking", "isExiting" }

local function equippedGun()
    local c = myChar()
    if not c then return nil end
    local t = c:FindFirstChild("Twist of Fate")
    if t then return t end
    for _, v in ipairs(c:GetChildren()) do
        if v:IsA("Tool") and (v:GetAttribute("tofState") ~= nil or v:GetAttribute("shots") ~= nil
            or v:GetAttribute("tofRoll") ~= nil or v.Name:lower():find("twist")) then
            return v
        end
    end
    return nil
end

local function aimingNow()
    local c = myChar()
    return c ~= nil and c:GetAttribute("Aiming") == true
end

local TuningMod, EffectsMod
local function tuning()
    if TuningMod == nil then
        local ok, t = pcall(function() return require(RS.Modules.Items.TwistOfFate.TwistoffateTuning) end)
        TuningMod = (ok and t) or false
    end
    return TuningMod or nil
end

-- v8.9: catat tuning gun dari game ke log (diagnosa aim). Kalau ada kecepatan peluru -> dipakai buat prediksi waktu tempuh.
local function dumpTune()
    local T = tuning()
    if not T then
        log("TUNE", "TwistoffateTuning ga kebaca")
        return
    end
    local parts, speed, speedKey = {}, nil, nil
    for k, v in pairs(T) do
        local tv = type(v)
        if tv == "number" or tv == "boolean" or tv == "string" then
            parts[#parts + 1] = tostring(k) .. "=" .. tostring(v)
            if tv == "number" and type(k) == "string" then
                local lk = k:lower()
                if (lk:find("bullet") or lk:find("projectile") or lk:find("shot")) and (lk:find("speed") or lk:find("vel")) and v > 20 then
                    speed, speedKey = v, k
                end
            end
        elseif tv == "table" then
            local sub = {}
            for k2, v2 in pairs(v) do
                if type(v2) == "number" or type(v2) == "boolean" then sub[#sub + 1] = tostring(k2) .. "=" .. tostring(v2) end
                if #sub >= 6 then break end
            end
            parts[#parts + 1] = tostring(k) .. "={" .. table.concat(sub, ",") .. "}"
        end
    end
    table.sort(parts)
    local line = ""
    for _, p in ipairs(parts) do
        if #line + #p > 230 then
            log("TUNE", line)
            line = ""
        end
        line = line .. (line == "" and "" or " | ") .. p
    end
    if line ~= "" then log("TUNE", line) end
    if speed and CFG.gun.autoTravel then
        CFG.gun.bulletSpeed, CFG.gun.lead = speed, 1
        log("TUNE", string.format("kecepatan peluru %s = %.0f -> waktu tempuh dipakai di prediksi", tostring(speedKey), speed))
    end
    local okE, m = pcall(function() return require(RS.Modules.Items.TwistOfFate.TwistoffateEffects) end)
    if okE and type(m) == "table" then
        local ks = {}
        for k, v in pairs(m) do ks[#ks + 1] = tostring(k) .. (type(v) == "function" and "()" or "") end
        table.sort(ks)
        log("TUNE", "Effects: " .. table.concat(ks, ", "))
    end
end
task.spawn(function()
    task.wait(3)
    if alive() then pcall(dumpTune) end
end)

-- (waktu charge, batas jam kalau ada peluru, batas macet kalau peluru habis) buat step n
local function stepInfo(n)
    local T = tuning()
    local s = T and T.STEPS and T.STEPS[n]
    if s and type(s.at) == "number" then return s.at, s.jam or 0, s.empty or 0 end
    local ranked = RS:GetAttribute("RankedMode") == true
    local defs = { { 0.75, 0.4, 0.8 }, { ranked and 1.3 or 1.8, 0.2, 0.65 }, { ranked and 2.0 or 3.0, 0, 0.5 } }
    local d = defs[n] or defs[3]
    return d[1], d[2], d[3]
end

-- arah tembak PERSIS yang bakal dipakai game kalau kamu nembak sekarang (muzzle -> titik yang diliat kamera)
local function gameAimDir()
    local cam = workspace.CurrentCamera
    if EffectsMod == nil then
        local ok, m = pcall(function() return require(RS.Modules.Items.TwistOfFate.TwistoffateEffects) end)
        EffectsMod = (ok and m) or false
    end
    if EffectsMod and EffectsMod.aimDirection then
        local ok, d = pcall(EffectsMod.aimDirection, myChar(), cam.CFrame)
        if ok and typeof(d) == "Vector3" then return d end
    end
    return cam.CFrame.LookVector
end

-- killer yang lagi kena crosshair (jarak peluru-ke-badan <= hitRadius)
local function findTarget()
    local origin = muzzleOrigin()
    if not origin then return nil end
    local dir = gameAimDir()
    local best, bestMiss
    for _, k in ipairs(killers()) do
        local part = pickPart(k.char)
        if part then
            local to = predictPos(part, origin) - origin
            local dist = to.Magnitude
            if dist <= CFG.gun.maxDist and dist > 1 then
                local along = to:Dot(dir)
                if along > 0 then
                    local miss = (to - dir * along).Magnitude
                    if miss <= CFG.gun.hitRadius and (not bestMiss or miss < bestMiss) then
                        if (not CFG.gun.needLOS) or visibleFrom(origin, part) then
                            best, bestMiss = part, miss
                        end
                    end
                end
            end
        end
    end
    return best, bestMiss
end

-- kebalikan syarat game buat nembak (return nil = aman, string = alasan nahan)
local function whyNoShoot(tool, jam, empty)
    local c, hum, root = myChar(), myHum(), myRoot()
    if not (c and hum and root) or hum.Health <= 0 then return "karakter belum siap" end
    if os.clock() < Gun.pauseUntil then return "jeda (trigger gagal berulang)" end
    if Gun.firing then return "nunggu konfirmasi" end
    if hum.Health < hum.MaxHealth * 0.5 then return "HP < 50%" end
    if CS:HasTag(c, "Silenced") then return "Silenced" end
    if tool:GetAttribute("tofState") == "cooldown" then return "gun cooldown" end
    if os.clock() < Gun.lockUntil then return "gun macet (lock)" end
    for _, a in ipairs({ "Trapped", "IsCarried", "IsHooked" }) do
        if c:GetAttribute(a) then return a end
    end
    if LP:GetAttribute("IsDead") then return "IsDead" end
    local ci = c:FindFirstChild("CheckInterractable")
    if ci then
        for _, a in ipairs(NO_AIM_FLAGS) do
            if ci:GetAttribute(a) then return a end
        end
    end
    local shots = tool:GetAttribute("shots")
    local hasShots = (shots == nil and 1 or shots) > 0
    local roll = tool:GetAttribute("tofRoll")
    local limit = hasShots and jam or empty
    if type(roll) == "number" and type(limit) == "number" and roll < limit then
        return string.format("roll %.2f < %.2f (bakal macet)", roll, limit)
    end
    if (not hasShots) and type(roll) ~= "number" then return "peluru habis" end
    return nil
end

-- filter handler: cuma script gun
local function gunFilter(name)
    return name:find("TwistoffateClient", 1, true) ~= nil
end

local function gunTiers()
    local t = {}
    if getconnections then t[#t + 1] = "owner" end
    if VIM then t[#t + 1] = "vim" end
    if getconnections then t[#t + 1] = "all" end
    if Gun.fire and Gun.template then t[#t + 1] = "remote" end   -- baru ada setelah 1 tembakan asli kamu ketangkep
    return t
end

local function gunEscalate(why)
    local list = gunTiers()
    if #list == 0 then return end
    local cur = list[Gun.tierIdx] or list[1]
    Gun.tierIdx = Gun.tierIdx % #list + 1
    Gun.failStreak = 0
    if Gun.tierIdx == 1 then
        Gun.cycles = Gun.cycles + 1
        if Gun.cycles >= 2 then
            Gun.cycles = 0
            Gun.pauseUntil = os.clock() + 8
            log("TRIG", "semua tier gagal 2 putaran -> trigger jeda 8 detik (Copy Log)")
        end
    end
    log("TRIG", string.format("tier %s gagal (%s) -> pindah ke %s", cur, why, list[Gun.tierIdx] or "?"))
end

-- tier terakhir: kirim remote tembak langsung pakai format tembakan asli yang udah ketangkep, arah = ke target
local function fireRemote(tool, part)
    if not (Gun.fire and Gun.template) then return false, "format remote belum ketangkep (tembak manual sekali)" end
    local origin = muzzleOrigin()
    local nd = origin and dirTo(origin, part)
    if not nd then return false, "arah ga valid" end
    local n, args = Gun.templateN, {}
    for i = 1, n do
        local v = Gun.template[i]
        if typeof(v) == "Instance" and v:IsA("Tool") then v = tool end
        args[i] = v
    end
    if typeof(args[1]) == "Vector3" then args[1] = origin end
    args[2] = nd
    Gun.selfFire = true
    local ok, err = pcall(function() Gun.fire:FireServer(table.unpack(args, 1, n)) end)
    Gun.selfFire = false
    if not ok then return false, tostring(err) end
    return true, "remote langsung"
end

local function fireTrigger(tool, part)
    local list = gunTiers()
    if #list == 0 then
        Gun.pauseUntil = os.clock() + 30
        log("TRIG", "executor ga punya getconnections maupun VirtualInputManager -> trigger ga bisa")
        return
    end
    local tier = list[Gun.tierIdx] or list[1]
    local trigRaw = getBind("kb_itemtrigger", "MouseButton1")
    local before = Gun.fireCount

    Gun.firing = true
    Gun.pending, Gun.pendingAt = part, os.clock()
    local ok, how
    if tier == "remote" then
        ok, how = fireRemote(tool, part)
    else
        ok, how = press(trigRaw, 0.05, tier, gunFilter)
    end
    log("TRIG", string.format("tembak via %s (%s)", tier, tostring(how)))

    if not ok then
        Gun.pending = nil
        Gun.firing = false
        Gun.holdoff = os.clock() + 0.3
        gunEscalate("input ga masuk")
        return
    end

    task.delay(CFG.gun.confirmWait, function()
        Gun.firing = false
        if not alive() then return end
        if Gun.fireCount > before then
            Gun.tierGood[tier] = true
            Gun.failStreak = 0
            Gun.cycles = 0
            Gun.holdoff = os.clock() + CFG.gun.shotGap
            log("TRIG", "tembakan keluar (tier " .. tier .. ")")
            log("GUN", string.format("setelah tembak | shots=%s half=%s roll=%s state=%s",
                tostring(tool:GetAttribute("shots")), tostring(tool:GetAttribute("tofHalf")),
                tostring(tool:GetAttribute("tofRoll")), tostring(tool:GetAttribute("tofState"))))
        else
            Gun.pending = nil
            Gun.holdoff = os.clock() + 0.7
            Gun.failStreak = Gun.failStreak + 1
            log("TRIG", "game belum ngirim tembakan (streak " .. Gun.failStreak .. ")")
            if (not Gun.tierGood[tier]) and Gun.failStreak >= 2 then gunEscalate("2x ga keluar") end
        end
    end)
end

-- v8.8: toleransi sudut buat auto fire ngecil sesuai jarak (sudut yang ditempati hitRadius), dibatasi 1 .. fireTol derajat
local function fireTolFor(part)
    local cam = workspace.CurrentCamera
    local dist = cam and (part.Position - cam.CFrame.Position).Magnitude or 0
    if dist < 1 then return CFG.gun.fireTol end
    return math.clamp(math.deg(math.atan(CFG.gun.fireStuds / dist)), 0.4, CFG.gun.fireTol)
end

local function gunStep()
    local tool = equippedGun()
    local aiming = tool ~= nil and aimingNow()
    if aiming and not Gun.wasAiming then
        Gun.chargeStart = os.clock()
        if tool then
            log("GUN", string.format("aim mulai | shots=%s half=%s roll=%s state=%s",
                tostring(tool:GetAttribute("shots")), tostring(tool:GetAttribute("tofHalf")),
                tostring(tool:GetAttribute("tofRoll")), tostring(tool:GetAttribute("tofState"))))
        end
    end
    Gun.wasAiming = aiming

    if not tool then Gun.status = "gun ga dipegang"; return end
    if not aiming then Gun.status = "tahan aim, kamera lock ke killer sendiri"; return end
    if not CFG.gun.trigger then Gun.status = "auto fire OFF (lock/snap aja)"; return end
    if not amSurvivor() then Gun.status = "bukan survivor"; return end

    local now = os.clock()
    if now < Gun.holdoff then return end

    -- step: auto (0) = step tertinggi yang waktu charge-nya udah kecapai
    local charged = now - Gun.chargeStart
    local margin = CFG.gun.chargeMargin
    local r
    if CFG.gun.fireStep == 0 then
        for n = 1, 3 do
            if charged >= (stepInfo(n)) + margin then r = n end
        end
    elseif charged >= (stepInfo(CFG.gun.fireStep)) + margin then
        r = CFG.gun.fireStep
    end
    if not r then
        local first = (stepInfo(CFG.gun.fireStep == 0 and 1 or CFG.gun.fireStep))
        Gun.status = string.format("charge %.1f/%.1fs", charged, first + margin)
        return
    end
    local _, jam, empty = stepInfo(r)

    local why = whyNoShoot(tool, jam, empty)
    if why then
        Gun.status = "nahan: " .. why
        if why ~= Gun.lastWhyText or now - Gun.lastWhy > 4 then
            Gun.lastWhy, Gun.lastWhyText = now, why
            log("TRIG", "nahan: " .. why)
        end
        return
    end

    -- target: kalau kamera udah nempel ke target lock -> tembak. kalau belum, cek crosshair manual
    local part, miss
    local lt = Gun.lockTarget
    if CFG.gun.aimLock and lt and lt.Parent and Gun.lockAng <= fireTolFor(lt) then
        part, miss = lt, 0
    else
        part, miss = findTarget()
    end
    if not part then
        Gun.status = CFG.gun.aimLock and "siap - nunggu killer masuk jangkauan lock" or "siap - arahkan crosshair ke killer"
        return
    end
    -- v9.1: nunggu killer lurus (arah + kecepatan stabil) biar prediksi lead akurat; maksimal steadyWait detik
    local rootMe = myRoot()
    local closeRange = rootMe ~= nil and (part.Position - rootMe.Position).Magnitude <= (CFG.gun.steadyMinDist or 0)
    if CFG.gun.steady and part.Parent and not closeRange then
        if Gun.steady(part.Parent) then
            Gun.steadyAt = 0
        else
            if Gun.steadyAt == 0 then Gun.steadyAt = now end
            if now - Gun.steadyAt < CFG.gun.steadyWait then
                Gun.status = "nunggu gerak killer lurus"
                return
            end
        end
    end
    Gun.steadyAt = 0
    Gun.status = string.format("step %d | target kena -> tembak", r)
    fireTrigger(tool, part)
end

task.spawn(function()
    local acc, lastErr = 0, 0
    while alive() do
        local dt = RunService.Heartbeat:Wait()
        acc = acc + dt
        if acc >= 1 / 30 then
            acc = 0
            local ok, err = pcall(gunStep)
            if not ok and os.clock() - lastErr > 3 then
                lastErr = os.clock()
                log("GUN", "error: " .. tostring(err))
            end
        end
    end
end)

------------------------------------------------------------------ 2a) GUN BELAJAR (v9.1)
-- Server nyiarin garis peluru lewat Remotes.Items["Twist of Fate"].VisualizeBullet(origin, titikAkhir, speed, nama, tool).
-- Dari origin + titik akhir itu script tahu tembakannya kena atau meleset berapa stud, lalu mengoreksi sendiri:
--   killer gerak       -> leadAdj (lead tambahan / kurangan, detik)
--   killer diem, lewat -> biasR / biasU (koreksi arah kecil)
--   kamu gerak         -> originLag (posisi kamu di server ketinggalan berapa detik)
-- Kalau server ga ngirim ke penembak, listener ini diem (aman). Bungkus do...end biar ga nambah local di chunk utama.
do
    local function flat(v) return Vector3.new(v.X, 0, v.Z) end

    function Gun.rec(part, origin, nd)
        local tr = Track[part.Parent]
        local my = Vector3.new(0, 0, 0)
        local r = myRoot()
        if r then pcall(function() my = r.AssemblyLinearVelocity end) end
        Gun.last = {
            t = os.clock(), part = part, origin = origin, dir = nd, pred = predictPos(part, origin),
            vel = tr and flat(tr.vel) or Vector3.new(0, 0, 0), my = flat(my), done = false,
        }
    end

    local function evalShot(s, o, e)
        local part = s.part
        if not (part and part.Parent) then return end
        local actual = part.Position
        if part.Name == "HumanoidRootPart" then actual = actual + Vector3.new(0, CFG.gun.aimYOffset or 0, 0) end
        local d = e - o
        local len = d.Magnitude
        if len < 1 then return end
        local u = d.Unit
        local t = (actual - o):Dot(u)
        local closest = o + u * math.clamp(t, 0, len)
        local m = actual - closest
        local dist = (actual - o).Magnitude
        local hit = (e - actual).Magnitude <= 3.0
        Gun.shots = Gun.shots + 1
        if hit then Gun.hits = Gun.hits + 1 end

        local r = u:Cross(Vector3.yAxis)
        local mr, mu = 0, 0
        if r.Magnitude > 1e-3 then
            r = r.Unit
            mr, mu = m:Dot(r), m:Dot(r:Cross(u))
        end
        local spd, mySpd = s.vel.Magnitude, s.my.Magnitude
        local note = ""

        if CFG.gun.learn then
            if spd >= 5 then
                local resid = Vector3.new(actual.X - s.pred.X, 0, actual.Z - s.pred.Z)
                local along = resid:Dot(s.vel.Unit)
                if math.abs(along) <= 8 then
                    Gun.leadAdj = math.clamp(Gun.leadAdj + 0.3 * (along / spd), -0.12, 0.3)
                    note = string.format(" | lead %+.0f ms", Gun.leadAdj * 1000)
                end
            elseif spd < 1.5 and not hit and mySpd < 3 and dist >= 8
                and len >= t - 0.5 and m.Magnitude >= 0.7 and m.Magnitude <= 4 and r.Magnitude > 0.5 then
                Gun.biasR = math.clamp(Gun.biasR + 0.35 * (mr / dist), -0.06, 0.06)
                Gun.biasU = math.clamp(Gun.biasU + 0.35 * (mu / dist), -0.06, 0.06)
                note = string.format(" | bias %+.3f %+.3f", Gun.biasR, Gun.biasU)
            end
            -- origin server vs origin lokal (kita udah geser pakai originLag): selisih sepanjang arah gerak kamu = sisa lag
            if mySpd >= 6 then
                local diff = flat(s.origin - o)
                local along = diff:Dot(s.my.Unit)
                if math.abs(along) <= 3 then
                    CFG.gun.originLag = math.clamp((CFG.gun.originLag or 0) + 0.3 * (along / mySpd), 0, 0.15)
                    note = note .. string.format(" | originLag %.0f ms", CFG.gun.originLag * 1000)
                end
            end
        end

        log("TEMBAK", string.format("%s | %.0f stud | killer %.0f st/s | meleset %.1f (kanan %+.1f atas %+.1f)%s | hit %d/%d",
            hit and "KENA" or "MELESET", dist, spd, m.Magnitude, mr, mu, note, Gun.hits, Gun.shots))
    end

    task.spawn(function()
        local ev
        pcall(function()
            ev = RS:WaitForChild("Remotes", 30):WaitForChild("Items", 30)
                :WaitForChild("Twist of Fate", 30):WaitForChild("VisualizeBullet", 30)
        end)
        if not ev or not alive() then return end
        keep(ev.OnClientEvent:Connect(function(o, e, _, _, tool)
            if not alive() then return end
            local c = myChar()
            if not (c and typeof(tool) == "Instance" and (tool:IsDescendantOf(c) or tool:IsDescendantOf(LP))) then return end
            if typeof(o) ~= "Vector3" or typeof(e) ~= "Vector3" then return end
            local s = Gun.last
            if not s or s.done or os.clock() - s.t > 2.5 then return end
            s.done = true
            task.delay(CFG.gun.evalDelay or 0.1, function()
                if not alive() then return end
                local ok, err = pcall(evalShot, s, o, e)
                if not ok then log("TEMBAK", "error: " .. tostring(err)) end
            end)
        end))
    end)
end

------------------------------------------------------------------ 2b) AIM LOCK (kamera nempel ke killer, cuma pas aim)
local function blockedByAction(c)
    local ci = c:FindFirstChild("CheckInterractable")
    if ci then
        for _, a in ipairs(NO_AIM_FLAGS) do
            if ci:GetAttribute(a) then return true end
        end
    end
    for _, a in ipairs({ "Trapped", "IsCarried", "IsHooked" }) do
        if c:GetAttribute(a) then return true end
    end
    return false
end

local function pickLockTarget(origin, camCF)
    local look, cur = camCF.LookVector, Gun.lockTarget
    local best, bestScore, bestAng
    for _, k in ipairs(killers()) do
        local part = pickPart(k.char)
        if part then
            local to = predictPos(part, origin) - camCF.Position
            local dist = to.Magnitude
            if dist <= CFG.gun.maxDist and dist > 1 then
                local ang = math.deg(math.acos(math.clamp(look:Dot(to.Unit), -1, 1)))
                local isCur = (part == cur)
                local score = ang - (isCur and 8 or 0)          -- target lama dikasih bonus biar ga loncat-loncat
                if ang <= CFG.gun.lockFov * (isCur and 1.4 or 1) and (not bestScore or score < bestScore)
                    and ((not CFG.gun.needLOS) or visibleFrom(origin, part)) then
                    best, bestScore, bestAng = part, score, ang
                end
            end
        end
    end
    return best, bestAng
end

local lockErrAt, lockNameSeen = 0, nil
local function aimLockStep(dt)
    if not alive() then
        pcall(function() RunService:UnbindFromRenderStep("DP3_AimLock") end)
        return
    end
    local c, hum = myChar(), myHum()
    local tool = c and equippedGun()
    if not (CFG.gun.aimLock and tool and aimingNow() and amSurvivor())
        or not hum or hum.Health <= 0 or blockedByAction(c) then
        Gun.lockTarget, Gun.lockAng, lockNameSeen = nil, 180, nil     -- ga aim = lepas total, kamera 100% balik ke kamu
        return
    end
    local cam = workspace.CurrentCamera
    local origin = muzzleOrigin()
    if not (cam and origin) then return end

    local cf = cam.CFrame
    local part, ang = pickLockTarget(origin, cf)
    Gun.lockTarget = part
    if not part then
        Gun.lockAng, lockNameSeen = 180, nil
        return
    end
    Gun.lockAng = ang
    if lockNameSeen ~= part.Parent then
        lockNameSeen = part.Parent
        log("LOCK", string.format("nempel ke %s (%.0f deg)", part.Parent.Name, ang))
    end

    local goal = (predictPos(part, origin) - cf.Position).Unit
    local a = 1 - (1 - math.clamp(CFG.gun.lockSmooth, 0.02, 1)) ^ (math.clamp(dt, 0, 0.1) * 60)
    local nl = cf.LookVector:Lerp(goal, a)
    if nl.Magnitude < 0.01 then nl = goal end
    cam.CFrame = CFrame.lookAt(cf.Position, cf.Position + nl.Unit)
end

pcall(function() RunService:UnbindFromRenderStep("DP3_AimLock") end)
RunService:BindToRenderStep("DP3_AimLock", Enum.RenderPriority.Camera.Value + 1, function(dt)
    local ok, err = pcall(aimLockStep, dt)
    if not ok and os.clock() - lockErrAt > 4 then
        lockErrAt = os.clock()
        log("LOCK", "error: " .. tostring(err))
    end
end)

