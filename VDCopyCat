-- ---------- lindungi tampilan karakter dari pembersih tekstur ----------
local CP = { orig = setmetatable({}, { __mode = "k" }), par = setmetatable({}, { __mode = "k" }), running = false, conn = nil }
local function cpIsChar(obj)
    local m = obj:FindFirstAncestorOfClass("Model")
    while m do
        if m:FindFirstChildOfClass("Humanoid") then return true end
        m = m:FindFirstAncestorOfClass("Model")
    end
    return false
end
local function cpSnap(obj)
    if CP.orig[obj] or CP.par[obj] then return end
    pcall(function()
        local c = obj.ClassName
        if obj:IsA("MeshPart") then CP.orig[obj] = { TextureID = obj.TextureID }
        elseif c == "Decal" or c == "Texture" then CP.orig[obj] = { Transparency = obj.Transparency }
        elseif c == "SpecialMesh" then CP.orig[obj] = { TextureId = obj.TextureId }
        elseif c == "SurfaceAppearance" then CP.par[obj] = obj.Parent end
    end)
end
-- v13.7: cuma kelas yang memang disnapshot cpSnap yang dicek (dulu SEMUA descendant baru, termasuk tiap partikel / part efek,
-- ikut jalanin FindFirstAncestorOfClass bertingkat)
local CPC = { MeshPart = true, Decal = true, Texture = true, SpecialMesh = true, SurfaceAppearance = true }
function K.cpStart()
    if CP.running then return true end
    CP.running = true
    CP.conn = track(workspace.DescendantAdded:Connect(function(o)
        if CP.running and CPC[o.ClassName] and cpIsChar(o) then cpSnap(o) end
    end))
    task.spawn(function()
        for _, pl in ipairs(Players:GetPlayers()) do
            local ch = pl.Character
            if ch then for _, d in ipairs(ch:GetDescendants()) do cpSnap(d) end end
        end
    end)
    return true
end
function K.cpStop()
    CP.running = false
    if CP.conn then pcall(function() CP.conn:Disconnect() end); CP.conn = nil end
    CP.orig = setmetatable({}, { __mode = "k" })
    CP.par = setmetatable({}, { __mode = "k" })
    return true
end
-- kembalikan hanya yang DIHAPUS pembersih (tekstur kosong, decal transparan, SurfaceAppearance terlepas)
-- v13.9: fungsi statis (bukan closure baru per entri) biar jalur 1 dtk ini nggak numpuk sampah buat GC
function K.cpFixOne(obj, s)
    if s.TextureID ~= nil then
        if obj.TextureID == "" and s.TextureID ~= "" then obj.TextureID = s.TextureID end
    elseif s.Transparency ~= nil then
        if obj.Transparency >= 1 and s.Transparency < 1 then obj.Transparency = s.Transparency end
    elseif s.TextureId ~= nil then
        if obj.TextureId == "" and s.TextureId ~= "" then obj.TextureId = s.TextureId end
    end
end
function K.cpFixParent(obj, par) obj.Parent = par end
function K.cpGuard()
    if not CP.running then return end
    for obj, s in pairs(CP.orig) do
        if obj.Parent then pcall(K.cpFixOne, obj, s) end
    end
    for obj, par in pairs(CP.par) do
        if obj.Parent == nil and par and par.Parent then pcall(K.cpFixParent, obj, par) end
    end
end
