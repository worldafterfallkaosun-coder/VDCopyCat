------------------------------------------------------------------ 1) AUTO PARRY
local Parry = { watched = setmetatable({}, { __mode = "k" }), last = 0, cdUntil = 0, stats = {}, remote = nil }
local BUCKETS = { 0.04, 0.08, 0.12, 0.17, 0.23, 0.30 }

local function pickBucket(key)
    local st = Parry.stats[key]
    if not st then
        st = {}
        for i = 1, #BUCKETS do st[i] = { n = 0, s = 0 } end
        Parry.stats[key] = st
    end
    if not CFG.parry.learn or math.random() < 0.2 then return math.random(1, #BUCKETS) end
    local best, bi = -1, 1
    for i = 1, #BUCKETS do
        local sc = (st[i].s + 1) / (st[i].n + 2)
        if sc > best then best, bi = sc, i end
    end
    return bi
end

local function findDagger()
    local c = myChar()
    if not c then return nil end
    local t = c:FindFirstChild("Parrying Dagger")
    if t then return t, true end
    local bp = LP:FindFirstChildOfClass("Backpack")
    t = bp and bp:FindFirstChild("Parrying Dagger")
    return t, false
end

local function parryNow(key, bi)
    if not CFG.parry.enabled then return end
    local now = os.clock()
    if now - Parry.last < CFG.parry.spacing or now < Parry.cdUntil then return end
    local hum, char = myHum(), myChar()
    if not hum or hum.Health <= 0 or not char then return end
    if hum.Health < hum.MaxHealth * 0.5 then return end   -- client game nolak parry kalau HP < 50%

    local tool, equipped = findDagger()
    if not tool then return end
    if not equipped then
        if not CFG.parry.autoEquip then return end
        hum:EquipTool(tool)
        task.wait(0.08)
    end

    Parry.last = os.clock()
    local before = char:GetAttribute("ParryLands") or 0

    if CFG.parry.via == "input" then
        click(getBind("kb_item", "MouseButton2"), 0.04)
    elseif Parry.remote then
        Parry.remote:FireServer(char)
    end

    task.delay(0.9, function()
        if not alive() then return end
        local after = (myChar() == char) and (char:GetAttribute("ParryLands") or 0) or before
        local ok = after > before
        local st = Parry.stats[key]
        if st and st[bi] then
            st[bi].n = st[bi].n + 1
            if ok then st[bi].s = st[bi].s + 1 end
        end
        log("PARRY", string.format("delay=%.2f %s", BUCKETS[bi], ok and "SUKSES" or "meleset"))
    end)
end

local function threatens(k)
    local me = myRoot()
    if not me or not k.root.Parent then return false end
    local to = me.Position - k.root.Position
    local dist = to.Magnitude
    if dist > CFG.parry.range then return false end
    if dist < 0.01 then return true end
    return k.root.CFrame.LookVector:Dot(to.Unit) >= CFG.parry.frontDot
end

local function watchKiller(k)
    local animator = k.hum:FindFirstChildOfClass("Animator")
    if not animator or Parry.watched[animator] then return end
    Parry.watched[animator] = true
    animator.AnimationPlayed:Connect(function(track)
        if not alive() or not CFG.parry.enabled or not amSurvivor() then return end
        if track.Looped then return end
        if track.Priority.Value < CFG.parry.minPriority.Value then return end
        local key = (track.Animation and track.Animation.AnimationId) or track.Name
        local bi = pickBucket(key)
        local delay = BUCKETS[bi] + (math.random() * 2 - 1) * CFG.parry.jitter
        task.delay(math.max(0, delay), function()
            if track.IsPlaying and threatens(k) then parryNow(key, bi) end
        end)
    end)
end

task.spawn(function()
    pcall(function()
        local pd = RS:WaitForChild("Remotes", 20):WaitForChild("Items", 20):WaitForChild("Parrying Dagger", 20)
        Parry.remote = pd:WaitForChild("parry", 10)
        Spy[Parry.remote] = "parry"
        pd:WaitForChild("parryResult", 10).OnClientEvent:Connect(function(success, cooldown)
            local cd = tonumber(cooldown)
            if cd and cd > 0 then Parry.cdUntil = os.clock() + cd end
            log("PARRY", "result success=" .. tostring(success) .. " cd=" .. tostring(cooldown))
        end)
    end)
    while alive() do
        if CFG.parry.enabled then
            for _, k in ipairs(killers()) do watchKiller(k) end
        end
        task.wait(1)
    end
end)

------------------------------------------------------------------ 2) GUN
local function equippedGun()
    local c = myChar()
    if not c then return nil end
    local t = c:FindFirstChild("Twist of Fate")
    if t then return t end
    for _, v in ipairs(c:GetChildren()) do
        if v:IsA("Tool") and (v:GetAttribute("tofState") ~= nil or v:GetAttribute("shots") ~= nil
            or v:GetAttribute("tofRoll") ~= nil or v.Name:lower():find("twist")) then
            return v
        end
    end
    return nil
end

local function chargeTime()
    local ok, t = pcall(function()
        local T = require(RS.Modules.Items.TwistOfFate.TwistoffateTuning)
        return T.STEPS[#T.STEPS].at
    end)
    if ok and type(t) == "number" then return t end
    return (RS:GetAttribute("RankedMode") == true) and 2.0 or 3.0
end

local function bestTarget()
    local origin = muzzleOrigin()
    if not origin then return nil end
    local best, bestD
    for _, k in ipairs(killers()) do
        local part = pickPart(k.char)
        if part then
            local d = (part.Position - origin).Magnitude
            if d <= CFG.gun.maxDist and (not bestD or d < bestD)
                and ((not CFG.gun.losAuto) or visibleFrom(origin, part)) then
                best, bestD = part, d
            end
        end
    end
    return best
end

local function gunReady(tool)
    if tool:GetAttribute("tofState") == "cooldown" then return false end
    local shots = tool:GetAttribute("shots")
    return (shots == nil and 1 or shots) > 0
end

local function autoFire(tool, part)
    Gun.busy = true
    local aimRaw  = getBind("kb_item", "MouseButton2")
    local trigRaw = getBind("kb_itemtrigger", "MouseButton1")
    local useRemote = (CFG.input == "remote") and Gun.fire and Gun.aim and Gun.hold
    local lock = CFG.gun.lockCamera or not Gun.hookOK

    if lock then Gun.lockPart = part end
    if useRemote then
        pcall(function() Gun.hold:FireServer(tool, true) end)
        pcall(function() Gun.aim:FireServer(tool, true) end)
    else
        sendInput(aimRaw, true)
    end

    local need = chargeTime() + 0.12
    local t0 = os.clock()
    local ok = true
    while os.clock() - t0 < need do
        task.wait(0.05)
        local hum = myHum()
        if not (alive() and CFG.gun.auto and equippedGun() == tool and part.Parent and hum and hum.Health > 0) then
            ok = false
            break
        end
    end

    if ok then
        if useRemote then
            local origin = muzzleOrigin()
            local d = origin and dirTo(origin, part)
            if d then pcall(function() Gun.fire:FireServer(tool, d, 3) end) end
        else
            click(trigRaw, 0.04)
        end
        log("AUTO", "tembak (charge " .. string.format("%.1f", need) .. "s)")
        task.wait(0.15)
    end

    if useRemote then
        pcall(function() Gun.hold:FireServer(tool, false) end)
        pcall(function() Gun.aim:FireServer(tool, false) end)
    else
        sendInput(aimRaw, false)
    end
    Gun.lockPart = nil
    task.wait(CFG.gun.fireCooldown)
    Gun.busy = false
end

pcall(function() RunService:UnbindFromRenderStep("DP3_CamLock") end)
RunService:BindToRenderStep("DP3_CamLock", Enum.RenderPriority.Camera.Value + 1, function()
    local p = Gun.lockPart
    if alive() and p and p.Parent then
        local cam = workspace.CurrentCamera
        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, p.Position)
    end
end)

task.spawn(function()
    local lastStatus = 0
    while alive() do
        task.wait(0.1)
        if CFG.gun.auto and not Gun.busy and amSurvivor() then
            local tool = equippedGun()
            if tool and gunReady(tool) then
                local part = bestTarget()
                if part then
                    task.spawn(function()
                        local ok, err = pcall(autoFire, tool, part)
                        if not ok then
                            log("AUTO", "error: " .. tostring(err))
                            Gun.lockPart = nil
                            Gun.busy = false
                        end
                    end)
                end
            end
        end
        if os.clock() - lastStatus > 5 then
            lastStatus = os.clock()
            if CFG.gun.auto or CFG.gun.hit then
                local tool = equippedGun()
                log("GUN", string.format("tool=%s killer=%d hook=%s surv=%s",
                    tool and tool.Name or "-", #killers(), tostring(Gun.hookOK), tostring(amSurvivor())))
            end
        end
    end
end)

------------------------------------------------------------------ 3) AUTO SKILL CHECK
local Skill = { active = false, lastDump = "(belum ada dump)" }

local function skillRoots(wide)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return {} end
    if wide then return { pg } end
    local out = {}
    for _, n in ipairs({ "SkillCheckPromptGui", "SkillCheckPromptGui-con" }) do
        local g = pg:FindFirstChild(n)
        if g then out[#out + 1] = g end
    end
    return out
end

local function collect(wide)
    local list = {}
    for _, root in ipairs(skillRoots(wide)) do
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("UIGradient") then
                list[#list + 1] = d
            elseif d:IsA("GuiObject") and not (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) then
                if d.Name ~= "Space" and d.Name ~= "key" then list[#list + 1] = d end
            end
        end
    end
    return list
end

local function absRot(o)
    if o:IsA("UIGradient") then
        local p = o.Parent
        return ((p and p:IsA("GuiObject")) and p.AbsoluteRotation or 0) + o.Rotation
    end
    return o.AbsoluteRotation
end

local function shown(o)
    local p = o
    if o:IsA("UIGradient") then
        if not o.Enabled then return false end
        p = o.Parent
    elseif (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.ImageTransparency >= 0.99 then
        return false
    end
    while p and not p:IsA("LayerCollector") do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    return true
end

local function snapshot(tag, extra)
    local lines = { string.format("=== %s  t=%.2f", tag, os.clock() % 1000) }
    if extra then lines[#lines + 1] = extra end
    local function walk(o, ind)
        for _, c in ipairs(o:GetChildren()) do
            local s = ind .. c.ClassName .. " " .. c.Name
            if c:IsA("GuiObject") then
                s = s .. string.format(" vis=%s rot=%.1f abs=%.1f size=%s", tostring(c.Visible), c.Rotation, c.AbsoluteRotation, tostring(c.Size))
                if c:IsA("ImageLabel") or c:IsA("ImageButton") then
                    s = s .. string.format(" imgT=%.2f", c.ImageTransparency)
                end
            elseif c:IsA("UIGradient") then
                s = s .. string.format(" rot=%.1f off=%s en=%s", c.Rotation, tostring(c.Offset), tostring(c.Enabled))
            end
            lines[#lines + 1] = s
            walk(c, ind .. "  ")
        end
    end
    for _, root in ipairs(skillRoots(false)) do
        lines[#lines + 1] = "# " .. root:GetFullName()
        walk(root, "  ")
    end
    Skill.lastDump = table.concat(lines, "\n")
    if writefile then pcall(writefile, "dp3_skillcheck_dump.txt", Skill.lastDump) end
end

local ZONE_NAMES = { "great", "perfect", "success", "zone", "target", "area", "good", "safe", "hit" }

local function pickNeedle(list, stats)
    local best, bestE = nil, 30
    for _, o in ipairs(list) do
        local s = stats[o]
        if s and s.n >= 3 and s.ema > bestE and o.Parent and shown(o) then best, bestE = o, s.ema end
    end
    return best
end

local function pickZone(list, stats, needle)
    local best, bestScore, bestArea
    for _, o in ipairs(list) do
        local s = stats[o]
        if s and o ~= needle and s.still >= 8 and o.Parent and shown(o) then
            local score = 0
            if nameHas(o.Name, ZONE_NAMES) then score = 3 end
            if math.abs(angDiff(s.rot, 0)) > 1 then score = score + 1 end
            if o:IsA("UIGradient") then score = score + 0.5 end
            if score >= 1 then
                local area = 0
                if o:IsA("GuiObject") then area = o.AbsoluteSize.X * o.AbsoluteSize.Y end
                if not best or score > bestScore or (score == bestScore and area < bestArea) then
                    best, bestScore, bestArea = o, score, area
                end
            end
        end
    end
    return best
end

local function skillTrack(evtInfo)
    local t0 = os.clock()
    local stats = {}
    local list, lastList, lastZone = {}, -1, -1
    local needle, zone, prevDiff
    local wide, dumped = false, false

    while os.clock() - t0 < CFG.skill.maxWait and alive() and CFG.skill.enabled do
        local dt = RunService.RenderStepped:Wait()
        local now = os.clock()

        if now - lastList > 0.25 then
            lastList = now
            if (not wide) and now - t0 > 1.2 and not needle then
                wide = true
                log("SKILL", "needle ga ketemu di SkillCheckPromptGui -> scan seluruh PlayerGui")
            end
            list = collect(wide)
        end

        for _, o in ipairs(list) do
            if o.Parent then
                local r = absRot(o)
                local s = stats[o]
                if not s then
                    stats[o] = { last = r, rot = r, n = 0, ema = 0, sv = 0, still = 0 }
                else
                    local d = angDiff(r, s.last)
                    local sp = d / math.max(dt, 1e-3)
                    s.last, s.rot, s.n = r, r, s.n + 1
                    s.ema = s.ema * 0.8 + math.abs(sp) * 0.2
                    s.sv = s.sv * 0.6 + sp * 0.4
                    if math.abs(d) < 0.05 then s.still = s.still + 1 else s.still = 0 end
                end
            end
        end

        if not dumped and now - t0 > 0.35 then
            dumped = true
            snapshot("skillcheck start", evtInfo)
        end

        if not needle or not needle.Parent or not stats[needle] or stats[needle].ema < 15 then
            needle = pickNeedle(list, stats)
            zone = nil
        end
        if needle and (not zone or not zone.Parent or now - lastZone > 0.3) then
            lastZone = now
            zone = pickZone(list, stats, needle)
        end

        if needle and zone then
            local ns, zs = stats[needle], stats[zone]
            local pred = ns.rot + ns.sv * CFG.skill.lead
            local diff = angDiff(pred, zs.rot + CFG.skill.offset)
            local tight = math.max(1.2, math.abs(ns.sv) * dt * 0.8)
            local crossed = prevDiff and (prevDiff * diff < 0) and (math.abs(prevDiff) + math.abs(diff) < 30)
            if math.abs(diff) <= tight or crossed then
                click(getBind("kb_skillcheck", "Space"), 0.03)
                log("SKILL", string.format("TEKAN diff=%.1f needle=%s zone=%s", diff, needle.Name, zone.Name))
                task.delay(0.3, function() snapshot("skillcheck after press") end)
                return
            end
            prevDiff = diff
        else
            prevDiff = nil
        end
    end

    -- gagal: simpan kandidat buat kalibrasi
    local rows = {}
    for _, o in ipairs(list) do
        local s = stats[o]
        if s then
            rows[#rows + 1] = string.format("%s [%s] ema=%.0f still=%d rot=%.1f", o:GetFullName(), o.ClassName, s.ema, s.still, s.rot)
        end
    end
    table.sort(rows)
    snapshot("skillcheck GAGAL", "kandidat:\n" .. table.concat(rows, "\n", 1, math.min(#rows, 60)))
    log("SKILL", "needle/zona ga ketemu - tap Copy Dump")
end

local function runSkillCheck(info)
    if Skill.active or not CFG.skill.enabled then return end
    Skill.active = true
    task.spawn(function()
        local ok, err = pcall(skillTrack, info)
        if not ok then log("SKILL", "error: " .. tostring(err)) end
        Skill.active = false
    end)
end

local function hookSkillEvents(folder)
    task.spawn(function()
        pcall(function()
            local f = RS:WaitForChild("Remotes", 20):WaitForChild(folder, 20)
            local ev = f:WaitForChild("SkillCheckEvent", 10)
            Spy[f:WaitForChild("SkillCheckResultEvent", 10)] = folder .. ".Result"
            Spy[f:WaitForChild("SkillCheckFailEvent", 10)] = folder .. ".Fail"
            ev.OnClientEvent:Connect(function(...)
                local parts = {}
                for i = 1, math.min(select("#", ...), 8) do
                    local v = (select(i, ...))
                    parts[#parts + 1] = typeof(v) .. "=" .. tostring(v)
                end
                local info = folder .. " event args: " .. table.concat(parts, ", ")
                log("SKILL", info)
                runSkillCheck(info)
            end)
            log("SKILL", "hooked " .. folder)
        end)
    end)
end
hookSkillEvents("Generator")
hookSkillEvents("Healing")

