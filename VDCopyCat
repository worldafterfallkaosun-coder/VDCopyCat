            pos = pos + Vector3.new(0, 0.3, 0)
        end
        local tr = Track[part.Parent]
        if not tr then return pos end
        local vel = tr.vel
        if tr.grounded then vel = Vector3.new(vel.X, 0, vel.Z) end
        if vel.Magnitude > 70 then vel = vel.Unit * 70 end
        if base <= 0 and vel.Magnitude < 1 then return pos end
        local speed = math.max(CFG.veil.spearSpeed, 30)
        local g = CFG.veil.spearGravity
        local t = base + (pos - origin).Magnitude / speed
        for _ = 1, 4 do
            local future = pos + vel * t + Vector3.new(0, 0.5 * g * t * t, 0)
            t = base + (future - origin).Magnitude / speed
        end
        return pos + vel * t + Vector3.new(0, 0.5 * g * t * t, 0)
    end

    local function veilPickTarget(cam)
        local origin = cam.CFrame.Position
        local look = cam.CFrame.LookVector
        local fovDeg = CFG.veil.fovDeg
        local best, bestAng, bestPart
        for _, s in ipairs(survivors()) do
            local part = veilAimPart(s.char)
            if part then
                local dist = (part.Position - origin).Magnitude
                if dist <= CFG.veil.maxDist then
                    local to = (part.Position - origin).Unit
                    local ang = math.deg(math.acos(math.clamp(look:Dot(to), -1, 1)))
                    if ang <= fovDeg and (not bestAng or ang < bestAng) then
                        if (not CFG.veil.requireVisible) or visibleFrom(origin, part) then
                            best, bestAng, bestPart = s, ang, part
                        end
                    end
                end
            end
        end
        return best, bestPart, bestAng
    end

    local errAt = 0
    local function veilAimStep(dt)
        if not alive() then
            pcall(function() RunService:UnbindFromRenderStep("DP3_VeilAim") end)
            return
        end
        if not (CFG.veil.enabled and CFG.veil.aimbot and amKiller() and Veil.aimHeld) then
            if Veil.marker then Veil.marker.Visible = false end
            Veil.lockTarget, Veil.lockChar = nil, nil
            return
        end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local target, part = veilPickTarget(cam)
        if not target or not part then
            Veil.lockTarget, Veil.lockChar = nil, nil
            if Veil.marker then Veil.marker.Visible = false end
            return
        end
        Veil.lockTarget, Veil.lockChar = part, target.char
        local origin = cam.CFrame.Position
        local aimPoint = veilPredictPos(part, origin)
        local sp, on = cam:WorldToViewportPoint(aimPoint)
        if Veil.marker then
            if on then
                Veil.marker.Visible = true
                Veil.marker.Position = UDim2.fromOffset(sp.X, sp.Y)
            else
                Veil.marker.Visible = false
            end
        end
        local goal = CFrame.lookAt(origin, aimPoint)
        local alpha = 1 - math.clamp(CFG.veil.smoothing, 0, 0.99)
        cam.CFrame = cam.CFrame:Lerp(goal, alpha)
    end

    pcall(function() RunService:UnbindFromRenderStep("DP3_VeilAim") end)
    RunService:BindToRenderStep("DP3_VeilAim", Enum.RenderPriority.Camera.Value + 2, function(dt)
        local ok, err = pcall(veilAimStep, dt)
        if not ok and os.clock() - errAt > 4 then
            errAt = os.clock()
            log("VEIL", "aim error: " .. tostring(err))
        end
    end)

    keep(UIS.InputBegan:Connect(function(i, gp)
        if not alive() or gp then return end
        if i.UserInputType == CFG.veil.holdKey then Veil.aimHeld = true end
    end))
    keep(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == CFG.veil.holdKey then Veil.aimHeld = false end
    end))

    local function looksLikeSpear(inst)
        if not inst:IsA("BasePart") then return false end
        if inst:GetAttribute("VeilSpearId") ~= nil or inst:GetAttribute("VeilSpearPhase") ~= nil then return true end
        local n = inst.Name:lower()
        if n == "spearprojectile" then return true end
        if n:find("spear", 1, true) and not inst:FindFirstAncestorOfClass("Humanoid") then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character and inst:IsDescendantOf(plr.Character) then return false end
            end
            return true
        end
        return false
    end

    local function addTrail(a, b, color, now)
        local seg = b - a
        local len = seg.Magnitude
        if len < 0.05 or len > 50 then return end
        local p = Instance.new("Part")
        p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
        p.Material, p.Color, p.Transparency = Enum.Material.Neon, color, 0.25
        p.Size = Vector3.new(0.12, 0.12, len)
        p.CFrame = CFrame.lookAt((a + b) / 2, b)
        p.Parent = Veil.trailFolder
        table.insert(Veil.trailParts, { part = p, born = now })
        while #Veil.trailParts > CFG.veil.maxTrails do
            local old = table.remove(Veil.trailParts, 1)
            if old then old.part:Destroy() end
        end
    end

    local function onSpear(inst)
        if not alive() or Veil.tracked[inst] then return end
        if not looksLikeSpear(inst) then return end
        local me = myRoot()
        local mine = false
        if me and (inst.Position - me.Position).Magnitude < 20 then
            mine = true
            local now = os.clock()
            if Veil.lastThrowAt > 0 then
                local gap = now - Veil.lastThrowAt
                if gap > 2 and gap < 30 then
                    CFG.veil.cooldownSeconds = math.clamp(gap, 3, 30)
                    log("VEIL", string.format("cooldown: %.1fs (dari jeda lemparan)", CFG.veil.cooldownSeconds))
                end
                Veil.lastGap = gap
            end
            Veil.lastThrowAt = now
            Veil.cdEndsAt = now + CFG.veil.cooldownSeconds
            log("VEIL", "lemparan terdeteksi, CD " .. CFG.veil.cooldownSeconds .. "s")
        end
        Veil.tracked[inst] = { part = inst, last = inst.Position, t0 = os.clock(), p0 = inst.Position, mine = mine, calibrated = false }
    end

    keep(Workspace.DescendantAdded:Connect(function(d)
        if alive() then task.defer(onSpear, d) end
    end))
    for _, d in ipairs(Workspace:GetDescendants()) do onSpear(d) end

    local hbErrAt = 0
    keep(RunService.Heartbeat:Connect(function()
        if not alive() then return end
        local ok, err = pcall(function()
            if not (CFG.veil.enabled and CFG.veil.tracker) then return end
            local now = os.clock()
            for inst, rec in pairs(Veil.tracked) do
                if not inst.Parent then
                    Veil.tracked[inst] = nil
                else
                    local cur = inst.Position
                    local col = rec.mine and Color3.fromRGB(120, 200, 255) or Color3.fromRGB(255, 120, 120)
                    addTrail(rec.last, cur, col, now)
                    rec.last = cur
                    if rec.mine and not rec.calibrated then
                        local el = now - rec.t0
                        if el > 0.15 and el < 0.6 then
                            local v = (cur - rec.p0).Magnitude / el
                            if v > 20 and v < 600 then
                                local old = CFG.veil.spearSpeed
                                CFG.veil.spearSpeed = CFG.veil.spearSpeed * 0.7 + v * 0.3
                                if math.abs(CFG.veil.spearSpeed - old) > 1 then
                                    log("VEIL", string.format("spear speed: %.0f -> %.0f stud/s", old, CFG.veil.spearSpeed))
                                end
                                rec.calibrated = true
                            end
                        end
                    end
                end
            end
            for i = #Veil.trailParts, 1, -1 do
                local e = Veil.trailParts[i]
                local age = now - e.born
                if age > CFG.veil.trailLifetime then
                    e.part:Destroy()
                    table.remove(Veil.trailParts, i)
                else
                    e.part.Transparency = 0.25 + 0.75 * (age / CFG.veil.trailLifetime)
                end
            end
        end)
        if not ok and os.clock() - hbErrAt > 5 then
            hbErrAt = os.clock()
            log("VEIL", "tracker error: " .. tostring(err))
        end
    end))
end

