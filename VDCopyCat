------------------------------------------------------------------ 1) AUTO PARRY
-- v8.4: waktu parry dihitung dari PING + FPS, bukan angka tetap.
--   hit = detik dari "kamu liat animasi serang mulai" sampai "kamu kena" (dipelajari per animasi, kuantil 25%).
--   Parry yang kamu kirim butuh 1 RTT buat nyampe server, jadi:   delay = hit - arriveLead - (ping + jitter)
--   Kalau hasilnya negatif banget (ping kegedean buat animasi secepat itu) parry ga dikirim: parry meleset = cd 60 detik.
--   Dijadwalin per Heartbeat (task.wait selalu dibulatin ke frame berikutnya = telat 0-1 frame) dan dikoreksi sendiri
--   dari margin parry yang meleset.
local Parry = {
    watched = setmetatable({}, { __mode = "k" }), last = 0, cdUntil = 0, remote = nil,
    hits = {},      -- [animasi] = sampel "animasi mulai -> kena" (detik), maks 5
    shift = {},     -- [animasi] = koreksi dari parry yang meleset (detik)
    stat = {},      -- [animasi] = { plays = muncul deket kamu, hits = bikin kamu kena }
    recent = {}, hpHum = nil,
}
local parrySeenAt, parryWhyAt, parryCdAt, parryHpAt, parryHopeAt = 0, 0, 0, 0, 0

local function shortKey(key)
    return tostring(key):match("%d+") or tostring(key)
end

local function statOf(key)
    local s = Parry.stat[key]
    if not s then
        s = { plays = 0, hits = 0 }
        Parry.stat[key] = s
    end
    return s
end

-- kuantil 25%: sampel "animasi -> kena" bisa bimodal (lag killer beda-beda). Condong ke yang CEPAT, karena parry telat = gagal total.
local function hitFor(key)
    local h = Parry.hits[key]
    if not h or #h == 0 then return CFG.parry.hitGuess, false end
    local s = table.clone(h)
    table.sort(s)
    return s[math.max(1, math.ceil(#s * 0.25))], true
end

-- return delay (detik, negatif = udah telat), hit, dikenal?
local function planDelay(key)
    local hit, known = hitFor(key)
    local d = hit - CFG.parry.arriveLead - (Net.rtt + Net.jitter) + (Parry.shift[key] or 0)
    return d, hit, known
end

local function findDagger()
    local c = myChar()
    if not c then return nil end
    local t = c:FindFirstChild("Parrying Dagger")
    if t then return t, true end
    local bp = LP:FindFirstChildOfClass("Backpack")
    t = bp and bp:FindFirstChild("Parrying Dagger")
    return t, false
end

------------------------------------------------------------------ PARRY CLIENT GAME (v8.6)
-- ReplicatedStorage.Modules.Items.ParryingDagger.ParryClient dibikin oleh LocalScript di dagger: ParryClient.new{tool, animationId}.
-- Objeknya (tabel dengan field tool/parryEvent/parryTrack/isParryOnCooldown/...) cuma dipegang upvalue koneksi game, jadi dicari
-- lewat getgc. :Parry() miliknya ngelakuin semuanya: FireServer, madep kamera, parryTrack:Play(), slow, tag "doing action", dan
-- state isParryResolving yang bikin handler parryResult game ngejalanin tween cooldown di UI.
local PG = { inst = nil, class = nil, scanAt = 0, gap = 1.5, lastTool = nil, noGc = false, whyAt = 0, missAt = 0 }

local function pgClass()
    if PG.class == nil then
        local ok, m = pcall(function() return require(RS.Modules.Items.ParryingDagger.ParryClient) end)
        PG.class = (ok and type(m) == "table" and m) or false
    end
    return PG.class or nil
end

-- 3 = dagger di karakter, 2 = di backpack, 0 = ga kepakai (karakter lama / tool udah dihancurin)
local function pgScore(t)
    local ch = myChar()
    if not ch or rawget(t, "character") ~= ch then return 0 end
    local tool = rawget(t, "tool")
    if typeof(tool) ~= "Instance" then return 0 end
    if tool:IsDescendantOf(ch) then return 3 end
    if tool:IsDescendantOf(LP) then return 2 end
    return 0
end

local function pgIsClient(t)
    local ok, res = pcall(function()
        if typeof(rawget(t, "parryEvent")) ~= "Instance" or typeof(rawget(t, "tool")) ~= "Instance" then return false end
        if rawget(t, "player") ~= LP then return false end
        local cls = pgClass()
        if cls and getmetatable(t) ~= cls then return false end
        return type(t.Parry) == "function" and type(t.CanUse) == "function"
    end)
    return ok and res == true
end

local function pgScan()
    PG.scanAt = os.clock()
    if not getgc then
        PG.noGc = true
        return nil, 0
    end
    local ok, list = pcall(getgc, true)
    if not ok or type(list) ~= "table" then return nil, 0 end
    local best, bestScore, n = nil, 0, 0
    for i = 1, #list do
        local t = list[i]
        -- cek murah dulu (rawget ga bisa error di tabel), baru pcall yang mahal buat kandidat
        if type(t) == "table" and rawget(t, "parryEvent") ~= nil and pgIsClient(t) then
            n = n + 1
            local sc = pgScore(t)
            if sc > bestScore then best, bestScore = t, sc end
        end
    end
    return best, n
end

local function pgCached()
    local c = PG.inst
    if c then
        local ok, sc = pcall(pgScore, c)
        if ok and sc >= 2 then return c end
        PG.inst = nil
    end
    return nil
end

-- dipanggil dari loop background (bukan dari jalur parry): cari objek game cuma kalau dagger ada
local function pgPrewarm()
    if CFG.parry.via ~= "game" or not CFG.parry.enabled or PG.noGc then return end
    local tool = findDagger()
    if tool ~= PG.lastTool then
        PG.lastTool = tool
        PG.inst = nil
        PG.gap, PG.scanAt = 1.5, 0
    end
    if not tool or pgCached() then return end
    local now = os.clock()
    if now - PG.scanAt < PG.gap then return end
    local c, n = pgScan()
    if c then
        PG.inst, PG.gap = c, 1.5
        log("PARRY", "ParryClient game ketemu: animasi + cooldown UI sekarang ikut game")
    else
        PG.gap = math.min(PG.gap * 1.6, 10)
        if now - PG.missAt > 8 then
            PG.missAt = now
            log("PARRY", string.format("ParryClient game belum ketemu (kandidat %d, cari lagi %.0fs) -> sementara pakai input", n, PG.gap))
        end
    end
end

-- kenapa game bakal nolak parry sekarang? nil = boleh. ignoreEquip = true buat nentuin perlu pre-equip atau nggak
local function pgBlock(c, ignoreEquip)
    if c.isSilenced then return "kena silence" end
    if c.isParryLocked then return "parry nyangkut permanent, nunggu killer mukul (UI game cooldown)" end
    if c.isParryOnCooldown then return "masih cooldown di UI game" end
    if c.isParryResolving then return "game masih nunggu hasil parry dari server" end
    local ok, low = pcall(c._isLowHealth, c)
    if ok and low then return "HP < 50% (ParryClient._isLowHealth)" end
    local ok2, busy = pcall(c._isBusy, c)
    if ok2 and busy then return "karakter lagi action lain (vault/repair/heal/dll)" end
    if not ignoreEquip then
        local ok3, eq = pcall(c._isEquipped, c)
        if ok3 and not eq then return "dagger belum di-equip" end
    end
    return nil
end

-- boleh kirim parry sekarang? (dipakai buat nentuin perlu pre-equip dagger atau nggak)
local function parryReady(now)
    if not CFG.parry.enabled then return false end
    if now - Parry.last < CFG.parry.spacing then return false end
    local hum = myHum()
    if not hum or hum.Health <= 0 or hum.Health < hum.MaxHealth * 0.5 then return false end
    if CFG.parry.via == "game" then
        local c = pgCached()
        if c then return pgBlock(c, true) == nil end
    end
    if CFG.parry.useServerCd and now < Parry.cdUntil then return false end
    return true
end

-- true kalau parry terkirim. plan = delay yang direncanain (buat log)
local function parryNow(entry, plan)
    if not CFG.parry.enabled then return false end
    local now = os.clock()
    if now - Parry.last < CFG.parry.spacing then return false end
    local hum, char = myHum(), myChar()
    if not hum or hum.Health <= 0 or not char then return false end

    -- jalur: game (ParryClient asli) > input (tombol item, tetap lewat game) > remote (cara lama, tanpa animasi)
    local via = CFG.parry.via
    local gcl = nil
    if via == "game" then
        gcl = pgCached()
        if not gcl then via = "input" end
    end

    if gcl then
        -- status diambil dari objek game: kalau UI game masih cooldown, kita ga nembak
        local why = pgBlock(gcl, true)
        if why then
            if now - parryCdAt > 2 then
                parryCdAt = now
                log("PARRY", "ga dikirim: " .. why)
            end
            return false
        end
    else
        if CFG.parry.useServerCd and now < Parry.cdUntil then
            if now - parryCdAt > 2 then
                parryCdAt = now
                log("PARRY", string.format("parry masih cooldown %.1fs lagi, ga dikirim", Parry.cdUntil - now))
            end
            return false
        end
        if hum.Health < hum.MaxHealth * 0.5 then   -- client game nolak parry kalau HP < 50%
            if now - parryHpAt > 3 then
                parryHpAt = now
                log("PARRY", "HP < 50%: game nolak parry (ParryClient._isLowHealth)")
            end
            return false
        end
    end

    local tool, equipped = findDagger()
    if not tool then
        if now - parryWhyAt > 3 then
            parryWhyAt = now
            log("PARRY", "Parrying Dagger ga ada di tangan / backpack")
        end
        return false
    end
    if not equipped then
        if not CFG.parry.autoEquip then return false end
        hum:EquipTool(tool)
        -- biasanya udah ke-equip duluan pas animasi mulai. Kalau belum, tunggu sampai bener-bener di tangan (maks 0.12s)
        local t1 = os.clock()
        repeat RunService.Heartbeat:Wait() until (select(2, findDagger())) or os.clock() - t1 > 0.12
    end

    if gcl then
        -- cek ulang lengkap (termasuk equip) persis kayak ParryClient:CanUse()
        local why = pgBlock(gcl, false)
        if why then
            if now - parryCdAt > 2 then
                parryCdAt = now
                log("PARRY", "ga dikirim: " .. why)
            end
            return false
        end
    end

    Parry.last = os.clock()
    entry.fired = Parry.last
    Parry.nFire = (Parry.nFire or 0) + 1   -- v12: hitungan buat hub
    local before = char:GetAttribute("ParryLands") or 0

    if gcl then
        -- ParryClient:Parry() nge-yield sampai animasi selesai / parry kena -> jalanin di thread sendiri.
        -- FireServer ada di baris pertama sebelum yield pertama, jadi timing kirimnya sama kayak sebelumnya.
        task.spawn(function()
            local okp, err = pcall(gcl.Parry, gcl)
            if not okp then log("PARRY", "ParryClient:Parry error: " .. tostring(err)) end
        end)
    elseif via == "input" then
        if CFG.parry.via == "game" and now - parryWhyAt > 3 then
            parryWhyAt = now
            log("PARRY", "pakai input tombol item dulu (ParryClient belum ketemu)")
        end
        local ok = press(getBind("kb_item", "MouseButton2"), 0.04, "vim")
        if not ok then press(getBind("kb_item", "MouseButton2"), 0.04, "all") end
    else
        -- cari ulang tiap kali (sama kayak script lama), jangan pegang remote lama yang bisa udah ke-replace
        local ev = Parry.remote
        if not (ev and ev.Parent) then
            local okf, r = pcall(function() return RS.Remotes.Items["Parrying Dagger"].parry end)
            if okf and r then
                ev = r
                Parry.remote = r
            end
        end
        if not ev then
            log("PARRY", "remote parry ga ketemu")
            return false
        end
        if now - parryWhyAt > 6 then
            parryWhyAt = now
            log("PARRY", "PERINGATAN: via remote = tanpa animasi & UI cooldown game ga ikut. Pakai Via: GAME.")
        end
        ev:FireServer(char)
    end
    log("PARRY", string.format("kirim parry [%s] via %s delay %.2f (%.0f ms setelah animasi mulai, ping %.0f ms, fps %.0f)",
        shortKey(entry.key), gcl and "GAME" or via:upper(), plan or 0, (Parry.last - entry.t0) * 1000, Net.rtt * 1000, 1 / Net.frameDt))

    task.delay(0.9, function()
        if not alive() then return end
        local after = (myChar() == char) and (char:GetAttribute("ParryLands") or 0) or before
        local ok = after > before
        entry.landed = ok
        if ok and entry.near then   -- parry sukses = animasi ini beneran serangan (jangan dianggap "ga pernah kena")
            local st = statOf(entry.key)
            st.hits = st.hits + 1
        end
        local extra = ""
        if not ok and entry.hit and entry.fired then
            -- margin = berapa lama parry nyampe server SEBELUM kena. Negatif = telat. Di luar jendela wajar -> koreksi.
            local h, f = entry.hit - entry.t0, entry.fired - entry.t0
            local margin = h - Net.rtt - f
            extra = string.format(" | margin %+.0f ms (negatif = telat)", margin * 1000)
            if margin < 0 or margin > 0.30 then
                local old = Parry.shift[entry.key] or 0
                Parry.shift[entry.key] = math.clamp(old + 0.7 * (margin - CFG.parry.arriveLead), -0.2, 0.2)
                extra = extra .. string.format(" -> koreksi %+.0f ms", (Parry.shift[entry.key] - old) * 1000)
            end
        end
        log("PARRY", string.format("[%s] delay=%.2f %s%s", shortKey(entry.key), plan or 0, ok and "SUKSES" or "meleset", extra))
    end)
    return true
end

-- killer ngancam kita? lead = prediksi gerak (lunge)
local function threatens(k, lead)
    local me = myRoot()
    if not me or not k.root.Parent then return false end
    -- v10: kecepatan dari lacakan sendiri (EMA per frame, tahan noise) dan cuma sumbu datar (lunge). AssemblyLinearVelocity
    -- pemain lain sering berisik / telat, dan sumbu Y (lompat / turun tangga) bikin prediksi jarak meleset.
    local vel = Vector3.new(0, 0, 0)
    local tr = Track[k.char]
    if tr and os.clock() - tr.t < 0.25 then
        vel = tr.vel
    else
        pcall(function() vel = k.root.AssemblyLinearVelocity end)
    end
    vel = Vector3.new(vel.X, 0, vel.Z)
    if vel.Magnitude > 70 then vel = vel.Unit * 70 end
    local pos = k.root.Position + vel * (lead or 0)
    local to = me.Position - pos
    local dist = to.Magnitude
    if dist > CFG.parry.range then return false end
    if dist < 0.01 or dist <= 5 then return true end   -- udah nempel: arah hadap ga usah dicek
    return k.root.CFrame.LookVector:Dot(to.Unit) >= CFG.parry.frontDot
end

local function watchKiller(k)
    local animator = k.hum:FindFirstChildOfClass("Animator")
    if not animator or Parry.watched[animator] then return end
    Parry.watched[animator] = true
    local seenTrack = setmetatable({}, { __mode = "k" })
    local function onTrack(track)
        if seenTrack[track] then return end
        seenTrack[track] = true
        if not alive() or not CFG.parry.enabled or not amSurvivor() then return end
        if track.Looped then return end
        if track.Priority.Value < CFG.parry.minPriority.Value then return end
        local key = (track.Animation and track.Animation.AnimationId) or track.Name
        local t0 = os.clock()
        local me = myRoot()
        local entry = { key = key, t0 = t0 }
        entry.near = me ~= nil and k.root.Parent ~= nil
            and (me.Position - k.root.Position).Magnitude <= CFG.parry.range * 2.2
        if entry.near then
            local st = statOf(key)
            st.plays = st.plays + 1
        end
        local rec = Parry.recent
        rec[#rec + 1] = entry
        while #rec > 8 or (rec[1] and t0 - rec[1].t0 > 3) do table.remove(rec, 1) end

        task.spawn(function()
            local d, hit, known = planDelay(key)
            local st = statOf(key)
            -- animasi yang udah dikenal tapi jarang bikin kena = bukan serangan: jangan buang cooldown 60s
            if known and st.plays >= CFG.parry.minPlays and st.hits / st.plays < CFG.parry.minChance then return end
            if (not known) and not CFG.parry.fireUnknown then return end
            if known and CFG.parry.skipHopeless and d < -CFG.parry.slack then
                if os.clock() - parryHopeAt > 2 then
                    parryHopeAt = os.clock()
                    log("PARRY", string.format("[%s] ga kekejar: kena %.0f ms, ping %.0f ms, lead %.0f ms (telat %.0f ms) -> ga dikirim",
                        shortKey(key), hit * 1000, (Net.rtt + Net.jitter) * 1000, CFG.parry.arriveLead * 1000, -d * 1000))
                end
                return
            end

            -- pre-equip: dagger udah di tangan sebelum waktunya kirim, jadi equip ga makan waktu parry
            if CFG.parry.autoEquip and entry.near and parryReady(t0)
                and threatens(k, math.clamp(hit + Net.rtt * 0.5, CFG.parry.lead, 0.45)) then
                local tool, equipped = findDagger()
                local hum = myHum()
                if tool and not equipped and hum then pcall(function() hum:EquipTool(tool) end) end
            end

            local jit = (math.random() * 2 - 1) * CFG.parry.jitter
            local fireAt = t0 + math.clamp(d, CFG.parry.minDelay, CFG.parry.maxDelay) + jit
            local untilT = fireAt + CFG.parry.pollWindow
            local sent, seen = false, false
            while alive() and CFG.parry.enabled and track.IsPlaying and os.clock() < untilT do
                local now = os.clock()
                -- Heartbeat terdekat ke target (bukan yang pertama LEWAT target): rata-rata error 0, bukan +0.5 frame
                if now >= fireAt - Net.frameDt * 0.5 then
                    local left = math.max(t0 + hit - now, 0)
                    local lead = math.clamp(left + Net.rtt * 0.5, CFG.parry.lead, 0.45)
                    if threatens(k, lead) then   -- posisi killer PAS kena, bukan pas animasi mulai (dia lunge)
                        seen = true
                        sent = parryNow(entry, d)
                        break
                    end
                end
                RunService.Heartbeat:Wait()
            end
            if not sent and not seen and os.clock() - parrySeenAt > 2 then
                parrySeenAt = os.clock()
                log("PARRY", "animasi serang kebaca tapi killer ga ngancam (jarak/arah)")
            end
        end)
    end
    keep(animator.AnimationPlayed:Connect(onTrack))
    -- cadangan: track yang ga kebaca lewat AnimationPlayed (dedupe pakai seenTrack)
    -- v10: ~25 Hz (dulu tiap frame + bikin closure pcall tiap frame); track baru masih ketangkep karena TimePosition < 0.3
    task.spawn(function()
        while alive() and animator.Parent do
            if CFG.parry.enabled then
                local ok, tracks = pcall(animator.GetPlayingAnimationTracks, animator)
                if ok and tracks then
                    for _, t in ipairs(tracks) do
                        if not seenTrack[t] and t.IsPlaying and t.TimePosition < 0.3 then pcall(onTrack, t) end
                    end
                end
            end
            task.wait(0.04)
        end
    end)
end

-- belajar dari damage: damage dicatat ke SEMUA animasi killer yang baru main, soalnya serangan bisa dua animasi
-- (aba-aba dulu, baru ayunan). Animasi yang muncul duluan jadi isyarat lebih awal buat parry.
local function hookHealth()
    local hum = myHum()
    if not hum or Parry.hpHum == hum then return end
    Parry.hpHum = hum
    Parry.cdUntil = 0   -- karakter baru = item baru, cooldown lama ga berlaku
    local last = hum.Health
    keep(hum.HealthChanged:Connect(function(h)
        local drop = last - h
        last = h
        if drop <= 0.5 or not alive() or not CFG.parry.learn then return end
        local now = os.clock()
        for i = #Parry.recent, 1, -1 do
            local e = Parry.recent[i]
            local age = now - e.t0
            if age > 0.9 then break end
            if age >= 0.04 and e.near and not e.landed and not e.hit then
                e.hit = now
                local hs = Parry.hits[e.key]
                if not hs then
                    hs = {}
                    Parry.hits[e.key] = hs
                end
                hs[#hs + 1] = age
                if #hs > 5 then table.remove(hs, 1) end
                local st = statOf(e.key)
                st.hits = st.hits + 1
                local d = planDelay(e.key)
                log("PARRY", string.format("[%s] kena damage %.0f ms setelah animasi mulai -> rencana delay %.0f ms (ping %.0f ms, fps %.0f)",
                    shortKey(e.key), age * 1000, d * 1000, Net.rtt * 1000, 1 / Net.frameDt))
            end
        end
    end))
end

task.spawn(function()
    pcall(function()
        local pd = RS:WaitForChild("Remotes", 20):WaitForChild("Items", 20):WaitForChild("Parrying Dagger", 20)
        Parry.remote = pd:WaitForChild("parry", 10)
        -- sengaja ga didaftarin ke Spy: parry ga boleh lewat hook, biar sama persis kayak script lama
        -- args asli game: (success, cooldown, permanent, chained, character)
        keep(pd:WaitForChild("parryResult", 10).OnClientEvent:Connect(function(success, cooldown, permanent, chained)
            local cd = tonumber(cooldown)
            if success == true then Parry.nOk = (Parry.nOk or 0) + 1      -- v12: hitungan buat hub
            elseif success == false then Parry.nMiss = (Parry.nMiss or 0) + 1 end
            if cd and cd > 0 then Parry.cdUntil = os.clock() + cd end
            -- parry sukses: item nunggu sampai killer mukul (permanent) -> jangan kirim parry lagi, server pasti nolak
            -- v10: dibatasi 30 detik (dulu math.huge: kalau killer ga mukul, jalur remote nyangkut sampai respawn)
            if permanent == true then Parry.cdUntil = os.clock() + 30 end
            if chained == true then Parry.cdUntil = 0 end   -- parry nyambung: game ngehapus cooldown
            log("PARRY", "result success=" .. tostring(success) .. " cd=" .. tostring(cooldown)
                .. (permanent and " permanent" or "") .. (chained == true and " chained" or ""))
        end))
    end)
    while alive() do
        pcall(hookHealth)
        pcall(pgPrewarm)
        if CFG.parry.enabled then
            for _, k in ipairs(killers()) do watchKiller(k) end
        end
        task.wait(0.25)
    end
end)

