local NO_AIM_FLAGS = { "isVaulting", "isSliding", "isDroppingPallet", "isRepairing", "isHealing", "isUnhooking", "isExiting" }

local function equippedGun()
    local c = myChar()
    if not c then return nil end
    local t = c:FindFirstChild("Twist of Fate")
    if t then return t end
    for _, v in ipairs(c:GetChildren()) do
        if v:IsA("Tool") and (v:GetAttribute("tofState") ~= nil or v:GetAttribute("shots") ~= nil
            or v:GetAttribute("tofRoll") ~= nil or v.Name:lower():find("twist")) then
            return v
        end
    end
    return nil
end

local function aimingNow()
    local c = myChar()
    return c ~= nil and c:GetAttribute("Aiming") == true
end

local TuningMod, EffectsMod
local function tuning()
    if TuningMod == nil then
        local ok, t = pcall(function() return require(RS.Modules.Items.TwistOfFate.TwistoffateTuning) end)
        TuningMod = (ok and t) or false
    end
    return TuningMod or nil
end

-- (waktu charge, batas jam kalau ada peluru, batas macet kalau peluru habis) buat step n
local function stepInfo(n)
    local T = tuning()
    local s = T and T.STEPS and T.STEPS[n]
    if s and type(s.at) == "number" then return s.at, s.jam or 0, s.empty or 0 end
    local ranked = RS:GetAttribute("RankedMode") == true
    local defs = { { 0.75, 0.4, 0.8 }, { ranked and 1.3 or 1.8, 0.2, 0.65 }, { ranked and 2.0 or 3.0, 0, 0.5 } }
    local d = defs[n] or defs[3]
    return d[1], d[2], d[3]
end

-- arah tembak PERSIS yang bakal dipakai game kalau kamu nembak sekarang (muzzle -> titik yang diliat kamera)
local function gameAimDir()
    local cam = workspace.CurrentCamera
    if EffectsMod == nil then
        local ok, m = pcall(function() return require(RS.Modules.Items.TwistOfFate.TwistoffateEffects) end)
        EffectsMod = (ok and m) or false
    end
    if EffectsMod and EffectsMod.aimDirection then
        local ok, d = pcall(EffectsMod.aimDirection, myChar(), cam.CFrame)
        if ok and typeof(d) == "Vector3" then return d end
    end
    return cam.CFrame.LookVector
end

-- killer yang lagi kena crosshair (jarak peluru-ke-badan <= hitRadius)
local function findTarget()
    local origin = muzzleOrigin()
    if not origin then return nil end
    local dir = gameAimDir()
    local best, bestMiss
    for _, k in ipairs(killers()) do
        local part = pickPart(k.char)
        if part then
            local to = part.Position - origin
            local dist = to.Magnitude
            if dist <= CFG.gun.maxDist and dist > 1 then
                local along = to:Dot(dir)
                if along > 0 then
                    local miss = (to - dir * along).Magnitude
                    if miss <= CFG.gun.hitRadius and (not bestMiss or miss < bestMiss) then
                        if (not CFG.gun.needLOS) or visibleFrom(origin, part) then
                            best, bestMiss = part, miss
                        end
                    end
                end
            end
        end
    end
    return best, bestMiss
end

-- kebalikan syarat game buat nembak (return nil = aman, string = alasan nahan)
local function whyNoShoot(tool, jam, empty)
    local c, hum, root = myChar(), myHum(), myRoot()
    if not (c and hum and root) or hum.Health <= 0 then return "karakter belum siap" end
    if os.clock() < Gun.pauseUntil then return "jeda (trigger gagal berulang)" end
    if Gun.firing then return "nunggu konfirmasi" end
    if hum.Health < hum.MaxHealth * 0.5 then return "HP < 50%" end
    if CS:HasTag(c, "Silenced") then return "Silenced" end
    if tool:GetAttribute("tofState") == "cooldown" then return "gun cooldown" end
    if os.clock() < Gun.lockUntil then return "gun macet (lock)" end
    for _, a in ipairs({ "Trapped", "IsCarried", "IsHooked" }) do
        if c:GetAttribute(a) then return a end
    end
    if LP:GetAttribute("IsDead") then return "IsDead" end
    local ci = c:FindFirstChild("CheckInterractable")
    if ci then
        for _, a in ipairs(NO_AIM_FLAGS) do
            if ci:GetAttribute(a) then return a end
        end
    end
    local shots = tool:GetAttribute("shots")
    local hasShots = (shots == nil and 1 or shots) > 0
    local roll = tool:GetAttribute("tofRoll")
    local limit = hasShots and jam or empty
    if type(roll) == "number" and type(limit) == "number" and roll < limit then
        return string.format("roll %.2f < %.2f (bakal macet)", roll, limit)
    end
    if (not hasShots) and type(roll) ~= "number" then return "peluru habis" end
    return nil
end

-- filter handler: cuma script gun
local function gunFilter(name)
    return name:find("TwistoffateClient", 1, true) ~= nil
end

local function gunTiers()
    local t = {}
    if getconnections then t[#t + 1] = "owner" end
    if VIM then t[#t + 1] = "vim" end
    if getconnections then t[#t + 1] = "all" end
    if Gun.fire and Gun.template then t[#t + 1] = "remote" end   -- baru ada setelah 1 tembakan asli kamu ketangkep
    return t
end

local function gunEscalate(why)
    local list = gunTiers()
    if #list == 0 then return end
    local cur = list[Gun.tierIdx] or list[1]
    Gun.tierIdx = Gun.tierIdx % #list + 1
    Gun.failStreak = 0
    if Gun.tierIdx == 1 then
        Gun.cycles = Gun.cycles + 1
        if Gun.cycles >= 2 then
            Gun.cycles = 0
            Gun.pauseUntil = os.clock() + 8
            log("TRIG", "semua tier gagal 2 putaran -> trigger jeda 8 detik (Copy Log)")
        end
    end
    log("TRIG", string.format("tier %s gagal (%s) -> pindah ke %s", cur, why, list[Gun.tierIdx] or "?"))
end

-- tier terakhir: kirim remote tembak langsung pakai format tembakan asli yang udah ketangkep, arah = ke target
local function fireRemote(tool, part)
    if not (Gun.fire and Gun.template) then return false, "format remote belum ketangkep (tembak manual sekali)" end
    local origin = muzzleOrigin()
    local nd = origin and dirTo(origin, part)
    if not nd then return false, "arah ga valid" end
    local n, args = Gun.templateN, {}
    for i = 1, n do
        local v = Gun.template[i]
        if typeof(v) == "Instance" and v:IsA("Tool") then v = tool end
        args[i] = v
    end
    if typeof(args[1]) == "Vector3" then args[1] = origin end
    args[2] = nd
    Gun.selfFire = true
    local ok, err = pcall(function() Gun.fire:FireServer(table.unpack(args, 1, n)) end)
    Gun.selfFire = false
    if not ok then return false, tostring(err) end
    return true, "remote langsung"
end

local function fireTrigger(tool, part)
    local list = gunTiers()
    if #list == 0 then
        Gun.pauseUntil = os.clock() + 30
        log("TRIG", "executor ga punya getconnections maupun VirtualInputManager -> trigger ga bisa")
        return
    end
    local tier = list[Gun.tierIdx] or list[1]
    local trigRaw = getBind("kb_itemtrigger", "MouseButton1")
    local before = Gun.fireCount

    Gun.firing = true
    Gun.pending, Gun.pendingAt = part, os.clock()
    local ok, how
    if tier == "remote" then
        ok, how = fireRemote(tool, part)
    else
        ok, how = press(trigRaw, 0.05, tier, gunFilter)
    end
    log("TRIG", string.format("tembak via %s (%s)", tier, tostring(how)))

    if not ok then
        Gun.pending = nil
        Gun.firing = false
        Gun.holdoff = os.clock() + 0.3
        gunEscalate("input ga masuk")
        return
    end

    task.delay(CFG.gun.confirmWait, function()
        Gun.firing = false
        if not alive() then return end
        if Gun.fireCount > before then
            Gun.tierGood[tier] = true
            Gun.failStreak = 0
            Gun.cycles = 0
            Gun.holdoff = os.clock() + CFG.gun.shotGap
            log("TRIG", "tembakan keluar (tier " .. tier .. ")")
        else
            Gun.pending = nil
            Gun.holdoff = os.clock() + 0.7
            Gun.failStreak = Gun.failStreak + 1
            log("TRIG", "game belum ngirim tembakan (streak " .. Gun.failStreak .. ")")
            if (not Gun.tierGood[tier]) and Gun.failStreak >= 2 then gunEscalate("2x ga keluar") end
        end
    end)
end

local function gunStep()
    local tool = equippedGun()
    local aiming = tool ~= nil and aimingNow()
    if aiming and not Gun.wasAiming then Gun.chargeStart = os.clock() end
    Gun.wasAiming = aiming

    if not tool then Gun.status = "gun ga dipegang"; return end
    if not aiming then Gun.status = "tahan aim, kamera lock ke killer sendiri"; return end
    if not CFG.gun.trigger then Gun.status = "auto fire OFF (lock/snap aja)"; return end
    if not amSurvivor() then Gun.status = "bukan survivor"; return end

    local now = os.clock()
    if now < Gun.holdoff then return end

    -- step: auto (0) = step tertinggi yang waktu charge-nya udah kecapai
    local charged = now - Gun.chargeStart
    local margin = CFG.gun.chargeMargin
    local r
    if CFG.gun.fireStep == 0 then
        for n = 1, 3 do
            if charged >= (stepInfo(n)) + margin then r = n end
        end
    elseif charged >= (stepInfo(CFG.gun.fireStep)) + margin then
        r = CFG.gun.fireStep
    end
    if not r then
        local first = (stepInfo(CFG.gun.fireStep == 0 and 1 or CFG.gun.fireStep))
        Gun.status = string.format("charge %.1f/%.1fs", charged, first + margin)
        return
    end
    local _, jam, empty = stepInfo(r)

    local why = whyNoShoot(tool, jam, empty)
    if why then
        Gun.status = "nahan: " .. why
        if why ~= Gun.lastWhyText or now - Gun.lastWhy > 4 then
            Gun.lastWhy, Gun.lastWhyText = now, why
            log("TRIG", "nahan: " .. why)
        end
        return
    end

    -- target: kalau kamera udah nempel ke target lock -> tembak. kalau belum, cek crosshair manual
    local part, miss
    local lt = Gun.lockTarget
    if CFG.gun.aimLock and lt and lt.Parent and Gun.lockAng <= CFG.gun.fireTol then
        part, miss = lt, 0
    else
        part, miss = findTarget()
    end
    if not part then
        Gun.status = CFG.gun.aimLock and "siap - nunggu killer masuk jangkauan lock" or "siap - arahkan crosshair ke killer"
        return
    end
    Gun.status = string.format("step %d | target kena -> tembak", r)
    fireTrigger(tool, part)
end

task.spawn(function()
    local acc, lastErr = 0, 0
    while alive() do
        local dt = RunService.Heartbeat:Wait()
        acc = acc + dt
        if acc >= 1 / 30 then
            acc = 0
            local ok, err = pcall(gunStep)
            if not ok and os.clock() - lastErr > 3 then
                lastErr = os.clock()
                log("GUN", "error: " .. tostring(err))
