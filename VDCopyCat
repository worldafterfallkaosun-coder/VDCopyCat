local function muzzleOrigin()
    local root = myRoot()
    if not root then return nil end
    local nowM = os.clock()
    local mc = Gun.mzc
    if mc and mc.root == root and nowM - mc.t < 0.004 then return mc.v end
    local a = root.Position + Vector3.new(0, 1.373, 0)
    local b = (root.CFrame * CFrame.new(0.7, 1.373, -2.5)).Position
    local d = b - a
    if d.Magnitude <= 0 then return b end
    rayP.FilterDescendantsInstances = { myChar() }
    local ok, res = pcall(function()
        return workspace:Blockcast(CFrame.new(a, b), Vector3.new(0.5, 0.5, 0.5), d, rayP)
    end)
    local pos = b
    if ok and res then pos = res.Position - d.Unit * 0.5 end
    local lag = CFG.gun.originLag
    if lag and lag > 0 then
        local v = Vector3.new(0, 0, 0)
        pcall(function() v = root.AssemblyLinearVelocity end)
        v = Vector3.new(v.X, 0, v.Z)
        if v.Magnitude > 60 then v = v.Unit * 60 end
        pos = pos - v * lag
    end
    Gun.mzc = { t = nowM, v = pos, root = root }
    return pos
end

local function visibleRaw(origin, part)
    local ign = { myChar(), part.Parent }
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and not (p.Team and p.Team.Name:lower():find("killer")) then
            ign[#ign + 1] = p.Character
        end
    end
    local o, dir = origin, part.Position - origin
    local left = dir.Magnitude
    if left < 0.5 then return true end
    for _ = 1, 8 do
        rayP.FilterDescendantsInstances = ign
        local okc, res = pcall(function()
            return workspace:Blockcast(CFrame.new(o, o + dir), Vector3.new(0.5, 0.5, 0.5), dir, rayP)
        end)
        if not okc then res = workspace:Raycast(o, dir, rayP) end
        if not res then return true end
        local inst = res.Instance
        local pierce = (inst.Transparency > 0.01 and inst.Name ~= "HumanoidRootPart")
            or inst:FindFirstAncestorWhichIsA("Accessory") ~= nil
        if not pierce then return false end
        ign[#ign + 1] = inst
        local adv = (res.Distance or 0) + 0.05
        left = left - adv
        if left <= 0.3 then return true end
        local u = dir.Unit
        o = o + u * adv
        dir = u * left
    end
    return false
end

local function visibleFrom(origin, part)
    local now = os.clock()
